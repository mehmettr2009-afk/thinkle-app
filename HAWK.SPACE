/* Yüzey yüksekliği: yön vektörüne göre (pist bölgesi teğet düzleme düzleştirilir) */
function planetTerrain(p, dir) {
  const pa = p.padA || PAD_ANGLE, pb = p.padB || PAD_BLEND;
  const cosT = dir.y;                       // kutupla açı (pad kutupta)
  const theta = Math.acos(Math.min(1, Math.max(-1, cosT)));
  // Teğet düzlem yüksekliği: R(1/cosθ − 1)
  const planeH = theta < 1.2 ? p.radius*(1/Math.cos(Math.min(theta, pa+pb))-1) : 0;
  let noiseH = fbm3(dir.x*5+p.seed, dir.y*5+p.seed*2, dir.z*5+p.seed*3, 5) * p.rough * p.radius;
  noiseH += Math.max(0, fbm3(dir.x*2.2+p.seed*7, dir.y*2.2, dir.z*2.2, 3)) * p.rough * p.radius * 1.6;
  if (theta < pa) return p.radius*(1/Math.cos(theta)-1);
  if (theta < pa + pb) {
    const t = (theta - pa) / pb;
    const s = t*t*(3-2*t);
    return planeH*(1-s) + noiseH*s;
  }
  return noiseH;
}

function buildPlanet(p) {
  // DEV pist: gezegen boyutuna göre (küçük ayda bile en az 2 km)
  const rwLen = Math.min(3400, Math.max(2000, p.radius * 0.42));
  const rwWid = 130;
  p.rwLen = rwLen; p.rwWid = rwWid;
  p.padA = (rwLen/2 + 300) / p.radius;
  p.padB = Math.min(0.5, p.padA * 0.7);
  const segW = p.radius > 6000 ? 160 : 120, segH = p.radius > 6000 ? 110 : 84;
  const g = new THREE.SphereGeometry(p.radius, segW, segH);
  const pos = g.attributes.position;
  const colors = [];
  const c0=new THREE.Color(p.cols[0]), c1=new THREE.Color(p.cols[1]), c2=new THREE.Color(p.cols[2]), c3=new THREE.Color(p.cols[3]);
  const dir = new THREE.Vector3();
  for (let i=0;i<pos.count;i++){
    dir.set(pos.getX(i), pos.getY(i), pos.getZ(i)).normalize();
    const h = planetTerrain(p, dir);
    const r = p.radius + h;
    pos.setXYZ(i, dir.x*r, dir.y*r, dir.z*r);
    const hn = h / (p.rough*p.radius*1.6);   // ~-0.6..1.2
    const c = new THREE.Color();
    if (hn < 0.05) c.copy(c0).lerp(c1, (hn+0.6)/0.65);
    else if (hn < 0.5) c.copy(c1).lerp(c2, (hn-0.05)/0.45);
    else c.copy(c2).lerp(c3, Math.min(1,(hn-0.5)/0.55));
    const t = vnoise3(dir.x*40+p.seed, dir.y*40, dir.z*40)*0.16;
    c.offsetHSL(0, 0, t-0.08);
    colors.push(c.r, c.g, c.b);
  }
  g.setAttribute('color', new THREE.Float32BufferAttribute(colors,3));
  g.computeVertexNormals();
  const maps = makePlanetMaps(p);
  const matOpts = { vertexColors:true, roughness:0.94, metalness:0.02,
    map:maps.map, bumpMap:maps.bump, bumpScale:p.radius*0.002 };
  if (maps.emissive) { matOpts.emissive = new THREE.Color(0xffffff); matOpts.emissiveMap = maps.emissive; matOpts.emissiveIntensity = p.lava ? 1.15 : 0.9; }
  const mesh = new THREE.Mesh(g, new THREE.MeshStandardMaterial(matOpts));
  mesh.position.copy(p.center);
  mesh.receiveShadow = true;
  scene.add(mesh);
  p.mesh = mesh;

  // Fresnel atmosfer parlaması
  if (p.atm > 0.3) {
    const atmoCol = new THREE.Color(p.sky).lerp(new THREE.Color(0xffffff), 0.35);
    const atmo = new THREE.Mesh(new THREE.SphereGeometry(p.radius*1.055, 56, 40),
      new THREE.ShaderMaterial({
        uniforms: { uCol: { value: atmoCol }, uOp: { value: 0.85*p.atm } },
        vertexShader: ATMO_VERT, fragmentShader: ATMO_FRAG,
        transparent:true, blending:THREE.AdditiveBlending, depthWrite:false, fog:false
      }));
    atmo.position.copy(p.center);
    scene.add(atmo);
  }
  // Bulut katmanı
  if (p.cloudy) {
    const cl = new THREE.Mesh(new THREE.SphereGeometry(p.radius*1.02, 48, 32),
      new THREE.MeshLambertMaterial({ map: makeCloudTexture(), transparent:true, depthWrite:false, opacity:0.92 }));
    cl.position.copy(p.center);
    scene.add(cl);
    if (!window._clouds) window._clouds = [];
    _clouds.push({ mesh: cl, spd: p.cloudSpd || 0.0018 });
  }

  /* ---- Kutuptaki üs + pist ---- */
  const pad = new THREE.Group();
  pad.position.copy(p.center).add(new THREE.Vector3(0, p.radius, 0));
  scene.add(pad);
  p.padGroup = pad;
  p.padWorld = pad.position.clone();

  const accent = new THREE.Color(p.cols[3]).lerp(new THREE.Color(0x66e7ff), 0.5).getHex();
  const rw = new THREE.Mesh(new THREE.BoxGeometry(rwWid, 0.6, rwLen),
    new THREE.MeshStandardMaterial({ map: getRunwayTex(), roughness:0.96, metalness:0.02 }));
  rw.position.y = 0.3; rw.receiveShadow = true; pad.add(rw);
  // İniş apronu (H pedi)
  const apron = new THREE.Mesh(new THREE.CircleGeometry(42, 36),
    new THREE.MeshStandardMaterial({ map: getApronTex(), roughness:0.95, transparent:true }));
  apron.rotation.x = -Math.PI/2; apron.position.set(150, 0.35, -60); pad.add(apron);
  const lampMat = new THREE.MeshBasicMaterial({ color:accent });
  for (let z=-rwLen/2; z<=rwLen/2; z+=110) {
    for (const x of [-rwWid/2-3, rwWid/2+3]) {
      const l = new THREE.Mesh(new THREE.SphereGeometry(0.7,6,6), lampMat);
      l.position.set(x, 0.9, z); pad.add(l);
    }
  }
  // Kubbeler + tank + anten (her üste)
  const domeMat = new THREE.MeshStandardMaterial({ color:0x8ab8d8, metalness:0.35, roughness:0.2, transparent:true, opacity:0.5 });
  const baseMat = new THREE.MeshStandardMaterial({ color:0x565664, roughness:0.7, metalness:0.3 });
  const domes = [[140,0,-180,30],[196,0,-120,17],[172,0,-260,13]];
  for (const [x,y,z,r] of domes) {
    const d = new THREE.Mesh(new THREE.SphereGeometry(r,18,12,0,Math.PI*2,0,Math.PI/2), domeMat);
    d.position.set(x,y,z); pad.add(d);
    const rim = new THREE.Mesh(new THREE.CylinderGeometry(r+1.5,r+2.5,3,18), baseMat);
    rim.position.set(x,1.5,z); pad.add(rim);
  }
  const mast = new THREE.Mesh(new THREE.CylinderGeometry(1,2,54,8), baseMat);
  mast.position.set(100,27,-300); pad.add(mast);
  const beacon = new THREE.Mesh(new THREE.SphereGeometry(1.5,8,8), new THREE.MeshBasicMaterial({ color:0xff3355 }));
  beacon.position.set(100,56,-300); pad.add(beacon);
  p.beacon = beacon;
  for (let i=0;i<2;i++){
    const t = new THREE.Mesh(new THREE.SphereGeometry(8,12,9), new THREE.MeshStandardMaterial({ color:0xcfd8e2, metalness:0.65, roughness:0.3 }));
    t.position.set(-120-i*24, 8, -170); pad.add(t);
  }
  // PAPI iniş ışıkları (doğru süzülüşte 2 beyaz 2 kırmızı)
  p.papi = [];
  for (let i = 0; i < 4; i++) {
    const pl2 = new THREE.Mesh(new THREE.SphereGeometry(1.6, 8, 8),
      new THREE.MeshBasicMaterial({ color: 0xffffff }));
    pl2.position.set(-(rwWid/2 + 22), 1.6, rwLen/2 - 340 + i * 16);
    pad.add(pl2);
    p.papi.push(pl2);
  }

  // İsim holo-tabelası (canvas doku)
  const tcv = document.createElement('canvas'); tcv.width=512; tcv.height=128;
  const tc = tcv.getContext('2d');
  tc.fillStyle='rgba(0,0,0,0)'; tc.clearRect(0,0,512,128);
  tc.font='bold 72px Consolas, monospace'; tc.textAlign='center';
  tc.shadowColor='#66e7ff'; tc.shadowBlur=24;
  tc.fillStyle='#bfefff'; tc.fillText('◈ '+p.name, 256, 88);
  const nameTex = new THREE.CanvasTexture(tcv);
  const sign = new THREE.Mesh(new THREE.PlaneGeometry(120, 30),
    new THREE.MeshBasicMaterial({ map:nameTex, transparent:true, side:THREE.DoubleSide, fog:false }));
  sign.position.set(140, 60, -180); pad.add(sign);
  p.sign = sign;

  // Halka sistemi (AURELIA)
  if (p.rings) {
    const rcv = document.createElement('canvas'); rcv.width = 512; rcv.height = 32;
    const rc = rcv.getContext('2d');
    for (let x=0; x<512; x++) {
      const t2 = x/512;
      const band = 0.5 + 0.5*Math.sin(t2*80) * Math.sin(t2*23+2);
      const gap = (t2>0.42 && t2<0.5) || (t2>0.72 && t2<0.76) ? 0.12 : 1;
      const al = (0.25 + band*0.45) * gap * (t2<0.06 ? t2/0.06 : 1) * (t2>0.94 ? (1-t2)/0.06 : 1);
      rc.fillStyle = 'rgba(' + (215+band*30|0) + ',' + (195+band*25|0) + ',' + (160+band*20|0) + ',' + al.toFixed(2) + ')';
      rc.fillRect(x, 0, 1, 32);
    }
    const rtex = new THREE.CanvasTexture(rcv);
    rtex.rotation = 0;
    const rg = new THREE.RingGeometry(p.radius*1.45, p.radius*2.3, 96, 1);
    // UV'yi radyal yap
    const uv = rg.attributes.uv, rpos = rg.attributes.position;
    for (let i=0;i<uv.count;i++){
      const vx = rpos.getX(i), vy = rpos.getY(i);
      const rr = (Math.hypot(vx,vy) - p.radius*1.45) / (p.radius*0.85);
      uv.setXY(i, rr, 0.5);
    }
    const ringMesh = new THREE.Mesh(rg, new THREE.MeshLambertMaterial({
      map: rtex, transparent:true, side:THREE.DoubleSide, depthWrite:false }));
    ringMesh.position.copy(p.center);
    ringMesh.rotation.x = Math.PI/2 - 0.32; ringMesh.rotation.y = 0.2;
    scene.add(ringMesh);
  }

  // Üs NPC'leri: astronotlar + rover
  buildPadNpcs(p, pad);
}

/* ---------------- ÜS NPC'LERİ ---------------- */
function makeAstronaut(visorCol) {
  const g = new THREE.Group();
  const suit = new THREE.MeshStandardMaterial({ color:0xe6e8ee, roughness:0.6 });
  const legs = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.16, 0.72, 8), suit);
  legs.position.y = 0.36; g.add(legs);
  const torso = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.2, 0.62, 8), suit);
  torso.position.y = 1.02; g.add(torso);
  const pack = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.46, 0.18),
    new THREE.MeshStandardMaterial({ color:0x9aa2ae, roughness:0.5, metalness:0.3 }));
  pack.position.set(0, 1.08, -0.24); g.add(pack);
  const helm = new THREE.Mesh(new THREE.SphereGeometry(0.19, 10, 8), suit);
  helm.position.y = 1.52; g.add(helm);
  const visor = new THREE.Mesh(new THREE.SphereGeometry(0.14, 10, 8),
    new THREE.MeshStandardMaterial({ color:visorCol, metalness:0.9, roughness:0.1 }));
  visor.scale.set(1, 0.8, 0.62); visor.position.set(0, 1.52, 0.09); g.add(visor);
  const lamp = new THREE.Mesh(new THREE.SphereGeometry(0.03, 6, 6),
    new THREE.MeshBasicMaterial({ color:0x66e7ff }));
  lamp.position.set(0.12, 1.24, 0.16); g.add(lamp);
  return g;
}
function makeRover() {
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.55, 1.4),
    new THREE.MeshStandardMaterial({ color:0xb8bec8, metalness:0.45, roughness:0.5 }));
  body.position.y = 0.72; g.add(body);
  const cab = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.5, 1.2),
    new THREE.MeshStandardMaterial({ color:0x3a6a9a, metalness:0.6, roughness:0.25 }));
  cab.position.set(0.6, 1.2, 0); g.add(cab);
  g.userData.wheels = [];
  for (const [wx, wz] of [[-0.9,0.72],[0.9,0.72],[-0.9,-0.72],[0.9,-0.72]]) {
    const w = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 0.24, 10),
      new THREE.MeshStandardMaterial({ color:0x1c1c20, roughness:0.9 }));
    w.rotation.x = Math.PI/2; w.position.set(wx, 0.35, wz);
    g.add(w); g.userData.wheels.push(w);
  }
  const beacon = new THREE.Mesh(new THREE.SphereGeometry(0.09, 6, 6),
    new THREE.MeshBasicMaterial({ color:0xffb020 }));
  beacon.position.set(-1.0, 1.15, 0); g.add(beacon);
  g.userData.beacon = beacon;
  return g;
}
const VISOR_COLS = [0xd8a020, 0x40b8e0, 0xc050d0, 0x50d080];
function buildPadNpcs(p, pad) {
  p.npcs = [];
  for (let i=0;i<4;i++){
    const a = makeAstronaut(VISOR_COLS[i%VISOR_COLS.length]);
    const x = 100 + Math.random()*130, z = -110 - Math.random()*220;
    a.position.set(x, 0.4, z);
    pad.add(a);
    p.npcs.push({ mesh:a, wp:new THREE.Vector3(x, 0.4, z), speed:0.9+Math.random()*0.7,
      pause:Math.random()*3, phase:Math.random()*10, type:'ast' });
  }
  const rv = makeRover();
  rv.position.set(60, 0.4, -80);
  pad.add(rv);
  p.npcs.push({ mesh:rv, wpIdx:0, speed:4.5, type:'rover',
    route:[ new THREE.Vector3(60,0.4,-80), new THREE.Vector3(240,0.4,-120),
            new THREE.Vector3(250,0.4,-330), new THREE.Vector3(70,0.4,-360), new THREE.Vector3(45,0.4,-160) ] });
}
const _npcTmp = new THREE.Vector3();
function updateNpcs(dt, now) {
  for (const p of PLANETS) {
    if (!p.npcs || camera.position.distanceTo(p.padWorld) > 6500) continue;
    for (const n of p.npcs) {
      if (n.type === 'ast') {
        if (n.pause > 0) { n.pause -= dt; continue; }
        _npcTmp.copy(n.wp).sub(n.mesh.position); _npcTmp.y = 0;
        const d = _npcTmp.length();
        if (d < 1.2) {
          n.wp.set(95 + Math.random()*150, 0.4, -100 - Math.random()*250);
          n.pause = 1 + Math.random()*4;
        } else {
          _npcTmp.normalize();
          n.mesh.position.addScaledVector(_npcTmp, n.speed*dt);
          n.mesh.rotation.y = Math.atan2(_npcTmp.x, _npcTmp.z);
          n.mesh.position.y = 0.4 + Math.abs(Math.sin(now*0.011 + n.phase))*0.06;
        }
      } else {
        const tgt = n.route[n.wpIdx];
        _npcTmp.copy(tgt).sub(n.mesh.position); _npcTmp.y = 0;
        const d = _npcTmp.length();
        if (d < 3) { n.wpIdx = (n.wpIdx+1) % n.route.length; }
        else {
          _npcTmp.normalize();
          n.mesh.position.addScaledVector(_npcTmp, n.speed*dt);
          const wantY = Math.atan2(_npcTmp.x, _npcTmp.z) - Math.PI/2;
          let dy = wantY - n.mesh.rotation.y;
          while (dy > Math.PI) dy -= Math.PI*2;
          while (dy < -Math.PI) dy += Math.PI*2;
          n.mesh.rotation.y += dy * Math.min(1, dt*3);
          for (const w of n.mesh.userData.wheels) w.rotation.y += n.speed*dt/0.35;
        }
        n.mesh.userData.beacon.material.color.setHex(Math.sin(now*0.012)>0 ? 0xffb020 : 0x553508);
      }
    }
  }
}
for (const p of PLANETS) buildPlanet(p);

/* ---------------- UZAY İSTASYONLARI ---------------- */
const STATIONS = [
  { name:'ORBITAL-1', center:new THREE.Vector3(9000, 14000, -12000), radius:300 },
  { name:'VARDIYA',   center:new THREE.Vector3(-58000, 12000, -8000), radius:300 }
];
function buildStation(st) {
  const g = new THREE.Group();
  g.position.copy(st.center);
  const hullMat = new THREE.MeshStandardMaterial({ color:0xc8ccd6, metalness:0.6, roughness:0.35 });
  const darkMat = new THREE.MeshStandardMaterial({ color:0x3a3e48, metalness:0.7, roughness:0.4 });
  // Merkez gövde
  const hub = new THREE.Mesh(new THREE.CylinderGeometry(28, 28, 160, 16), hullMat);
  g.add(hub);
  const hubCap = new THREE.Mesh(new THREE.SphereGeometry(30, 16, 12), hullMat);
  hubCap.position.y = 84; g.add(hubCap);
  const hubCap2 = hubCap.clone(); hubCap2.position.y = -84; g.add(hubCap2);
  // Dönen yaşam halkası
  const ring = new THREE.Group();
  const torus = new THREE.Mesh(new THREE.TorusGeometry(130, 16, 12, 40), hullMat);
  ring.add(torus);
  for (let i=0;i<4;i++){
    const spoke = new THREE.Mesh(new THREE.CylinderGeometry(5, 5, 230, 8), darkMat);
    spoke.rotation.z = Math.PI/2; spoke.rotation.y = i*Math.PI/4;
    ring.add(spoke);
  }
  // Halka pencereleri
  for (let i=0;i<24;i++){
    const wn = new THREE.Mesh(new THREE.BoxGeometry(7, 4, 2),
      new THREE.MeshBasicMaterial({ color:0xffd890 }));
    const ang = i/24*Math.PI*2;
    wn.position.set(Math.cos(ang)*130, Math.sin(ang)*130, 17);
    wn.rotation.z = ang;
    ring.add(wn);
  }
  ring.rotation.x = Math.PI/2;
  g.add(ring);
  st.ring = ring;
  // Güneş panelleri
  const panMat = new THREE.MeshStandardMaterial({ color:0x1a3a7a, metalness:0.8, roughness:0.2, side:THREE.DoubleSide });
  for (const sx of [-1,1]) {
    const arm = new THREE.Mesh(new THREE.CylinderGeometry(3, 3, 90, 8), darkMat);
    arm.rotation.z = Math.PI/2; arm.position.set(sx*70, 55, 0); g.add(arm);
    const pan = new THREE.Mesh(new THREE.BoxGeometry(110, 2, 44), panMat);
    pan.position.set(sx*150, 55, 0); g.add(pan);
    const grid = new THREE.Mesh(new THREE.BoxGeometry(110.5, 0.5, 3), darkMat);
    grid.position.set(sx*150, 56.5, 0); g.add(grid);
  }
  // Yanaşma kolu + kapısı
  const dockArm = new THREE.Mesh(new THREE.CylinderGeometry(7, 7, 240, 10), darkMat);
  dockArm.rotation.x = Math.PI/2; dockArm.position.set(0, -30, 200); g.add(dockArm);
  const port = new THREE.Mesh(new THREE.CylinderGeometry(22, 26, 24, 14), hullMat);
  port.rotation.x = Math.PI/2; port.position.set(0, -30, 330); g.add(port);
  st.dockRing = new THREE.Mesh(new THREE.TorusGeometry(26, 2.4, 8, 24),
    new THREE.MeshBasicMaterial({ color:0x2a8a4a }));
  st.dockRing.position.set(0, -30, 344); g.add(st.dockRing);
  // Yakıt tankları
  for (let i=0;i<3;i++){
    const tk = new THREE.Mesh(new THREE.SphereGeometry(20, 12, 9),
      new THREE.MeshStandardMaterial({ color:0xd8a850, metalness:0.5, roughness:0.4 }));
    tk.scale.y = 1.5;
    tk.position.set(-46 + i*46, -110, -30);
    g.add(tk);
  }
  // Çakarlar
  st.beacons = [];
  for (const [bx,by,bz] of [[0,95,0],[0,-95,0],[160,55,0],[-160,55,0]]) {
    const b = new THREE.Mesh(new THREE.SphereGeometry(3, 6, 6),
      new THREE.MeshBasicMaterial({ color:0xff3355 }));
    b.position.set(bx,by,bz); g.add(b);
    st.beacons.push(b);
  }
  // Holo isim
  const tcv = document.createElement('canvas'); tcv.width=512; tcv.height=128;
  const tc = tcv.getContext('2d');
  tc.font='bold 64px Consolas, monospace'; tc.textAlign='center';
  tc.shadowColor='#66ffa8'; tc.shadowBlur=24;
  tc.fillStyle='#bfffdf'; tc.fillText('⛽ '+st.name, 256, 84);
  const sign = new THREE.Mesh(new THREE.PlaneGeometry(260, 65),
    new THREE.MeshBasicMaterial({ map:new THREE.CanvasTexture(tcv), transparent:true, side:THREE.DoubleSide, fog:false }));
  sign.position.set(0, 170, 0); g.add(sign);
  st.sign = sign;
  scene.add(g);
  st.group = g;
  st.padWorld = st.center.clone().add(new THREE.Vector3(0, -30, 380));  // yanaşma noktası
  st.isStation = true;
}
for (const st of STATIONS) buildStation(st);
/* ---------------- KARA DELİK: KARANLIK ---------------- */
const BH = { name:'⚫ KARANLIK', center:new THREE.Vector3(-20000, 34000, -175000), radius:2500, padWorld:null, isBH:true };
BH.padWorld = BH.center.clone();
{
  // Olay ufku
  const core = new THREE.Mesh(new THREE.SphereGeometry(BH.radius, 40, 28),
    new THREE.MeshBasicMaterial({ color:0x000000, fog:false }));
  core.position.copy(BH.center); scene.add(core);
  // Foton halkası (parlak ince çember)
  const photon = new THREE.Mesh(new THREE.TorusGeometry(BH.radius*1.18, BH.radius*0.045, 10, 64),
    new THREE.MeshBasicMaterial({ color:0xfff2d8, fog:false, transparent:true, opacity:0.95, blending:THREE.AdditiveBlending }));
  photon.position.copy(BH.center); scene.add(photon);
  BH.photon = photon;
  // Yığılma diski (radyal degrade doku)
  const dcv = document.createElement('canvas'); dcv.width=512; dcv.height=64;
  const dc = dcv.getContext('2d');
  const dg = dc.createLinearGradient(0,0,512,0);
  dg.addColorStop(0,'rgba(255,250,235,1)');
  dg.addColorStop(0.15,'rgba(255,190,110,0.95)');
  dg.addColorStop(0.45,'rgba(230,110,60,0.6)');
  dg.addColorStop(0.8,'rgba(150,50,120,0.25)');
  dg.addColorStop(1,'rgba(80,20,90,0)');
  dc.fillStyle=dg; dc.fillRect(0,0,512,64);
  for (let i=0;i<160;i++){ dc.fillStyle='rgba(0,0,0,'+(Math.random()*0.25)+')'; dc.fillRect(Math.random()*512, 0, 1+Math.random()*3, 64); }
  const dtex = new THREE.CanvasTexture(dcv);
  const dgeo = new THREE.RingGeometry(BH.radius*1.3, BH.radius*4.6, 96, 1);
  const duv = dgeo.attributes.uv, dpos = dgeo.attributes.position;
  for (let i=0;i<duv.count;i++){
    const vx=dpos.getX(i), vy=dpos.getY(i);
    duv.setXY(i, (Math.hypot(vx,vy)-BH.radius*1.3)/(BH.radius*3.3), 0.5);
  }
  const disk = new THREE.Mesh(dgeo, new THREE.MeshBasicMaterial({ map:dtex, fog:false, transparent:true, side:THREE.DoubleSide, blending:THREE.AdditiveBlending, depthWrite:false }));
  disk.position.copy(BH.center);
  disk.rotation.x = Math.PI/2 - 0.35; disk.rotation.y = 0.2;
  scene.add(disk);
  BH.disk = disk;
  // Dış parlama
  const bhGlow = new THREE.Sprite(new THREE.SpriteMaterial({ map: radialTex('rgba(255,180,110,0.32)', null, 'rgba(140,60,140,0)'), transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  bhGlow.scale.set(BH.radius*18, BH.radius*18, 1);
  bhGlow.position.copy(BH.center); scene.add(bhGlow);
  // İkinci, ters eğik hayalet disk (mercekleme yanılsaması)
  const disk2 = disk.clone();
  disk2.material = disk.material.clone();
  disk2.material.opacity = 0.45;
  disk2.rotation.x = Math.PI/2 + 0.9; disk2.rotation.y = -0.3;
  disk2.scale.setScalar(0.85);
  scene.add(disk2);
  BH.disk2 = disk2;
  // İçe düşen madde spirali (parçacıklar)
  const pn = 420, ppos = new Float32Array(pn*3), pdata = [];
  for (let i=0;i<pn;i++){
    pdata.push({ r: BH.radius*(1.4+Math.random()*4.2), a: Math.random()*Math.PI*2,
      w: 0.25+Math.random()*0.5, tilt: (Math.random()-0.5)*0.35 });
  }
  const pg = new THREE.BufferGeometry();
  pg.setAttribute('position', new THREE.BufferAttribute(ppos,3));
  const infall = new THREE.Points(pg, new THREE.PointsMaterial({ color:0xffc890, size:60, fog:false, transparent:true, opacity:0.8, blending:THREE.AdditiveBlending, depthWrite:false }));
  infall.position.copy(BH.center);
  scene.add(infall);
  BH.infall = { pts: infall, data: pdata, attr: pg.attributes.position };
}
const TARGETS = PLANETS.concat(STATIONS).concat([BH]);

/* ---------------- ASTEROİT KUŞAĞI ---------------- */
const asteroids = [];
{
  const rockGeo = new THREE.DodecahedronGeometry(1, 0);
  const rockMat = new THREE.MeshStandardMaterial({ color:0x6a6258, roughness:0.95, metalness:0.05 });
  const rockMat2 = new THREE.MeshStandardMaterial({ color:0x4a4a54, roughness:0.9, metalness:0.12 });
  let placed = 0, tries = 0;
  while (placed < 130 && tries < 800) {
    tries++;
    const ang = Math.random()*Math.PI*2;
    const rad = 42000 + Math.random()*26000;
    const pos = new THREE.Vector3(Math.cos(ang)*rad, (Math.random()-0.5)*11000 + 4000, Math.sin(ang)*rad);
    let ok = true;
    for (const p of PLANETS) if (pos.distanceTo(p.center) < p.radius + 9000) { ok = false; break; }
    if (!ok) continue;
    const m = new THREE.Mesh(rockGeo, Math.random()<0.5 ? rockMat : rockMat2);
    const sc = 6 + Math.random()*Math.random()*46;
    m.scale.set(sc*(0.7+Math.random()*0.6), sc*(0.7+Math.random()*0.6), sc*(0.7+Math.random()*0.6));
    m.position.copy(pos);
    m.rotation.set(Math.random()*3, Math.random()*3, Math.random()*3);
    scene.add(m);
    const avgS = (m.scale.x + m.scale.y + m.scale.z) / 3;
    asteroids.push({ mesh:m, rx:(Math.random()-0.5)*0.3, ry:(Math.random()-0.5)*0.3,
      rad: avgS * 1.2, hp: Math.max(1, Math.round(avgS / 13)) });
    placed++;
  }
}

/* ---------------- KUYRUKLU YILDIZ ---------------- */
const comet = (() => {
  const g = new THREE.Group();
  const head = new THREE.Mesh(new THREE.IcosahedronGeometry(60, 1),
    new THREE.MeshStandardMaterial({ color:0xcfe4f2, roughness:0.5, emissive:0x224455, emissiveIntensity:0.6 }));
  g.add(head);
  const glowT = radialTex('rgba(190,230,255,0.9)','rgba(140,200,255,0.35)','rgba(120,180,255,0)');
  const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map:glowT, transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  glow.scale.set(500, 500, 1); g.add(glow);
  const tail = new THREE.Sprite(new THREE.SpriteMaterial({ map:glowT, transparent:true, opacity:0.4, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  tail.scale.set(4200, 900, 1); tail.position.set(2200, 0, 0); g.add(tail);
  scene.add(g);
  return { g, t: Math.random()*Math.PI*2 };
})();

/* ---------------- SARMAL GALAKSİ (gökyüzü süsü) ---------------- */
{
  const cv = document.createElement('canvas'); cv.width = cv.height = 512;
  const c = cv.getContext('2d');
  c.translate(256, 256);
  for (let arm=0; arm<2; arm++){
    for (let i=0;i<900;i++){
      const t = i/900 * 4.4;
      const r = 12 + t*52;
      const a = t*1.9 + arm*Math.PI + (Math.random()-0.5)*0.5;
      const x = Math.cos(a)*r, y = Math.sin(a)*r*0.62;
      const b = Math.max(0, 1 - t/4.4);
      c.fillStyle = 'rgba(' + (200+b*55|0) + ',' + (190+b*40|0) + ',255,' + (0.06+b*0.3).toFixed(2) + ')';
      const sz = 0.8 + Math.random()*2.2*b;
      c.fillRect(x, y, sz, sz);
    }
  }
  const cg = c.createRadialGradient(0,0,2,0,0,55);
  cg.addColorStop(0,'rgba(255,250,230,0.95)'); cg.addColorStop(1,'rgba(255,240,210,0)');
  c.fillStyle = cg; c.fillRect(-60,-60,120,120);
  const gal = new THREE.Sprite(new THREE.SpriteMaterial({ map:new THREE.CanvasTexture(cv), transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending, opacity:0.85 }));
  gal.scale.set(90000, 90000, 1);
  gal.position.set(150000, 120000, -240000);
  scene.add(gal);
}

/* ---------------- NPC TRAFİK GEMİLERİ ---------------- */
const TRAFFIC = [];
function makeTrafficShip() {
  const g = new THREE.Group();
  const hull = new THREE.Mesh(new THREE.CylinderGeometry(2.4, 3.2, 22, 8),
    new THREE.MeshStandardMaterial({ color:0xaab2c0, metalness:0.5, roughness:0.45 }));
  hull.rotation.x = Math.PI/2; g.add(hull);
  const wing = new THREE.Mesh(new THREE.BoxGeometry(20, 0.7, 6),
    new THREE.MeshStandardMaterial({ color:0x8a92a2, metalness:0.5, roughness:0.5 }));
  wing.position.z = -4; g.add(wing);
  const glowT = radialTex('rgba(140,170,255,0.95)', null, 'rgba(120,150,255,0)');
  const eng2 = new THREE.Sprite(new THREE.SpriteMaterial({ map:glowT, transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  eng2.scale.set(16, 16, 1); eng2.position.z = -13; g.add(eng2);
  const strobe2 = new THREE.Mesh(new THREE.SphereGeometry(0.8, 6, 6),
    new THREE.MeshBasicMaterial({ color:0xffffff }));
  strobe2.position.set(0, 3.4, 0); g.add(strobe2);
  g.userData.strobe = strobe2; g.userData.eng = eng2;
  scene.add(g);
  return g;
}
{
  const orbitPt = (p, dx, dy, dz) => p.center.clone().add(new THREE.Vector3(dx, dy, dz).normalize().multiplyScalar(p.radius + 11000));
  const routes = [
    [ orbitPt(PLANETS[0], 1, 0.5, 0.4), STATIONS[0].center.clone().add(new THREE.Vector3(500,200,0)), orbitPt(PLANETS[6], -1, 0.4, 0.6), orbitPt(PLANETS[1], -0.5, 0.3, 1) ],
    [ orbitPt(PLANETS[2], 0.6, 1, -0.4), STATIONS[1].center.clone().add(new THREE.Vector3(-400,300,200)), orbitPt(PLANETS[4], 1, -0.3, 0.5) ],
    [ orbitPt(PLANETS[3], -0.6, 0.5, 0.5), orbitPt(PLANETS[5], 0.3, 1, -0.5), STATIONS[0].center.clone().add(new THREE.Vector3(-600,-200,300)) ]
  ];
  for (const route of routes) {
    const ship = makeTrafficShip();
    ship.position.copy(route[0]);
    TRAFFIC.push({ ship, route, seg:0, speed: 550 + Math.random()*450 });
  }
}
const _trTmp = new THREE.Vector3();
function updateTraffic(dt, now) {
  for (const tr of TRAFFIC) {
    const tgt = tr.route[(tr.seg+1) % tr.route.length];
    _trTmp.copy(tgt).sub(tr.ship.position);
    const d = _trTmp.length();
    if (d < 900) { tr.seg = (tr.seg+1) % tr.route.length; continue; }
    _trTmp.divideScalar(d);
    tr.ship.position.addScaledVector(_trTmp, tr.speed*dt);
    const want = new THREE.Quaternion().setFromRotationMatrix(
      new THREE.Matrix4().lookAt(new THREE.Vector3(), _trTmp.clone().negate(), new THREE.Vector3(0,1,0)));
    tr.ship.quaternion.slerp(want, Math.min(1, dt*1.6));
    tr.ship.userData.strobe.material.color.setHex(((now + tr.speed) % 1200 < 70) ? 0xffffff : 0x222228);
    tr.ship.userData.eng.material.opacity = 0.7 + Math.sin(now*0.02)*0.15;
  }
}

/* ---------------- SİLAH SİSTEMİ (plazma topları) ---------------- */
const bolts = [];
let fireHeld = false, lastShot = 0, gunSide = 1;
const boltGeo = new THREE.CylinderGeometry(0.14, 0.14, 5.5, 6);
boltGeo.rotateX(Math.PI/2);
const boltMat = new THREE.MeshBasicMaterial({ color:0x7de5ff, blending:THREE.AdditiveBlending, transparent:true, opacity:0.95, depthWrite:false });
function fireBolt(now) {
  if (now - lastShot < 145 || S.crashed || S.warp !== 'off' || !started) return;
  lastShot = now; gunSide *= -1;
  const f2 = new THREE.Vector3(0,0,1).applyQuaternion(S.quat);
  const r2 = new THREE.Vector3(1,0,0).applyQuaternion(S.quat);
  const b = new THREE.Mesh(boltGeo, boltMat);
  b.position.copy(S.pos).addScaledVector(r2, gunSide * 1.6).addScaledVector(f2, 8);
  b.quaternion.copy(S.quat);
  scene.add(b);
  bolts.push({ m: b, vel: S.vel.clone().addScaledVector(f2, 1150), life: 2.6 });
  if (audio.ctx) laserShot();
}
function explodeAsteroid(ai) {
  const ast = asteroids[ai];
  const reward = Math.round(ast.rad * 1.6 + 8) * (S.upg.gun ? 1.2 : 1) | 0;
  S.credits += reward;
  flash('💎 +' + reward + ' Kr — asteroit minerali!');
  // Enkaz efekti
  const n = 40, pos2 = new Float32Array(n*3), vel2 = [];
  for (let i=0;i<n;i++){
    pos2[i*3]=ast.mesh.position.x; pos2[i*3+1]=ast.mesh.position.y; pos2[i*3+2]=ast.mesh.position.z;
    vel2.push(new THREE.Vector3((Math.random()-0.5)*40,(Math.random()-0.5)*40,(Math.random()-0.5)*40));
  }
  const g2 = new THREE.BufferGeometry();
  g2.setAttribute('position', new THREE.BufferAttribute(pos2,3));
  const pts2 = new THREE.Points(g2, new THREE.PointsMaterial({ color:0xd8b060, size:3, transparent:true, blending:THREE.AdditiveBlending }));
  pts2.userData = { vel: vel2, life: 1.3, up: new THREE.Vector3(0,0,0) };
  scene.add(pts2); activeFx.push(pts2);
  scene.remove(ast.mesh);
  asteroids.splice(ai, 1);
  if (audio.ctx) miniBoom();
  sara('Mineral toplandı. ' + reward + ' kredi.');
}
function updateWeapons(dt, now) {
  if (fireHeld) fireBolt(now);
  for (let i = bolts.length - 1; i >= 0; i--) {
    const b = bolts[i];
    b.life -= dt;
    b.m.position.addScaledVector(b.vel, dt);
    let hit = false;
    for (let ai = asteroids.length - 1; ai >= 0; ai--) {
      const ast = asteroids[ai];
      if (b.m.position.distanceTo(ast.mesh.position) < ast.rad + 4) {
        ast.hp -= (S.upg.gun ? 2 : 1);
        ast.mesh.scale.multiplyScalar(0.985);
        hit = true;
        if (audio.ctx) hitClank();
        if (ast.hp <= 0) explodeAsteroid(ai);
        break;
      }
    }
    if (hit || b.life <= 0) { scene.remove(b.m); bolts.splice(i, 1); }
  }
}

/* ---------------- GÖREV & KREDİ & MAĞAZA ---------------- */
const CARGO = ['tıbbi kargo', 'veri çekirdeği', 'koloni erzağı', 'antimadde hücresi', 'kriyo yolcular', 'maden ekipmanı', 'yedek parça', 'gizli evrak'];
function fuelMax() { return 4200 * (S.upg.tank ? 1.3 : 1); }
function warpChargeT() { return S.upg.warp ? 1.4 : 2.4; }
function odLimitT() { return S.upg.armor ? 6.5 : 5; }
function atBase() {
  if (window.S_DOCK) return window.S_DOCK;
  if (S.onGround) return S.planet;
  return null;
}
function genMission() {
  const from = atBase() || S.planet;
  const cands = TARGETS.filter(t => t !== BH && t !== from);
  const to = cands[(Math.random() * cands.length) | 0];
  const distKm = from.padWorld.distanceTo(to.padWorld) / 1000;
  return { from, to, cargo: CARGO[(Math.random() * CARGO.length) | 0],
    reward: Math.round(60 + distKm * 1.4 + (to.isStation ? 40 : 0)) };
}
const SHOP = [
  { id:'tank',  name:'Genişletilmiş yakıt tankı (+%30)', cost:300 },
  { id:'gun',   name:'Çift plazma yükselteci (hasar ×2)', cost:350 },
  { id:'odc',   name:'Overdrive hızlı şarj',              cost:450 },
  { id:'armor', name:'Takviyeli gövde (G13 · limit 6.5sn)', cost:500 },
  { id:'warp',  name:'Warp hızlandırıcı (1.4sn şarj)',    cost:600 }
];
function nextShopItem() { return SHOP.find(it => !S.upg[it.id]); }
function missionTick() {
  if (!S.mission) return;
  const to = S.mission.to;
  const done = to.isStation ? window.S_DOCK === to : (S.onGround && S.planet === to);
  if (done) {
    S.credits += S.mission.reward;
    flash('✔ GÖREV TAMAM: ' + S.mission.cargo + ' teslim edildi — +' + S.mission.reward + ' Kr');
    sara('Görev tamamlandı. ' + S.mission.reward + ' kredi hesabına geçti. Tebrikler komutan.');
    S.mission = null;
  }
}

/* SARA kaldırıldı */
function sara() {}
function saraTick() {}

/* ---------------- YAKIT İKMALİ ---------------- */
S_DOCK = null;
function updateDocking(dt) {
  if (S.crashed || S.warp !== 'off') { window.S_DOCK = null; return; }
  let found = null;
  for (const st of STATIONS) {
    const d = S.pos.distanceTo(st.padWorld);
    const spd = S.vel.length();
    st.dockRing.material.color.setHex(d < 600 ? (spd < 18 ? 0x2aff6a : 0xffb020) : 0x2a8a4a);
    if (d < 150 && spd < 18) found = st;
  }
  if (found && !window.S_DOCK) {
    window.S_DOCK = found;
    flash('⛽ ' + found.name + ' — İKMAL BAĞLANTISI KURULDU');
    if (audio.ctx) audio.fuelHum.gain.setTargetAtTime(0.12, audio.ctx.currentTime, 0.2);
  } else if (!found && window.S_DOCK) {
    window.S_DOCK = null;
    flash('İkmal bağlantısı ayrıldı');
    if (audio.ctx) audio.fuelHum.gain.setTargetAtTime(0, audio.ctx.currentTime, 0.3);
  }
  if (window.S_DOCK) {
    // İstasyon tutunması: manyetik kenet — sürüklenme yok
    S.vel.multiplyScalar(Math.max(0, 1 - dt * 2.4));
    const pull = window.S_DOCK.padWorld.clone().sub(S.pos);
    if (pull.length() > 5) S.vel.addScaledVector(pull.normalize(), dt * 7);
    if (S.fuel < fuelMax()) {
      S.fuel = Math.min(fuelMax(), S.fuel + 320*dt);
    } else if (!window._fullMsg || performance.now() - window._fullMsg > 6000) {
      window._fullMsg = performance.now();
      flash('DEPO DOLU — iyi yolculuklar! ⛽✔');
    }
  }
}

function nearestPlanet(pos) {
  let best = PLANETS[0], bd = Infinity;
  for (const p of PLANETS) {
    const d = pos.distanceTo(p.center) - p.radius;
    if (d < bd) { bd = d; best = p; }
  }
  return best;
}

/* ---------------- MEKİK (DIŞ MODEL — gerçekçi) ---------------- */
const plane = new THREE.Group();
const extGroup = new THREE.Group();
const gearGroup = new THREE.Group();
let abGlows = [], engGlows = [], navLightL, navLightR, strobe;

/* Gövde kaplaması: panel çizgileri, isim, arma, yıpranma */
function makeHullTex() {
  const W=1024, H=512;
  const cv = document.createElement('canvas'); cv.width=W; cv.height=H;
  const c = cv.getContext('2d');
  c.fillStyle = '#e9ebf0'; c.fillRect(0,0,W,H);
  fbmFill(c, W, H, 3, 0.10);
  // Panel çizgileri
  c.strokeStyle = 'rgba(120,128,140,0.4)'; c.lineWidth = 1.2;
  for (let x=0; x<W; x+=64) { c.beginPath(); c.moveTo(x,0); c.lineTo(x,H); c.stroke(); }
  for (let y=0; y<H; y+=44) { c.beginPath(); c.moveTo(0,y); c.lineTo(W,y); c.stroke(); }
  // İnce panel detay çizgileri
  c.strokeStyle = 'rgba(140,148,160,0.22)';
  for (let i=0;i<40;i++){
    const x = Math.random()*W, y = Math.random()*H, l = 20+Math.random()*60;
    c.beginPath();
    if (Math.random()<0.5) { c.moveTo(x,y); c.lineTo(x+l,y); } else { c.moveTo(x,y); c.lineTo(x,y+l); }
    c.stroke();
  }
  // Perçin noktaları
  c.fillStyle = 'rgba(110,118,130,0.35)';
  for (let x=8; x<W; x+=64) for (let y=6; y<H; y+=44) { c.fillRect(x,y,1.6,1.6); c.fillRect(x+48,y+34,1.6,1.6); }
  // Yıpranma / is akıntıları
  c.fillStyle = 'rgba(90,94,104,0.10)';
  for (let i=0;i<26;i++){
    const x = Math.random()*W, y = Math.random()*H;
    c.fillRect(x, y, 2+Math.random()*4, 24+Math.random()*90);
  }
  // Aksan şeridi (cyan-kızıl ikili)
  c.fillStyle = '#c9313e'; c.fillRect(0, 208, W, 10);
  c.fillStyle = '#3ab8d8'; c.fillRect(0, 222, W, 4);
  // İsim + tescil (iki yanda)
  for (const ux of [140, 650]) {
    c.fillStyle = '#1d2530'; c.font = 'bold 34px Consolas, monospace';
    c.fillText('ŞAHİN-X', ux, 196);
    c.font = '15px Consolas, monospace'; c.fillStyle = '#5a6270';
    c.fillText('KIZILÖTE FİLOSU · TC-SX01', ux, 252);
    // Arma: kırmızı yuvarlak + yıldız
    c.fillStyle = '#c9313e';
    c.beginPath(); c.arc(ux-42, 184, 22, 0, Math.PI*2); c.fill();
    c.fillStyle = '#fff';
    c.save(); c.translate(ux-42, 184);
    c.beginPath();
    for (let i=0;i<5;i++){
      const a = -Math.PI/2 + i*Math.PI*2/5;
      const a2 = a + Math.PI/5;
      c.lineTo(Math.cos(a)*11, Math.sin(a)*11);
      c.lineTo(Math.cos(a2)*4.6, Math.sin(a2)*4.6);
    }
    c.closePath(); c.fill(); c.restore();
  }
  const t = new THREE.CanvasTexture(cv);
  t.anisotropy = 8;
  return t;
}
/* Isı kalkanı karo dokusu */
function makeTileTex() {
  const S=512;
  const cv = document.createElement('canvas'); cv.width=cv.height=S;
  const c = cv.getContext('2d');
  c.fillStyle = '#15161b'; c.fillRect(0,0,S,S);
  for (let y=0; y<S; y+=14) for (let x=0; x<S; x+=14) {
    const v = 16 + Math.random()*22;
    c.fillStyle = Math.random() < 0.015 ? '#3a3d46' : 'rgb(' + (v|0) + ',' + (v+1|0) + ',' + (v+5|0) + ')';
    c.fillRect(x+1, y+1, 12, 12);
  }
  const t = new THREE.CanvasTexture(cv);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(3, 2);
  t.anisotropy = 8;
  return t;
}
{
  const hullTex = makeHullTex();
  const hullMat = new THREE.MeshStandardMaterial({ map:hullTex, bumpMap:hullTex, bumpScale:0.012, metalness:0.18, roughness:0.52 });
  const tileMat = new THREE.MeshStandardMaterial({ map:makeTileTex(), metalness:0.35, roughness:0.6 });
  const darkGrey = new THREE.MeshStandardMaterial({ color:0x3a3d46, metalness:0.55, roughness:0.45 });
  const carbon = new THREE.MeshStandardMaterial({ color:0x1a1c22, metalness:0.5, roughness:0.4 });

  /* Gövde: pürüzsüz lathe profili (kuyruk → burun) */
  const prof = [
    [1.18,-7.0],[1.34,-5.6],[1.46,-3.4],[1.52,-0.8],[1.52,1.4],
    [1.44,3.0],[1.28,4.3],[1.02,5.3],[0.66,6.2],[0.3,6.85],[0.0,7.15]
  ].map(p => new THREE.Vector2(p[0], p[1]));
  const hullGeo = new THREE.LatheGeometry(prof, 28);
  hullGeo.rotateX(Math.PI/2);
  hullGeo.scale(1.24, 0.94, 1);
  const hull = new THREE.Mesh(hullGeo, hullMat);
  hull.castShadow = true;
  extGroup.add(hull);

  /* Alt ısı kalkanı (karolar): alt yay dilimi, hafif büyük */
  const bellyGeo = new THREE.LatheGeometry(prof, 20, 0.18, Math.PI - 0.36);
  bellyGeo.rotateX(Math.PI/2);
  bellyGeo.scale(1.26, 0.955, 1.006);
  extGroup.add(new THREE.Mesh(bellyGeo, tileMat));

  /* Burun kapağı (siyah karo) */
  const nose = new THREE.Mesh(new THREE.SphereGeometry(1.0, 18, 12), tileMat);
  nose.scale.set(1.16, 0.82, 1.9); nose.position.set(0, -0.06, 5.95);
  extGroup.add(nose);
  // Pitot sondası
  const pitot = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.015, 0.9, 6), darkGrey);
  pitot.rotation.x = Math.PI/2; pitot.position.set(0, 0.05, 7.55);
  extGroup.add(pitot);

  /* Kokpit camları: 6 çerçeveli pano */
  const winMat = new THREE.MeshStandardMaterial({ color:0x0a1422, metalness:0.92, roughness:0.05, emissive:0x16283c, emissiveIntensity:0.5 });
  const winDefs = [[-0.78,0.52],[-0.47,0.32],[-0.16,0.1],[0.16,-0.1],[0.47,-0.32],[0.78,-0.52]];
  for (const [x, ry] of winDefs) {
    const frame = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.44, 0.1), darkGrey);
    frame.position.set(x, 1.06, 4.78 - Math.abs(x)*0.34);
    frame.rotation.x = -0.44; frame.rotation.y = ry;
    extGroup.add(frame);
    const w = new THREE.Mesh(new THREE.BoxGeometry(0.27, 0.36, 0.11), winMat);
    w.position.copy(frame.position).add(new THREE.Vector3(0, 0, 0.012));
    w.rotation.copy(frame.rotation);
    extGroup.add(w);
  }

  /* Kargo kapağı hattı: sırt dikişi + menteşeler */
  const seam = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.03, 6.4), carbon);
  seam.position.set(0, 1.44, 0.4); extGroup.add(seam);
  for (let i=0;i<4;i++){
    const latch = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.05, 0.3), darkGrey);
    latch.position.set(0, 1.45, -2 + i*1.7); extGroup.add(latch);
  }
  /* Sırt antenleri */
  for (const z of [2.6, -0.8]) {
    const ant = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.42, 0.3), hullMat);
    ant.position.set(0, 1.62, z); ant.rotation.x = -0.1;
    extGroup.add(ant);
  }

  /* RCS itici blokları (burun: 4 küme) */
  for (const [rx, ryy, rz, rot] of [[-0.95,0.35,5.2,0],[0.95,0.35,5.2,0],[0,1.0,5.05,1],[0,-0.72,5.5,1]]) {
    const blk = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.24, 0.5), carbon);
    blk.position.set(rx, ryy, rz);
    extGroup.add(blk);
    for (let i=0;i<3;i++){
      const noz = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.06, 0.1, 8), darkGrey);
      if (rot === 0) { noz.rotation.z = Math.PI/2; noz.position.set(rx + Math.sign(rx)*0.22, ryy, rz - 0.15 + i*0.15); }
      else { noz.position.set(rx - 0.15 + i*0.15, ryy + (ryy>0?0.14:-0.14), rz); }
      extGroup.add(noz);
    }
  }

  /* Delta kanatlar: yuvarlatılmış kenar (bevel) */
  const wingShape = new THREE.Shape();
  wingShape.moveTo(0, 3.4); wingShape.lineTo(2.2, 1.2); wingShape.lineTo(6.4, -2.6);
  wingShape.lineTo(6.4, -3.4); wingShape.lineTo(0, -3.8); wingShape.lineTo(0, 3.4);
  const wingGeo = new THREE.ExtrudeGeometry(wingShape, { depth:0.14, bevelEnabled:true, bevelThickness:0.07, bevelSize:0.1, bevelSegments:2 });
  const wingR = new THREE.Mesh(wingGeo, hullMat);
  wingR.rotation.x = -Math.PI/2; wingR.position.set(0.9, -0.25, -0.6); wingR.castShadow = true; extGroup.add(wingR);
  const wingL = wingR.clone(); wingL.scale.x = -1; wingL.position.x = -0.9; extGroup.add(wingL);
  // Hücum kenarı karbon panelleri
  const leGeo = new THREE.BoxGeometry(5.2, 0.28, 0.5);
  const leR = new THREE.Mesh(leGeo, carbon); leR.position.set(3.6, -0.14, 1.0); leR.rotation.y = 0.75; extGroup.add(leR);
  const leL = leR.clone(); leL.position.x = -3.6; leL.rotation.y = -0.75; extGroup.add(leL);
  // Kanat alt ısı karoları
  for (const sx of [-1,1]) {
    const wt = new THREE.Mesh(new THREE.ExtrudeGeometry(wingShape, { depth:0.02, bevelEnabled:false }), tileMat);
    wt.rotation.x = -Math.PI/2; wt.position.set(sx*0.9, -0.34, -0.6);
    if (sx<0) wt.scale.x = -1;
    extGroup.add(wt);
  }

  /* Elevonlar */
  window._elevonR = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.1, 0.8), darkGrey);
  _elevonR.position.set(4.2, -0.14, -4.1); extGroup.add(_elevonR);
  window._elevonL = _elevonR.clone(); _elevonL.position.x = -4.2; extGroup.add(_elevonL);

  /* Dikey kuyruk + rudder + hız freni görünümü */
  const vShape = new THREE.Shape();
  vShape.moveTo(0,0); vShape.lineTo(-2.9,0); vShape.lineTo(-1.5,3.6); vShape.lineTo(-0.5,3.6); vShape.lineTo(0,0);
  const vGeo = new THREE.ExtrudeGeometry(vShape, { depth:0.16, bevelEnabled:true, bevelThickness:0.04, bevelSize:0.05, bevelSegments:1 });
  const vtail = new THREE.Mesh(vGeo, hullMat);
  vtail.rotation.y = Math.PI/2; vtail.position.set(0.08, 0.9, -3.6); vtail.castShadow = true; extGroup.add(vtail);
  window._rudder = new THREE.Mesh(new THREE.BoxGeometry(0.13, 2.3, 0.8), darkGrey);
  _rudder.position.set(0, 2.4, -7.0); extGroup.add(_rudder);
  // Kuyruk ucu anten + beyaz nav ışığı
  const tailTip = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.05, 0.5, 6), darkGrey);
  tailTip.position.set(0, 4.35, -5.2); extGroup.add(tailTip);

  /* Gövde flapı (motorların altı) */
  const bodyFlap = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.1, 1.1), tileMat);
  bodyFlap.position.set(0, -1.28, -6.7); bodyFlap.rotation.x = 0.1;
  extGroup.add(bodyFlap);

  /* OMS podları (kapsül biçimli) */
  for (const sx of [-1,1]) {
    const pod = new THREE.Mesh(THREE.CapsuleGeometry ? new THREE.CapsuleGeometry(0.6, 1.6, 6, 10) : new THREE.SphereGeometry(0.72, 12, 9), hullMat);
    if (!THREE.CapsuleGeometry) pod.scale.set(1, 1, 2.0);
    else pod.rotation.x = Math.PI/2;
    pod.position.set(sx*1.32, 0.98, -5.5);
    extGroup.add(pod);
    const pNoz = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.4, 0.7, 12), darkGrey);
    pNoz.rotation.x = Math.PI/2 + 0.14*sx; pNoz.position.set(sx*1.32, 1.12, -7.05); extGroup.add(pNoz);
  }

  /* 3 ana motor: lathe çanları + iç ışıma */
  const bellProf = [
    [0.20,0],[0.30,0.06],[0.26,0.22],[0.30,0.45],[0.42,0.78],[0.55,1.05],[0.64,1.28],[0.68,1.4]
  ].map(p => new THREE.Vector2(p[0], p[1]));
  const bellGeo = new THREE.LatheGeometry(bellProf, 18);
  const bellMat = new THREE.MeshStandardMaterial({ color:0x2a2c34, metalness:0.92, roughness:0.28 });
  const bellPos = [[0, 0.5],[-0.85, -0.5],[0.85, -0.5]];
  for (const [bx, by] of bellPos) {
    const bell = new THREE.Mesh(bellGeo, bellMat);
    bell.rotation.x = -Math.PI/2; bell.position.set(bx, by, -6.0);
    extGroup.add(bell);
    // Gimbal bağlantısı
    const gim = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.3, 0.3, 10), darkGrey);
    gim.rotation.x = Math.PI/2; gim.position.set(bx, by, -5.9); extGroup.add(gim);
    // İç kızarma diski
    const innerG = new THREE.Mesh(new THREE.CircleGeometry(0.28, 12),
      new THREE.MeshBasicMaterial({ color:0x2a1a4a }));
    innerG.position.set(bx, by, -7.36); innerG.rotation.y = Math.PI;
    extGroup.add(innerG);
    const glow = new THREE.Mesh(new THREE.ConeGeometry(0.48, 4.2, 12),
      new THREE.MeshBasicMaterial({ color:0x8a5aff, transparent:true, opacity:0, blending:THREE.AdditiveBlending, depthWrite:false }));
    glow.rotation.x = -Math.PI/2; glow.position.set(bx, by, -9.4);
    extGroup.add(glow);
    abGlows.push(glow);
    const eg = new THREE.Mesh(new THREE.SphereGeometry(0.42, 8, 8),
      new THREE.MeshBasicMaterial({ color:0x6ea8ff, transparent:true, opacity:0, blending:THREE.AdditiveBlending, depthWrite:false }));
    eg.position.set(bx, by, -7.35); extGroup.add(eg);
    engGlows.push(eg);
  }

  /* Dikey kalkış jetleri (VTOL alevleri, aşağı bakar) */
  window.liftGlows = [];
  for (const lx of [-1.0, 1.0]) {
    const lj = new THREE.Mesh(new THREE.ConeGeometry(0.5, 2.6, 10),
      new THREE.MeshBasicMaterial({ color:0x7ab8ff, transparent:true, opacity:0, blending:THREE.AdditiveBlending, depthWrite:false }));
    lj.position.set(lx, -2.2, 0.4);
    extGroup.add(lj);
    liftGlows.push(lj);
  }

  /* Seyrüsefer ışıkları + haleler */
  const haloT = radialTex('rgba(255,255,255,0.9)', null, 'rgba(255,255,255,0)');
  function navLight(color, x, y, z) {
    const m = new THREE.Mesh(new THREE.SphereGeometry(0.12, 6, 6), new THREE.MeshBasicMaterial({ color }));
    m.position.set(x, y, z); extGroup.add(m);
    const h = new THREE.Sprite(new THREE.SpriteMaterial({ map:haloT, color, transparent:true, opacity:0.55, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
    h.scale.set(0.9, 0.9, 1); h.position.set(x, y, z); extGroup.add(h);
    return m;
  }
  navLightL = navLight(0xff3344, -6.9, -0.1, -3.4);
  navLightR = navLight(0x33ff66, 6.9, -0.1, -3.4);
  strobe = navLight(0xffffff, 0, 4.55, -5.2);

  /* İniş takımı: çift tekerlek + destek çubukları + kapaklar */
  const strutMat = new THREE.MeshStandardMaterial({ color: 0xc8ccd4, metalness: 0.78, roughness: 0.28 });
  const pistonMat = new THREE.MeshStandardMaterial({ color: 0xe8ecf2, metalness: 0.95, roughness: 0.08 });
  const tireMat2 = new THREE.MeshStandardMaterial({ color: 0x141519, roughness: 0.88 });
  const rimMat = new THREE.MeshStandardMaterial({ color: 0xd4d9e2, metalness: 0.85, roughness: 0.22 });
  const calMat = new THREE.MeshStandardMaterial({ color: 0xc9313e, metalness: 0.4, roughness: 0.5 });
  window._gearLegs = [];
  function makeGear(x, z, Ro, twin) {
    const g = new THREE.Group();
    g.position.set(x, -0.6, z);
    const outer = new THREE.Mesh(new THREE.CylinderGeometry(0.115, 0.135, 1.05, 10), strutMat);
    outer.position.y = -0.50; g.add(outer);
    const brace = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 1.7, 6), strutMat);
    brace.position.set(0, -0.85, 0.62); brace.rotation.x = 0.9; g.add(brace);
    const door = new THREE.Mesh(new THREE.BoxGeometry(0.1, 1.9, 0.8), tileMat);
    door.position.set(twin ? 0.6 : 0.45, -0.95, 0); door.rotation.z = -0.5;
    g.add(door);
    // Amortisör (sıkışan alt grup)
    const shock = new THREE.Group();
    shock.position.y = -1.05;
    shock.userData.y0 = -1.05;
    const wl = Ro - 1.45;   // tekerlek merkezi: taban tam -3.1'e değer
    const piston = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 1.0, 10), pistonMat);
    piston.position.y = -0.5; shock.add(piston);
    const axle = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, twin ? 0.68 : 0.3, 8), strutMat);
    axle.rotation.z = Math.PI/2; axle.position.y = wl; shock.add(axle);
    const Rt = Ro - 0.15;
    const offs = twin ? [-0.27, 0.27] : [0];
    for (const ox of offs) {
      const wheel = new THREE.Group();
      wheel.position.set(ox, wl, 0);
      const tire = new THREE.Mesh(new THREE.TorusGeometry(Rt, 0.15, 12, 24), tireMat2);
      tire.rotation.y = Math.PI/2; wheel.add(tire);
      const rim = new THREE.Mesh(new THREE.CylinderGeometry(Rt - 0.02, Rt - 0.02, 0.15, 16), rimMat);
      rim.rotation.z = Math.PI/2; wheel.add(rim);
      for (let sp2 = 0; sp2 < 5; sp2++) {
        const spoke = new THREE.Mesh(new THREE.BoxGeometry(0.05, (Rt - 0.05) * 2, 0.045),
          new THREE.MeshStandardMaterial({ color: 0x2a2d36, metalness: 0.6, roughness: 0.4 }));
        spoke.rotation.x = sp2 * Math.PI / 5;
        wheel.add(spoke);
      }
      const hubGlow = new THREE.Mesh(new THREE.TorusGeometry(0.085, 0.02, 6, 18),
        new THREE.MeshBasicMaterial({ color: 0x33d5ff }));
      hubGlow.rotation.y = Math.PI/2; wheel.add(hubGlow);
      const cal = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.16, 0.22), calMat);
      cal.position.set(ox + (ox >= 0 ? 0.1 : -0.1), wl + Rt * 0.55, 0.1);
      shock.add(cal);
      shock.add(wheel);
    }
    g.add(shock);
    _gearLegs.push(shock);
    return g;
  }
  gearGroup.add(makeGear(0, 5.2, 0.42, true), makeGear(-2.1, -1.8, 0.5, true), makeGear(2.1, -1.8, 0.5, true));
  extGroup.add(gearGroup);
}
plane.add(extGroup);
scene.add(plane);

/* İniş farı */
const landLight = new THREE.SpotLight(0xe8f0ff, 0, 1100, 0.42, 0.55, 1.1);
landLight.position.set(0, -1.0, 6.5);
plane.add(landLight);
landLight.target.position.set(0, -16, 260);
plane.add(landLight.target);
window._landLight = landLight;

/* ---------------- ÖZEL GÖVDE: rocket_ship.glb (gömülü) ---------------- */
const GLB_B64 = "";
function computeShipOrientation(root) {
  root.updateMatrixWorld(true);
  // Vertexleri örnekle (dünya uzayında)
  const pts = [];
  const v = new THREE.Vector3();
  root.traverse(o => {
    if (o.isMesh && o.geometry && o.geometry.attributes.position) {
      const a = o.geometry.attributes.position;
      const step = Math.max(1, Math.floor(a.count / 5000));
      for (let i = 0; i < a.count; i += step) {
        v.fromBufferAttribute(a, i).applyMatrix4(o.matrixWorld);
        pts.push(v.x, v.y, v.z);
      }
    }
  });
  const n = pts.length / 3;
  if (n < 30) return new THREE.Quaternion();
  let cx=0, cy=0, cz=0;
  for (let i=0;i<n;i++){ cx+=pts[3*i]; cy+=pts[3*i+1]; cz+=pts[3*i+2]; }
  cx/=n; cy/=n; cz/=n;
  let xx=0,xy=0,xz=0,yy=0,yz=0,zz=0;
  for (let i=0;i<n;i++){
    const x=pts[3*i]-cx, y=pts[3*i+1]-cy, z=pts[3*i+2]-cz;
    xx+=x*x; xy+=x*y; xz+=x*z; yy+=y*y; yz+=y*z; zz+=z*z;
  }
  const C = [[xx,xy,xz],[xy,yy,yz],[xz,yz,zz]];
  const mul = M => vv => [M[0][0]*vv[0]+M[0][1]*vv[1]+M[0][2]*vv[2], M[1][0]*vv[0]+M[1][1]*vv[1]+M[1][2]*vv[2], M[2][0]*vv[0]+M[2][1]*vv[1]+M[2][2]*vv[2]];
  const nrm = vv => { const l=Math.hypot(vv[0],vv[1],vv[2])||1; return [vv[0]/l, vv[1]/l, vv[2]/l]; };
  const dot3 = (a,b) => a[0]*b[0]+a[1]*b[1]+a[2]*b[2];
  const cr = (a,b) => [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]];
  function power(M) {
    let vv = [0.7, 0.5, 0.51];
    const f = mul(M);
    for (let i=0;i<50;i++) vv = nrm(f(vv));
    return vv;
  }
  const a0 = power(C);
  const lam0 = dot3(mul(C)(a0), a0);
  const C1 = C.map((row,i) => row.map((val,j) => val - lam0*a0[i]*a0[j]));
  let a1 = power(C1);
  a1 = nrm([a1[0]-dot3(a1,a0)*a0[0], a1[1]-dot3(a1,a0)*a0[1], a1[2]-dot3(a1,a0)*a0[2]]);
  const a2 = nrm(cr(a0, a1));
  // Uç dilim yarıçapları → hangi ana eksen gövde ekseni, hangi uç burun?
  function endRadii(ax) {
    let tmin=1e18, tmax=-1e18;
    for (let i=0;i<n;i++){
      const t = (pts[3*i]-cx)*ax[0] + (pts[3*i+1]-cy)*ax[1] + (pts[3*i+2]-cz)*ax[2];
      if (t<tmin) tmin=t; if (t>tmax) tmax=t;
    }
    const sl = (tmax-tmin)*0.12;
    let rl=0, nl=0, rh=0, nh=0;
    for (let i=0;i<n;i++){
      const px2=pts[3*i]-cx, py2=pts[3*i+1]-cy, pz2=pts[3*i+2]-cz;
      const t = px2*ax[0]+py2*ax[1]+pz2*ax[2];
      const rx2=px2-t*ax[0], ry2=py2-t*ax[1], rz2=pz2-t*ax[2];
      const r = Math.hypot(rx2, ry2, rz2);
      if (t < tmin+sl) { rl+=r; nl++; }
      else if (t > tmax-sl) { rh+=r; nh++; }
    }
    return { rl: rl/Math.max(1,nl), rh: rh/Math.max(1,nh) };
  }
  const e0 = endRadii(a0), e1 = endRadii(a1);
  const ratio0 = Math.max(e0.rl,e0.rh)/Math.max(1e-9,Math.min(e0.rl,e0.rh));
  const ratio1 = Math.max(e1.rl,e1.rh)/Math.max(1e-9,Math.min(e1.rl,e1.rh));
  let fwd, spanAx;
  if (ratio0 >= ratio1) { fwd = e0.rh < e0.rl ? a0 : [-a0[0],-a0[1],-a0[2]]; spanAx = a1; }
  else { fwd = e1.rh < e1.rl ? a1 : [-a1[0],-a1[1],-a1[2]]; spanAx = a0; }
  // Üst: en ince eksen; işareti uç uzanımdan (kokpit/kuyruk üstte daha uzun uzanır)
  let up = a2.slice();
  let umin=1e18, umax=-1e18;
  for (let i=0;i<n;i++){
    const t = (pts[3*i]-cx)*up[0] + (pts[3*i+1]-cy)*up[1] + (pts[3*i+2]-cz)*up[2];
    if (t<umin) umin=t; if (t>umax) umax=t;
  }
  if (Math.abs(umin) > Math.abs(umax)) up = [-up[0],-up[1],-up[2]];
  // Ortonormal sağ el sistemi: right = up × fwd, up = fwd × right
  let right = nrm(cr(up, fwd));
  up = nrm(cr(fwd, right));
  // Satırları [right, up, fwd] olan rotasyon → quaternion
  const m = new THREE.Matrix4();
  m.set(right[0], right[1], right[2], 0,
        up[0],    up[1],    up[2],    0,
        fwd[0],   fwd[1],   fwd[2],   0,
        0, 0, 0, 1);
  const q = new THREE.Quaternion().setFromRotationMatrix(m);
  console.log('Oto-yönelim | burun:', fwd.map(x=>x.toFixed(2)), 'üst:', up.map(x=>x.toFixed(2)));
  return q;
}
function applyRocketModel(gltf) {
  const inner = new THREE.Group();
  inner.add(gltf.scene);
  // OTOMATİK YÖNELİM: modelin ana eksenlerini çalışma anında ölç (PCA),
  // burnu +Z'ye, üstü +Y'ye çevir — hangi model / hangi poz olursa olsun.
  inner.quaternion.copy(computeShipOrientation(gltf.scene));
  const holder = new THREE.Group();
  holder.add(inner);
  let box = new THREE.Box3().setFromObject(holder);
  const size = box.getSize(new THREE.Vector3());
  const sl = 17 / Math.max(0.001, size.z);
  holder.scale.set(sl, sl, sl);   // fighter oranları zaten uygun — tekdüze ölçek
  box = new THREE.Box3().setFromObject(holder);
  const ctr = box.getCenter(new THREE.Vector3());
  // Yatay merkezle, tabanı tekerlek hizasının hemen üstüne oturt
  holder.position.x -= ctr.x;
  holder.position.z -= ctr.z;
  holder.position.y -= (box.min.y + 2.05);
  // Malzeme düzeltmeleri: delik görünen ters yüzeyler, parlaklık, normal map
  gltf.scene.traverse(o => {
    if (o.isMesh && o.material) {
      o.castShadow = true;
      const m = o.material;
      m.side = THREE.DoubleSide;          // ters bakan face'ler = delik hatası düzeltildi
      m.transparent = false;
      m.depthWrite = true;
      m.alphaTest = 0;
      if (m.metalness !== undefined) m.metalness = Math.min(0.65, m.metalness);
      if (m.roughness !== undefined) m.roughness = Math.max(0.38, m.roughness);
      if (m.normalMap && m.normalScale) m.normalScale.set(0.55, 0.55);  // küçültülmüş normal map lekelenmesin
      if (m.map) m.map.anisotropy = 8;
      if (m.emissiveMap) { m.emissive = new THREE.Color(0xffffff); m.emissiveIntensity = 1.4; }
      m.needsUpdate = true;
    }
  });
  // Prosedürel mekik gövdesini gizle (takım + ışık + alevler kalır)
  const keep = new Set([gearGroup, strobe, navLightL, navLightR]);
  for (const g of abGlows) keep.add(g);
  for (const g of engGlows) keep.add(g);
  for (const g of (window.liftGlows||[])) { keep.add(g); }
  if (window.liftGlows) { liftGlows[0].position.set(-1.35, -2.1, 0.35); liftGlows[1].position.set(1.35, -2.1, 0.35); }
  for (const ch of extGroup.children) if (!keep.has(ch)) ch.visible = false;
  extGroup.add(holder);
  // Işık ve alev konumlarını rokete göre ayarla
  // İniş takımını fighter gövdesine hizala
  if (gearGroup.children.length === 3) {
    gearGroup.children[0].position.set(0, -0.6, 5.6);       // burun takımı
    gearGroup.children[1].position.set(-2.25, -0.6, -1.9);  // sol ana
    gearGroup.children[2].position.set(2.25, -0.6, -1.9);   // sağ ana
  }
  // Egzoz konumları geometriden ölçüldü: merkez + ±1.35 m yan motorlar, kuyruk z=-7.0
  const engX = [-1.64, 0, 1.64];
  navLightL.position.set(-5.65, 0.12, -3.95);
  navLightR.position.set(5.65, 0.12, -3.95);
  strobe.position.set(0, 1.8, -3.9);
  abGlows.forEach((g, i) => { g.position.set(engX[i], 0.05, -10.4); g.userData.mul = 1.7; });
  engGlows.forEach((g, i) => { g.position.set(engX[i], 0.05, -8.6); g.userData.mul = 1.5; });
  window._rocketLoaded = true;
  console.log('Gövde yüklendi | boyutlar (m):', size.x.toFixed(1), size.y.toFixed(1), size.z.toFixed(1));
  try { flash('✦ ÖZEL GÖVDE YÜKLENDİ: NOVA FIGHTER'); } catch(e) {}
}
(function loadRocket(){
  if (!THREE.GLTFLoader) { console.warn('GLTFLoader yok — prosedürel gövde kullanılıyor'); return; }
  try {
    const bin = atob(GLB_B64);
    const buf = new Uint8Array(bin.length);
    for (let i=0;i<bin.length;i++) buf[i] = bin.charCodeAt(i);
    const _cib = window.createImageBitmap;
    try { window.createImageBitmap = undefined; } catch(e) {}
    const _restore = () => { try { window.createImageBitmap = _cib; } catch(e) {} };
    new THREE.GLTFLoader().parse(buf.buffer, '',
      g => { _restore(); applyRocketModel(g); },
      err => { _restore(); console.warn('GLB yüklenemedi, prosedürel gövde kaldı:', err); });
  } catch(e) { console.warn('GLB çözülemedi:', e); }
})();

/* ---------------- KOKPİT İÇİ (detaylı savaş uçağı) ---------------- */
const cockpit = new THREE.Group();
cockpit.visible = false;
plane.add(cockpit);

function makeMfd() {
  const cv = document.createElement('canvas'); cv.width = 256; cv.height = 256;
  const tex = new THREE.CanvasTexture(cv);
  tex.anisotropy = 4;
  return { cv, ctx: cv.getContext('2d'), tex };
}
const mfdAdi = makeMfd(), mfdEng = makeMfd(), mfdNav = makeMfd();

/* Panel dokusu: fırçalanmış metal + vida başları + bölme çizgileri */
function makePanelTex(w, h, labels) {
  const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
  const c = cv.getContext('2d');
  c.fillStyle = '#14161d'; c.fillRect(0, 0, w, h);
  for (let i = 0; i < w * h / 90; i++) {
    c.fillStyle = 'rgba(255,255,255,' + (Math.random() * 0.03).toFixed(3) + ')';
    c.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 14, 1);
  }
  c.strokeStyle = 'rgba(70,80,100,0.35)'; c.lineWidth = 1;
  for (let x = 0; x < w; x += 64) { c.beginPath(); c.moveTo(x, 0); c.lineTo(x, h); c.stroke(); }
  for (let y = 0; y < h; y += 52) { c.beginPath(); c.moveTo(0, y); c.lineTo(w, y); c.stroke(); }
  c.fillStyle = 'rgba(120,130,150,0.55)';
  for (const [sx, sy] of [[6,6],[w-8,6],[6,h-8],[w-8,h-8]]) {
    c.beginPath(); c.arc(sx, sy, 2.4, 0, Math.PI*2); c.fill();
    c.strokeStyle = 'rgba(20,22,30,0.9)';
    c.beginPath(); c.moveTo(sx-2, sy); c.lineTo(sx+2, sy); c.stroke();
  }
  if (labels) {
    c.fillStyle = '#5a7a9a'; c.font = '11px Consolas, monospace';
    for (const [lx, ly, txt] of labels) c.fillText(txt, lx, ly);
  }
  const t = new THREE.CanvasTexture(cv);
  t.anisotropy = 4;
  return t;
}
function makePlacard(text, fg, bg, w, h) {
  const cv = document.createElement('canvas'); cv.width = w||128; cv.height = h||40;
  const c = cv.getContext('2d');
  c.fillStyle = bg || '#0c0e14'; c.fillRect(0,0,cv.width,cv.height);
  c.strokeStyle = fg; c.lineWidth = 2; c.strokeRect(2,2,cv.width-4,cv.height-4);
  c.fillStyle = fg; c.font = 'bold 17px Consolas, monospace'; c.textAlign='center'; c.textBaseline='middle';
  c.fillText(text, cv.width/2, cv.height/2+1);
  return new THREE.CanvasTexture(cv);
}

let throttleLever, ctrlStick;
{
  const panelMat = new THREE.MeshStandardMaterial({ map: makePanelTex(256, 256), metalness: 0.35, roughness: 0.7 });
  const panelMat2 = new THREE.MeshStandardMaterial({ map: makePanelTex(256, 128, [[10,20,'ENV'],[70,20,'ECS'],[130,20,'PWR'],[190,20,'COM']]), metalness: 0.35, roughness: 0.7 });
  const frameMat = new THREE.MeshStandardMaterial({ color: 0x2c2f3a, metalness: 0.55, roughness: 0.55 });
  const trimMat  = new THREE.MeshStandardMaterial({ color: 0x0b0d12, roughness: 0.9 });
