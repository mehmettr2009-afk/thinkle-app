  cockpit.add(dialStrip);
  window._dials = [];
  const DIAL_DEFS = [
    { label:'HIZ',    unit:'kt',    min:0,     max:700,   redHi:0.83, redLo:0 },
    { label:'İRTİFA', unit:'ft',    min:0,     max:60000, redHi:0,    redLo:0 },
    { label:'V/S',    unit:'ft/dk', min:-6000, max:6000,  redHi:0.9,  redLo:0.1 },
    { label:'GÜÇ',    unit:'%',     min:0,     max:110,   redHi:0.87, redLo:0 },
    { label:'YAKIT',  unit:'%',     min:0,     max:100,   redHi:0,    redLo:0.15 },
    { label:'G',      unit:'g',     min:-3,    max:11,    redHi:0.79, redLo:0.1 },
    { label:'ISI',    unit:'%',     min:0,     max:100,   redHi:0.62, redLo:0 }
  ];
  for (let i = 0; i < DIAL_DEFS.length; i++) {
    const cv = document.createElement('canvas'); cv.width = cv.height = 128;
    const tex = new THREE.CanvasTexture(cv);
    const mesh = new THREE.Mesh(new THREE.CircleGeometry(0.088, 26),
      new THREE.MeshBasicMaterial({ map: tex, side: THREE.DoubleSide }));
    const x = -1.10 + i * 0.367;
    mesh.position.set(x, 0.245, 4.145); mesh.rotation.x = 0.38; mesh.rotation.y = Math.PI;
    cockpit.add(mesh);
    const rim = new THREE.Mesh(new THREE.TorusGeometry(0.091, 0.011, 8, 26), frameMat);
    rim.position.set(x, 0.245, 4.15); rim.rotation.x = 0.38;
    cockpit.add(rim);
    _dials.push({ cv, tex, def: DIAL_DEFS[i] });
  }

  /* --- Annunciator --- */
  window._annCv = document.createElement('canvas'); _annCv.width = 256; _annCv.height = 96;
  window._annTex = new THREE.CanvasTexture(_annCv);
  const ann = new THREE.Mesh(new THREE.PlaneGeometry(0.52, 0.19),
    new THREE.MeshBasicMaterial({ map: _annTex, side: THREE.DoubleSide }));
  ann.position.set(0, 0.845, 3.99); ann.rotation.x = 0.30; ann.rotation.y = Math.PI;
  cockpit.add(ann);

  /* --- Yan konsollar (iki katlı, etiketli) --- */
  for (const sx of [-1, 1]) {
    const lower = new THREE.Mesh(new THREE.BoxGeometry(0.56, 0.30, 1.75), panelMat);
    lower.position.set(sx * 1.08, 0.35, 3.22); lower.rotation.z = -sx * 0.12;
    cockpit.add(lower);
    const topTex = makePanelTex(256, 128, sx < 0
      ? [[12,22,'THR'],[64,22,'FLP'],[120,22,'TRIM'],[186,22,'APU'],[12,86,'FUEL'],[80,86,'HYD'],[150,86,'ELEC']]
      : [[12,22,'COM1'],[80,22,'COM2'],[150,22,'NAV'],[210,22,'XPDR'],[12,86,'IFF'],[70,86,'DATA'],[140,86,'ECM']]);
    const top = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 1.6),
      new THREE.MeshStandardMaterial({ map: topTex, metalness: 0.35, roughness: 0.7 }));
    top.position.set(sx * 1.065, 0.505, 3.22);
    top.rotation.x = -Math.PI / 2; top.rotation.z = sx < 0 ? Math.PI/2 : -Math.PI/2;
    top.rotation.y = -sx * 0.12;
    cockpit.add(top);
    // Döner düğmeler
    for (let k = 0; k < 4; k++) {
      const kn = new THREE.Mesh(new THREE.CylinderGeometry(0.028, 0.032, 0.035, 10), metalKnob);
      kn.position.set(sx * (1.05 - 0.02), 0.53, 2.62 + k * 0.34);
      kn.rotation.z = -sx * 0.12;
      cockpit.add(kn);
      const mark = new THREE.Mesh(new THREE.BoxGeometry(0.006, 0.012, 0.03), trimMat);
      mark.position.copy(kn.position); mark.position.y += 0.022;
      mark.rotation.y = Math.random() * Math.PI;
      cockpit.add(mark);
    }
    // Toggle sıraları
    for (let k = 0; k < 6; k++) {
      const sw = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.05, 6), metalKnob);
      sw.position.set(sx * 1.16, 0.525, 2.55 + k * 0.24);
      sw.rotation.x = (k % 2 ? 0.5 : -0.5); sw.rotation.z = -sx * 0.12;
      cockpit.add(sw);
    }
  }

  /* --- Gaz kolu (sol konsol, sürtünme kolu ile) --- */
  const thrRail = new THREE.Mesh(new THREE.BoxGeometry(0.10, 0.03, 0.62), trimMat);
  thrRail.position.set(-0.98, 0.545, 3.30); thrRail.rotation.z = 0.12;
  cockpit.add(thrRail);
  throttleLever = new THREE.Group();
  const tArm = new THREE.Mesh(new THREE.BoxGeometry(0.045, 0.30, 0.05), frameMat);
  tArm.position.y = 0.15; throttleLever.add(tArm);
  const tKnob = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.10, 0.19),
    new THREE.MeshStandardMaterial({ color: 0x8a5aff, metalness: 0.4, roughness: 0.4 }));
  tKnob.position.y = 0.335; throttleLever.add(tKnob);
  const tGrip = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.15, 8), softMat);
  tGrip.rotation.z = Math.PI/2; tGrip.position.set(0, 0.335, 0.10);
  throttleLever.add(tGrip);
  /* Sol el + ön kol (gaz koluyla birlikte hareket eder) */
  const suitMatL = new THREE.MeshStandardMaterial({ color: 0x39402f, roughness: 0.92 });
  const gloveMatL = new THREE.MeshStandardMaterial({ color: 0x23262c, roughness: 0.85 });
  const handL = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.075, 0.10), gloveMatL);
  handL.position.set(0.01, 0.395, 0.0);
  throttleLever.add(handL);
  const thumbL = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.05, 0.02), gloveMatL);
  thumbL.position.set(0.075, 0.36, 0.05); thumbL.rotation.z = 0.5;
  throttleLever.add(thumbL);
  const foreL = new THREE.Mesh(new THREE.CylinderGeometry(0.036, 0.046, 0.38, 8), suitMatL);
  foreL.position.set(0.12, 0.24, -0.22); foreL.rotation.x = 0.85; foreL.rotation.z = -0.4;
  throttleLever.add(foreL);
  throttleLever.position.set(-0.98, 0.56, 3.30);
  throttleLever.rotation.z = 0.12;
  cockpit.add(throttleLever);
  /* Sol üst kol */
  const upperL = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.055, 0.40, 8), suitMatL);
  upperL.position.set(-0.52, 0.58, 2.68); upperL.rotation.x = 1.05; upperL.rotation.z = 0.55;
  cockpit.add(upperL);
  const fricLever = new THREE.Mesh(new THREE.BoxGeometry(0.025, 0.14, 0.03), metalKnob);
  fricLever.position.set(-0.90, 0.62, 3.06); fricLever.rotation.x = -0.5; fricLever.rotation.z = 0.12;
  cockpit.add(fricLever);

  /* --- İniş takımı kolu (kırmızı tekerlek başlı) --- */
  window._gearHandle = new THREE.Group();
  const ghArm = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, 0.16, 8), metalKnob);
  ghArm.position.y = 0.08; _gearHandle.add(ghArm);
  const ghWheel = new THREE.Mesh(new THREE.TorusGeometry(0.032, 0.013, 8, 14),
    new THREE.MeshStandardMaterial({ color: 0xc03040, roughness: 0.5 }));
  ghWheel.position.y = 0.17; _gearHandle.add(ghWheel);
  _gearHandle.position.set(-1.28, 0.62, 3.86);
  _gearHandle.rotation.x = -0.2;
  cockpit.add(_gearHandle);
  const ghPlac = new THREE.Mesh(new THREE.PlaneGeometry(0.14, 0.045),
    new THREE.MeshBasicMaterial({ map: makePlacard('LDG GEAR', '#9fb8d0'), transparent: true }));
  ghPlac.position.set(-1.28, 0.50, 3.90); ghPlac.rotation.x = 0.38; ghPlac.rotation.y = Math.PI;
  cockpit.add(ghPlac);

  /* --- Orta pedestal + görev ekranı + kontroller --- */
  const pedestal = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.52, 1.25), panelMat);
  pedestal.position.set(0, 0.16, 3.38); cockpit.add(pedestal);
  window._pedCv = document.createElement('canvas'); _pedCv.width = 192; _pedCv.height = 128;
  window._pedTex = new THREE.CanvasTexture(_pedCv);
  const pedScr = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.22),
    new THREE.MeshBasicMaterial({ map: _pedTex, side: THREE.DoubleSide }));
  pedScr.position.set(0, 0.475, 3.70); pedScr.rotation.x = -1.05 + Math.PI; pedScr.scale.y = -1;
  cockpit.add(pedScr);
  const pedBez = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.02, 0.28), trimMat);
  pedBez.position.set(0, 0.465, 3.70); pedBez.rotation.x = -0.10;
  cockpit.add(pedBez);
  for (let r = 0; r < 2; r++) for (let k = 0; k < 3; k++) {
    const kn = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.028, 0.03, 10), metalKnob);
    kn.position.set(-0.13 + k * 0.13, 0.435, 3.30 - r * 0.18);
    cockpit.add(kn);
  }
  for (const sx of [-0.12, 0.12]) {
    const th = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.09, 0.026),
      new THREE.MeshStandardMaterial({ color: 0xc8a020, metalness: 0.5, roughness: 0.5 }));
    th.position.set(sx, 0.45, 2.95);
    cockpit.add(th);
  }

  /* --- Kumanda kolu: körük + tetikli grip --- */
  ctrlStick = new THREE.Group();
  const boot = new THREE.Mesh(new THREE.ConeGeometry(0.085, 0.13, 10), softMat);
  boot.position.y = 0.055; ctrlStick.add(boot);
  const sArm = new THREE.Mesh(new THREE.CylinderGeometry(0.026, 0.034, 0.34, 8), frameMat);
  sArm.position.y = 0.24; ctrlStick.add(sArm);
  const sGrip = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.042, 0.19, 10), softMat);
  sGrip.position.y = 0.47; sGrip.rotation.x = -0.22; ctrlStick.add(sGrip);
  const trig = new THREE.Mesh(new THREE.BoxGeometry(0.022, 0.05, 0.02), metalKnob);
  trig.position.set(0, 0.44, 0.055); trig.rotation.x = -0.5; ctrlStick.add(trig);
  const hat = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.015, 0.02, 8),
    new THREE.MeshStandardMaterial({ color: 0x3a3d46, roughness: 0.6 }));
  hat.position.set(-0.028, 0.55, 0.015); ctrlStick.add(hat);
  const sBtn = new THREE.Mesh(new THREE.SphereGeometry(0.014, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0xff4455 }));
  sBtn.position.set(0.02, 0.555, 0.02); ctrlStick.add(sBtn);
  /* Sağ el + ön kol (kumandayla birlikte hareket eder) */
  const suitMat = new THREE.MeshStandardMaterial({ color: 0x39402f, roughness: 0.92 });
  const gloveMat = new THREE.MeshStandardMaterial({ color: 0x23262c, roughness: 0.85 });
  const handR = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.13, 0.085), gloveMat);
  handR.position.set(0, 0.455, -0.015); handR.rotation.x = -0.2;
  ctrlStick.add(handR);
  for (let fi = 0; fi < 3; fi++) {
    const fing = new THREE.Mesh(new THREE.BoxGeometry(0.018, 0.05, 0.02), gloveMat);
    fing.position.set(-0.022 + fi * 0.024, 0.50, 0.035); fing.rotation.x = -0.7;
    ctrlStick.add(fing);
  }
  const foreR = new THREE.Mesh(new THREE.CylinderGeometry(0.038, 0.048, 0.40, 8), suitMat);
  foreR.position.set(0.10, 0.30, -0.24); foreR.rotation.x = 0.95; foreR.rotation.z = -0.32;
  ctrlStick.add(foreR);
  ctrlStick.position.set(0, 0.43, 3.06);
  cockpit.add(ctrlStick);
  /* Sağ üst kol (kolçuktan dirseğe, sabit) */
  const upperR = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.055, 0.42, 8), suitMat);
  upperR.position.set(0.34, 0.55, 2.62); upperR.rotation.x = 1.15; upperR.rotation.z = -0.5;
  cockpit.add(upperR);

  /* Bacaklar (pedallara uzanan uyluk+baldır görünümü) */
  for (const sx of [-0.17, 0.17]) {
    const thigh = new THREE.Mesh(new THREE.CylinderGeometry(0.075, 0.065, 0.55, 8),
      new THREE.MeshStandardMaterial({ color: 0x39402f, roughness: 0.92 }));
    thigh.position.set(sx, 0.30, 2.85); thigh.rotation.x = Math.PI/2 - 0.28;
    cockpit.add(thigh);
    const shin = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.058, 0.5, 8),
      new THREE.MeshStandardMaterial({ color: 0x39402f, roughness: 0.92 }));
    shin.position.set(sx, 0.22, 3.55); shin.rotation.x = 0.5;
    cockpit.add(shin);
  }

  /* --- Rudder pedalları (yaw ile hareket eder) --- */
  for (const [nm, sx] of [['_pedalL', -0.16], ['_pedalR', 0.16]]) {
    const pg = new THREE.Group();
    const plate = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.23, 0.03), frameMat);
    plate.rotation.x = 0.55; pg.add(plate);
    const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, 0.3, 6), metalKnob);
    arm.position.set(0, -0.06, -0.15); arm.rotation.x = Math.PI/2 - 0.2; pg.add(arm);
    pg.position.set(sx, 0.13, 4.02);
    pg.userData.z0 = 4.02;
    cockpit.add(pg);
    window[nm] = pg;
  }

  /* --- Çerçeve: pervazlar, A-sütunları, kanopi rayları --- */
  /* --- TEK PARÇA KANOPİ ÇERÇEVESİ: cam küresine oturan kemerler + raylar --- */
  const CANC = new THREE.Vector3(0, 0.55, 3.15), CANR = 1.9;
  function addHoop(dz, tube, arc) {
    const r = Math.sqrt(Math.max(0.05, CANR*CANR - dz*dz));
    const hoop = new THREE.Mesh(new THREE.TorusGeometry(r, tube, 8, 42, arc), frameMat);
    hoop.position.set(0, CANC.y, CANC.z + dz);
    hoop.rotation.z = Math.PI/2 - arc/2;
    cockpit.add(hoop);
    return { r, arc };
  }
  function addRail(x0,y0,z0, x1,y1,z1, rr) {
    const a2 = new THREE.Vector3(x0,y0,z0), b2 = new THREE.Vector3(x1,y1,z1);
    const len = a2.distanceTo(b2);
    const rail = new THREE.Mesh(new THREE.CylinderGeometry(rr, rr, len, 8), frameMat);
    rail.position.copy(a2).add(b2).multiplyScalar(0.5);
    rail.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), b2.clone().sub(a2).normalize());
    cockpit.add(rail);
  }
  const hF = addHoop(1.28, 0.045, 2.30);   // ön kemer
  const hM = addHoop(0.45, 0.04, 2.50);    // orta kemer
  const hR = addHoop(-0.55, 0.05, 2.60);   // arka kemer
  function hoopEnd(h, dz, sgn) {           // kemer ucunun konumu
    const half = h.arc / 2;
    return [sgn * h.r * Math.sin(half), CANC.y + h.r * Math.cos(half), CANC.z + dz];
  }
  // Tepe omurgası: ön → orta → arka
  addRail(0, CANC.y + Math.sqrt(CANR*CANR - 1.28*1.28), CANC.z + 1.28,
          0, CANC.y + Math.sqrt(CANR*CANR - 0.45*0.45), CANC.z + 0.45, 0.04);
  addRail(0, CANC.y + Math.sqrt(CANR*CANR - 0.45*0.45), CANC.z + 0.45,
          0, CANC.y + Math.sqrt(CANR*CANR - 0.55*0.55), CANC.z - 0.55, 0.04);
  // Yan raylar: kemer uçlarını birbirine bağlar (bütünleşik görünüm)
  for (const sgn of [-1, 1]) {
    const eF = hoopEnd(hF, 1.28, sgn), eM = hoopEnd(hM, 0.45, sgn), eR = hoopEnd(hR, -0.55, sgn);
    addRail(eF[0], eF[1], eF[2], eM[0], eM[1], eM[2], 0.045);
    addRail(eM[0], eM[1], eM[2], eR[0], eR[1], eR[2], 0.045);
  }
  // Sürekli pervaz halkası (kokpiti saran taban çemberi)
  const sillRing = new THREE.Mesh(new THREE.TorusGeometry(1.89, 0.055, 8, 46, 3.5), frameMat);
  sillRing.position.set(0, 0.70, CANC.z);
  sillRing.rotation.x = Math.PI / 2;
  sillRing.rotation.z = Math.PI/2 - 3.5/2;
  cockpit.add(sillRing);

  /* --- Tavan: anahtar bankları + korumalı anahtarlar + dom lamba --- */
  const roof = new THREE.Mesh(new THREE.BoxGeometry(2.3, 0.08, 1.0), panelMat2);
  roof.position.set(0, 2.03, 3.12); roof.rotation.x = -0.10; cockpit.add(roof);
  for (let i = 0; i < 8; i++) {
    const sw = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.05, 6), metalKnob);
    sw.position.set(-0.7 + i * 0.2, 1.975, 3.34); sw.rotation.x = (i % 3 ? 0.5 : -0.5) - 0.10;
    cockpit.add(sw);
  }
  for (const gx of [-0.45, 0.45]) {
    const guard = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.03, 0.07),
      new THREE.MeshStandardMaterial({ color: 0xc03040, roughness: 0.5 }));
    guard.position.set(gx, 1.985, 3.02); guard.rotation.x = -0.65;
    cockpit.add(guard);
  }
  const dome = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.06, 0.02, 12),
    new THREE.MeshBasicMaterial({ color: 0x4a5a77 }));
  dome.position.set(0.5, 1.985, 3.25); cockpit.add(dome);
  window._cabinWarn = new THREE.Mesh(new THREE.SphereGeometry(0.03, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0x331111 }));
  _cabinWarn.position.set(0, 1.955, 3.0); cockpit.add(_cabinWarn);

  /* --- Holografik navigasyon küresi (pedestal üstünde döner) --- */
  window._holo = new THREE.Group();
  const holoCore = new THREE.Mesh(new THREE.IcosahedronGeometry(0.055, 1),
    new THREE.MeshBasicMaterial({ color: 0x33d5ff, wireframe: true, transparent: true, opacity: 0.75 }));
  _holo.add(holoCore);
  const holoRing = new THREE.Mesh(new THREE.TorusGeometry(0.085, 0.004, 6, 28),
    new THREE.MeshBasicMaterial({ color: 0x33d5ff, transparent: true, opacity: 0.5 }));
  holoRing.rotation.x = Math.PI / 2.4;
  _holo.add(holoRing);
  const holoBase = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.06, 0.02, 12),
    new THREE.MeshStandardMaterial({ color: 0x1a1e28, metalness: 0.6, roughness: 0.4 }));
  holoBase.position.y = -0.10; _holo.add(holoBase);
  const holoBeam = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.12, 12, 1, true),
    new THREE.MeshBasicMaterial({ color: 0x33d5ff, transparent: true, opacity: 0.10, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide }));
  holoBeam.position.y = -0.045; _holo.add(holoBeam);
  _holo.position.set(0, 0.56, 3.12);
  cockpit.add(_holo);

  /* --- Yan kanat panellerinde akan veri ekranları --- */
  window._techScr = [];
  for (const sx of [-1, 1]) {
    const tcv2 = document.createElement('canvas'); tcv2.width = 128; tcv2.height = 160;
    const ttex = new THREE.CanvasTexture(tcv2);
    const tscr = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.42),
      new THREE.MeshBasicMaterial({ map: ttex, side: THREE.DoubleSide }));
    tscr.position.set(sx * 1.30, 0.50, 3.88);
    tscr.rotation.x = 0.38; tscr.rotation.y = Math.PI - sx * 0.42;
    cockpit.add(tscr);
    _techScr.push({ cv: tcv2, tex: ttex, side: sx, lines: [] });
  }

  /* --- Duruma göre renk değiştiren neon şeritler --- */
  window._backlights = [backlight, backlight2, combGlow];

  /* --- Plakalar --- */
  const eject = new THREE.Mesh(new THREE.PlaneGeometry(0.16, 0.05),
    new THREE.MeshBasicMaterial({ map: makePlacard('EJECT', '#ffcf5c', '#3a2408'), transparent: true }));
  eject.position.set(-1.30, 0.98, 3.35); eject.rotation.y = Math.PI/2 - 0.16; cockpit.add(eject);
  const arm2 = new THREE.Mesh(new THREE.PlaneGeometry(0.17, 0.05),
    new THREE.MeshBasicMaterial({ map: makePlacard('MASTER ARM', '#e05060'), transparent: true }));
  arm2.position.set(1.30, 0.62, 3.90); arm2.rotation.x = 0.38; arm2.rotation.y = Math.PI + 0.42;
  cockpit.add(arm2);

  /* --- Koltuk kolçukları + emniyet kemerleri --- */
  for (const sx of [-1, 1]) {
    const armr = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.05, 0.52), softMat);
    armr.position.set(sx * 0.56, 0.55, 2.52); cockpit.add(armr);
    const strap = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.55, 0.018),
      new THREE.MeshStandardMaterial({ color: 0x2a3324, roughness: 0.95 }));
    strap.position.set(sx * 0.27, 1.02, 2.36); strap.rotation.x = 0.42; strap.rotation.z = -sx * 0.18;
    cockpit.add(strap);
  }

  /* --- Kanopi camı --- */
  const glass = new THREE.Mesh(new THREE.SphereGeometry(1.9, 36, 20, -Math.PI*0.56, Math.PI*1.12, 0.20, Math.PI*0.48),
    new THREE.MeshPhongMaterial({ color: 0x9fc8e8, transparent: true, opacity: 0.13, shininess: 280, specular: 0xcfefff, side: THREE.DoubleSide, depthWrite: false }));
  glass.position.set(0, 0.55, 3.15); glass.rotation.y = Math.PI;
  cockpit.add(glass);

  /* --- Arka duvar + zemin --- */
  const back = new THREE.Mesh(new THREE.BoxGeometry(2.7, 2.0, 0.1), trimMat);
  back.position.set(0, 0.9, 2.1); cockpit.add(back);
  const floor = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.06, 2.4),
    new THREE.MeshStandardMaterial({ map: makePanelTex(256, 256), roughness: 0.95 }));
  floor.position.set(0, -0.06, 3.3); cockpit.add(floor);
  const floorGlow = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.012, 0.015),
    new THREE.MeshBasicMaterial({ color: 0x5a3a1a }));
  floorGlow.position.set(0, -0.02, 2.35); cockpit.add(floorGlow);
  _backlights.push(floorGlow);

  /* --- Aydınlatma --- */
  const cabLight = new THREE.PointLight(0x6688cc, 0.6, 6);
  cabLight.position.set(0, 1.6, 3.3); cockpit.add(cabLight);
  const cabLight2 = new THREE.PointLight(0xff8855, 0.22, 4);
  cabLight2.position.set(0, 0.4, 3.8); cockpit.add(cabLight2);
  const cabLight3 = new THREE.PointLight(0x22aacc, 0.25, 3);
  cabLight3.position.set(0, 0.7, 4.0); cockpit.add(cabLight3);
}

/* ---------------- WARP ÇİZGİLERİ ---------------- */
const warpStreaks = (() => {
  const n = 260;
  const pos = new Float32Array(n*2*3);
  const meta = [];
  for (let i=0;i<n;i++){
    const ang = Math.random()*Math.PI*2, rad = 14+Math.random()*90;
    const x = Math.cos(ang)*rad, y = Math.sin(ang)*rad;
    const z = -300 + Math.random()*600;
    const len = 30+Math.random()*90;
    meta.push({x,y,z,len, spd: 900+Math.random()*900});
    pos[i*6]=x; pos[i*6+1]=y; pos[i*6+2]=z;
    pos[i*6+3]=x; pos[i*6+4]=y; pos[i*6+5]=z+len;
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  const lines = new THREE.LineSegments(g, new THREE.LineBasicMaterial({ color:0xbfe0ff, transparent:true, opacity:0.85, fog:false, blending:THREE.AdditiveBlending }));
  lines.visible = false;
  lines.frustumCulled = false;
  lines.userData = meta;
  scene.add(lines);
  return lines;
})();
const warpTunnel = (() => {
  const tex = radialTex('rgba(150,120,255,0.0)','rgba(140,110,255,0.35)','rgba(90,60,220,0)');
  const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map:tex, transparent:true, opacity:0, depthWrite:false, blending:THREE.AdditiveBlending, fog:false }));
  sp.scale.set(700,700,1);
  scene.add(sp);
  return sp;
})();

/* ---------------- DURUM & FİZİK ---------------- */
const KT = 1.94384, FT = 3.28084;
const AC = {
  mass: 11000, wingArea: 34,
  maxThrust: 95000, abThrust: 160000,
  clAlpha: 5.0, clMax: 1.4,
  cd0: 0.023, kInduced: 0.09,
  stallAoA: 16 * Math.PI/180,
  gearDragCd: 0.020,
  flapSteps: [0, 8, 20, 32]
};
const S = {
  pos: new THREE.Vector3(), vel: new THREE.Vector3(),
  quat: new THREE.Quaternion(), angVel: new THREE.Vector3(),
  throttle: 0, ab: false,
  flapIdx: 0, gearDown: true, gearAnim: 1, brake: false,
  fuel: 4200,
  onGround: true, crashed: false,
  aoa: 0, gForce: 1, mach: 0, ias: 0, time: 0,
  planet: PLANETS[0], upS: new THREE.Vector3(0,1,0),
  alt: 0, agl: 0, pitch: 0, roll: 0, hdg: 0, atmDens: 1, heat: 0, od: 0, odT: 0, vtol: false,
  launchHold: false, dockAP: false,
  credits: 0, upg: {}, mission: null, saraOn: true,
  bhSeq: 0, _bhD: 1e9,
  pwr: 0, pwrT: 0, lightOn: false,
  target: 1,
  warp: 'off', warpT: 0, warpDir: new THREE.Vector3(), warpExit: new THREE.Vector3(), warpSpeed: 0
};
function spawnAt(p) {
  S.pos.copy(p.padWorld).add(new THREE.Vector3(0, 3.3, (p.rwLen||RUNWAY.len)/2 - 140));
  S.vel.set(0,0,0); S.angVel.set(0,0,0);
  S.quat.setFromEuler(new THREE.Euler(0, Math.PI, 0));
  S.onGround = true; S.planet = p;
}
spawnAt(PLANETS[0]);

function airDensity(alt, p) { return 1.225 * p.atm * Math.exp(-Math.max(alt,0)/6500); }

/* Teğet çerçeve: yerel kuzey/doğu (pusula için) */
const _north = new THREE.Vector3(), _east = new THREE.Vector3();
function tangentFrame(up) {
  _north.set(0,0,-1).addScaledVector(up, up.z);   // (0,0,-1) - up*(up·(0,0,-1)) = (0,0,-1)+up*up.z
  if (_north.lengthSq() < 0.01) _north.set(1,0,0).addScaledVector(up, -up.x);
  _north.normalize();
  _east.crossVectors(_north, up).negate();        // east = up yönlü sağ el: north × up → batı; negate → doğu
}

/* ---------------- GİRİŞLER ---------------- */
const keys = {};
let mapOpen = false;
addEventListener('keydown', e => {
  keys[e.code] = true;
  if (e.code === 'KeyF' && !S.crashed) { S.flapIdx = (S.flapIdx+1) % 4; flash('FLAP ' + AC.flapSteps[S.flapIdx] + '°'); }
  if (e.code === 'KeyG' && !S.crashed) { S.gearDown = !S.gearDown; flash(S.gearDown ? 'İNİŞ TAKIMI AÇILIYOR' : 'İNİŞ TAKIMI TOPLANIYOR'); }
  if (e.code === 'KeyV' && !S.crashed && S.warp === 'off') {
    S.vtol = !S.vtol;
    flash(S.vtol ? '🚀 DİKEY MOD (VTOL) — gaz ver, roket gibi yüksel!' : 'UÇUŞ MODU — itki ileri');
  }
  if (e.code === 'KeyI' && !S.crashed && !S.launchHold) {
    if (S.pwr === 0) { S.pwr = 1; flash('⚡ ANA GÜÇ AÇIK — aviyonikler devrede'); if (audio.ctx) beepStall(430); }
    else if (S.pwr === 1) { S.pwr = 2; S.pwrT = 0; flash('🔥 ATEŞLEME — motorlar dönüyor...'); if (audio.ctx) engStartSound(); }
    else if (S.pwr === 3 && S.onGround && S.throttle < 0.05) { S.pwr = 0; flash('MOTORLAR KAPATILDI — soğuk kokpit'); }
  }
  if (e.code === 'KeyL' && !S.crashed) {
    S.lightOn = !S.lightOn;
    flash('İNİŞ FARI ' + (S.lightOn ? 'AÇIK 🔦' : 'KAPALI'));
  }
  if (e.code === 'KeyO' && !S.crashed) {
    if (S.mission) {
      flash('AKTİF GÖREV: ' + S.mission.cargo + ' → ' + S.mission.to.name + ' (' + S.mission.reward + ' Kr)');
    } else if (atBase()) {
      S.mission = genMission();
      const idx = TARGETS.indexOf(S.mission.to);
      if (idx >= 0) S.target = idx;
      flash('📦 GÖREV ALINDI: ' + S.mission.cargo + ' → ' + S.mission.to.name + ' · ödül ' + S.mission.reward + ' Kr');
      sara('Yeni görev. ' + S.mission.cargo + ', ' + S.mission.to.name + ' hedefine. Ödül ' + S.mission.reward + ' kredi.');
    } else flash('Görev almak için bir üsse in veya istasyona kenetlen', true);
  }
  if (e.code === 'KeyU' && !S.crashed) {
    if (!atBase()) flash('Mağaza için üsse in / istasyona kenetlen', true);
    else {
      const it = nextShopItem();
      if (!it) flash('Tüm yükseltmeler alındı! 🏆');
      else if (S.credits >= it.cost) {
        S.credits -= it.cost; S.upg[it.id] = true;
        flash('🛠️ YÜKSELTME: ' + it.name + ' (−' + it.cost + ' Kr)');
        sara('Yükseltme kuruldu. ' + it.name.split('(')[0] + '.');
      } else flash('Yetersiz kredi: ' + it.name + ' → ' + it.cost + ' Kr (sende ' + S.credits + ')', true);
    }
  }
  if (e.code === 'KeyK' && !S.crashed && S.warp === 'off' && !S.launchHold) {
    if (S.dockAP) { S.dockAP = false; flash('Yanaşma otopilotu KAPALI'); }
    else {
      let best = null, bd = 1e9;
      for (const st of STATIONS) { const d = S.pos.distanceTo(st.padWorld); if (d < bd) { bd = d; best = st; } }
      if (best && bd < 7000) { S.dockAP = true; S._apSt = best; flash('🤖 YANAŞMA OTOPİLOTU AKTİF → ' + best.name + ' (' + Math.round(bd) + ' m)'); }
      else flash('7 km içinde istasyon yok — önce yaklaş', true);
    }
  }
  if (e.code === 'KeyC') { camMode = (camMode+1) % 3; document.getElementById('camLabel').textContent = ['KOKPİT','TAKİP','SERBEST'][camMode]; updateHudVis(); }
  if (e.code === 'KeyH') document.getElementById('ctrlPanel').classList.toggle('hidden');
  if (e.code === 'KeyN' && !S.crashed) {
    S.target = (S.target + 1) % TARGETS.length;
    if (TARGETS[S.target] === S.planet && S.onGround) S.target = (S.target + 1) % TARGETS.length;
    flash('HEDEF: ' + TARGETS[S.target].name + ' (' + (S.pos.distanceTo(TARGETS[S.target].center)/1000).toFixed(0) + ' km)');
  }
  if (e.code === 'KeyJ' && !S.crashed) tryWarp();
  if (e.code === 'KeyM') { mapOpen = !mapOpen; document.getElementById('mapOverlay').style.display = mapOpen ? 'flex' : 'none'; if (mapOpen) sizeMap(); }
  if (e.code === 'KeyR') resetPlane();
  if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)) e.preventDefault();
});
addEventListener('keyup', e => keys[e.code] = false);

let camMode = 0, mouseDown = false, camYaw = 0, camPitch = 0.18, freeDist = 46;
addEventListener('mousedown', e => { if (e.button === 2) mouseDown = true; if (e.button === 0 && started && !mapOpen) fireHeld = true; });
addEventListener('mouseup', e => { if (e.button === 2) mouseDown = false; if (e.button === 0) fireHeld = false; });
addEventListener('mousemove', e => { if (mouseDown) { camYaw -= e.movementX*0.004; camPitch = Math.max(-1.2, Math.min(1.4, camPitch + e.movementY*0.004)); } });
addEventListener('wheel', e => { freeDist = Math.max(16, Math.min(260, freeDist + e.deltaY*0.05)); });
addEventListener('contextmenu', e => e.preventDefault());

const stick = { pitch:0, roll:0, yaw:0 };
function updateStick(dt) {
  const tgt = {
    pitch: (keys['KeyW']||keys['ArrowUp'] ? 1:0) - (keys['KeyS']||keys['ArrowDown'] ? 1:0),
    roll:  (keys['KeyD']||keys['ArrowRight'] ? 1:0) - (keys['KeyA']||keys['ArrowLeft'] ? 1:0),
    yaw:   (keys['KeyE'] ? 1:0) - (keys['KeyQ'] ? 1:0)
  };
  const rate = 4.6;
  for (const k of ['pitch','roll','yaw'])
    stick[k] += (tgt[k]-stick[k]) * Math.min(1, rate*dt);
  if (keys['ShiftLeft']||keys['ShiftRight']) S.throttle = Math.min(1, S.throttle + 0.45*dt);
  if (keys['ControlLeft']||keys['ControlRight']) S.throttle = Math.max(0, S.throttle - 0.45*dt);
  S.ab = !!keys['Space'] && S.throttle > 0.85 && S.fuel > 0 && S.warp === 'off';
  S.brake = !!keys['KeyB'];
}

/* ---------------- WARP ---------------- */
function tryWarp() {
  if (S.warp !== 'off') return;
  const tp = TARGETS[S.target];
  const dist = S.pos.distanceTo(tp.center);
  if (S.onGround) return flash('WARP için önce havalan! (hedef kaydedildi: ' + tp.name + ')', true);
  if (S.agl < 900) return flash('WARP için en az 3.000 ft irtifa gerekli!', true);
  if (dist < tp.radius + 16000) return flash('Hedefe zaten çok yakınsın!', true);
  S.warp = 'charge'; S.warpT = 0; S.dockAP = false;
  const away = S.pos.clone().sub(tp.center).normalize();
  S.warpExit.copy(tp.center).addScaledVector(away, tp.radius + 7000);
  S.warpDir.copy(S.warpExit).sub(S.pos).normalize();
  document.getElementById('warpInfo').style.display = 'block';
  if (audio.ctx) warpChargeSound();
}
function updateWarp(dt) {
  const wi = document.getElementById('warpMain'), ws = document.getElementById('warpSub');
  const tp = TARGETS[S.target];
  if (S.warp === 'charge') {
    S.warpT += dt;
    wi.textContent = 'WARP SÜRÜCÜSÜ ŞARJ OLUYOR';
    ws.textContent = '█'.repeat(Math.floor(S.warpT/warpChargeT()*18)).padEnd(18,'░') + '  hedef: ' + tp.name;
    camera.position.x += (Math.random()-0.5)*0.06*S.warpT;
    camera.position.y += (Math.random()-0.5)*0.06*S.warpT;
    if (S.warpT >= warpChargeT()) {
      S.warp = 'jump'; S.warpT = 0; S.warpSpeed = 0;
      warpStreaks.visible = true;
      warpStreaks.material.opacity = 0.85;
      document.getElementById('warpFlash').style.opacity = 0.9;
      setTimeout(()=> document.getElementById('warpFlash').style.opacity = 0, 60);
      if (audio.ctx) warpJumpSound(true);
    }
  } else if (S.warp === 'jump') {
    S.warpT += dt;
    const dist = S.pos.distanceTo(S.warpExit);
    const maxSpd = 26000;
    // yumuşak hızlanma / yavaşlama
    const targetSpd = Math.min(maxSpd, Math.max(1200, dist*0.9));
    S.warpSpeed += (targetSpd - S.warpSpeed) * Math.min(1, dt*1.6);
    S.pos.addScaledVector(S.warpDir, S.warpSpeed*dt);
    // burnu warp yönüne çevir
    const want = new THREE.Quaternion().setFromRotationMatrix(
      new THREE.Matrix4().lookAt(new THREE.Vector3(), S.warpDir.clone().negate(), S.upS));
    S.quat.slerp(want, Math.min(1, dt*2.5));
    S.angVel.set(0,0,0);
    wi.textContent = '⚡ WARP AKTİF — ' + tp.name;
    ws.textContent = (dist/1000).toFixed(1) + ' km · ' + (S.warpSpeed/299.8).toFixed(1) + '‰ c';
    if (dist < Math.max(1600, S.warpSpeed*dt*3)) {
      S.warp = 'off';
      warpStreaks.visible = false;
      S.pos.copy(S.warpExit);
      const fwd = tp.center.clone().sub(S.pos).normalize();
      S.vel.copy(fwd).multiplyScalar(240);
      const wq = new THREE.Quaternion().setFromRotationMatrix(
        new THREE.Matrix4().lookAt(new THREE.Vector3(), fwd.clone().negate(), S.upS));
      S.quat.copy(wq);
      document.getElementById('warpInfo').style.display = 'none';
      document.getElementById('warpFlash').style.opacity = 0.95;
      setTimeout(()=> document.getElementById('warpFlash').style.opacity = 0, 80);
      flash(tp.name + ' yörüngesine çıkıldı — inişe geç!');
      if (audio.ctx) warpJumpSound(false);
    }
  }
}

/* ---------------- FİZİK ---------------- */
const _f = new THREE.Vector3(), _r = new THREE.Vector3(), _u = new THREE.Vector3();
const _tmp = new THREE.Vector3(), _tmp2 = new THREE.Vector3(), _qi = new THREE.Quaternion();
function physics(dt) {
  if (S.crashed) return;
  S.time += dt;

  /* Motor başlatma spool'u */
  if (S.pwr === 2) {
    S.pwrT += dt;
    if (S.pwrT >= 2.6) { S.pwr = 3; flash('✔ MOTORLAR ÇALIŞIYOR — iyi uçuşlar komutan'); }
  }
  S.gearAnim += (S.gearDown ? 1 : -1) * dt / 1.8;
  S.gearAnim = Math.max(0, Math.min(1, S.gearAnim));
  gearGroup.visible = S.gearAnim > 0.02;
  gearGroup.scale.y = Math.max(0.05, S.gearAnim);
  gearGroup.position.y = -(1-S.gearAnim)*0.6;
  // Süspansiyon: yere değince amortisörler sıkışır, inişte vuruşla ekstra çöker
  const compTgt = Math.min(0.24, (S.onGround ? 0.12 + Math.min(0.05, S.vel.length()*0.0004) : 0) + (S._gearKick || 0));
  S._gearComp = (S._gearComp || 0) + (compTgt - (S._gearComp || 0)) * Math.min(1, dt * 9);
  S._gearKick = (S._gearKick || 0) * Math.max(0, 1 - dt * 4.5);
  if (window._gearLegs) for (const sh of _gearLegs) sh.position.y = sh.userData.y0 + S._gearComp;

  /* En yakın gezegen + yerel yukarı */
  const p = nearestPlanet(S.pos);
  S.planet = p;
  const rel = _tmp.copy(S.pos).sub(p.center);
  const distC = rel.length();
  const up = S.upS.copy(rel).divideScalar(distC);
  S.alt = distC - p.radius;
  const dirN = rel.clone().normalize();
  const terrH = S.alt < 3500 ? planetTerrain(p, dirN) : 0;
  S.agl = S.alt - terrH;

  _f.set(0,0,1).applyQuaternion(S.quat);
  _r.set(1,0,0).applyQuaternion(S.quat);
  _u.set(0,1,0).applyQuaternion(S.quat);

  /* Dikey kalkış rampası: kenetli — gaz %50 üstüne çıkınca geri sayım */
  if (S.launchHold) {
    S.vel.set(0,0,0); S.angVel.set(0,0,0);
    S.pos.copy(S._launchPos);
    plane.position.copy(S.pos);
    plane.quaternion.copy(S.quat);
    if (S._cd === undefined && S.throttle > 0.5 && S.pwr === 3) { S._cd = 3.99; S._cdShown = 99; }
    if (S._cd !== undefined) {
      S._cd -= dt;
      const ci = Math.ceil(S._cd);
      if (ci !== S._cdShown) {
        S._cdShown = ci;
        if (ci > 0) { flash('🚀 KALKIŞA ' + ci + '...'); if (audio.ctx) beepStall(520); }
        else {
          flash('ATEŞLEME! KENETLER AYRILDI 🔥');
          S.launchHold = false; S._cd = undefined;
          if (audio.ctx) { boom(); }
          spawnTouchFx(1); spawnTouchFx(1);
        }
      }
    }
    S.gForce = 1; S.ias = 0;
    return;
  }

  /* KARA DELİK SEKANSI: kontrol yok, spiral düşüş, uzayan gemi hissi */
  if (S.bhSeq) {
    S.bhSeq -= dt;
    const toC = BH.center.clone().sub(S.pos);
    const d2 = toC.length();
    S._bhD = d2;
    toC.divideScalar(Math.max(1, d2));
    const tang = new THREE.Vector3().crossVectors(toC, _u).normalize();
    const t2 = 1 - S.bhSeq / 7.5;
    const pull = 70 + t2 * t2 * 900;
    S.vel.lerp(toC.clone().multiplyScalar(pull).addScaledVector(tang, pull * 0.75), Math.min(1, dt * 1.3));
    S.pos.addScaledVector(S.vel, dt);
    S.angVel.set(0.25 + t2, 0.8 + t2 * 1.6, 1.2 + t2 * 2);
    const dqB = new THREE.Quaternion(S.angVel.x*dt/2, S.angVel.y*dt/2, S.angVel.z*dt/2, 1).normalize();
    S.quat.multiply(dqB).normalize();
    plane.position.copy(S.pos);
    plane.quaternion.copy(S.quat);
    // Gemi görsel olarak uzuyor (spagettileşme!)
    const stretch = 1 + t2 * t2 * 2.4;
    plane.scale.set(Math.max(0.3, 1 - t2*0.4), Math.max(0.3, 1 - t2*0.4), stretch);
    S.heat = Math.min(1, 0.5 + t2);
    S.gForce = 8 + t2 * 20;
    S.ias = S.vel.length() * 1.94;
    if (S.bhSeq <= 0) {
      plane.scale.set(1,1,1);
      return doCrash('Tekillik — gemi atomlarına ayrıldı, zaman burada bitti 🕳️');
    }
    return;
  }

  if (S.warp !== 'off') { updateWarpVisuals(dt); return; }

  /* Yerçekimi: yüzey ivmesi cismin boyutuyla ölçekli, uzaklıkta (R/d)² azalır */
  const g0 = 9.81 * Math.max(0.2, Math.min(1.28, p.radius/7000));
  const g = g0 * Math.min(1, (p.radius/distC)*(p.radius/distC));
  const forces = _tmp2.set(0,0,0).addScaledVector(up, -g*AC.mass);
  /* Kara delik çekimi: her yerde etkir, yaklaştıkça ölümcül */
  const bhD = S.pos.distanceTo(BH.center);
  if (bhD < 120000) {
    const gBH = 2.1e9 / (bhD * bhD);
    forces.addScaledVector(BH.center.clone().sub(S.pos).divideScalar(bhD), AC.mass * gBH);
    if (bhD < BH.radius * 1.7 && !S.bhSeq) {
      S.bhSeq = 7.5;
      flash('⚫ OLAY UFKU GEÇİLDİ — kurtuluş yok...', true);
      if (audio.ctx) warpJumpSound(true);
    }
    if (bhD < 14000) S.heat = Math.max(S.heat, (1 - bhD/14000) * 0.7);
  }
  S._bhD = bhD;

  const airVel = S.vel.clone();  // rüzgar yok (uzayda anlamsız); atmosferde sakin
  const speed = airVel.length();
  const rho = airDensity(S.alt, p);
  S.atmDens = rho / 1.225;
  const q = 0.5 * rho * speed * speed;

  const vF = airVel.dot(_f), vU = airVel.dot(_u), vR = airVel.dot(_r);
  S.aoa = speed > 3 ? Math.atan2(-vU, vF) : 0;
  const beta = speed > 3 ? Math.atan2(vR, vF) : 0;

  const flapRad = AC.flapSteps[S.flapIdx] * Math.PI/180;
  const clFlap = flapRad * 1.4;
  const cdFlap = flapRad * flapRad * 0.9;

  let cl = AC.clAlpha * S.aoa + clFlap;
  const stallLim = AC.stallAoA + flapRad*0.35;
  let stalled = false;
  if (Math.abs(S.aoa) > stallLim && rho > 0.05) {
    stalled = true;
    const over = Math.abs(S.aoa) - stallLim;
    cl = (S.aoa >= 0 ? 1 : -1) * Math.max(0.35, (AC.clMax+clFlap*0.6) - over*3.2);
  }
  cl = Math.max(-AC.clMax, Math.min(AC.clMax + clFlap*0.6, cl));
  if (S.agl < 16 && !S.onGround) cl *= 1 + 0.14*Math.max(0, 1 - S.agl/16);   // yer etkisi
  const cd = AC.cd0 + AC.kInduced*cl*cl + cdFlap + (S.gearAnim*AC.gearDragCd) + (stalled?0.06:0);

  if (speed > 0.5 && q > 0.01) {
    const dragDir = airVel.clone().normalize().negate();
    forces.addScaledVector(dragDir, q * AC.wingArea * cd * (1 - S.od * 0.6));
    const liftDir = _r.clone().cross(airVel).normalize();
    if (liftDir.dot(_u) < 0) liftDir.negate();
    let lift = q * AC.wingArea * cl;
    // Yerde burun kalkmadan uçak kalkmaz: rotasyon yapana dek tekerler yapışık
    if (S.onGround && S.pitch < 0.05 && lift > 0) {
      lift = Math.min(lift, AC.mass * g * 0.9);
    } else if (S.agl < 12 && S.gearAnim > 0.5 && lift > 0) {
      const soft = 1.15 + Math.min(0.5, S.agl / 12 * 0.5);
      lift = Math.min(lift, AC.mass * g * soft);
    }
    forces.addScaledVector(liftDir, lift);
    S.gForce = (lift * Math.cos(S.aoa)) / (AC.mass*9.81);
    forces.addScaledVector(_r, -q * AC.wingArea * 0.9 * beta);
  } else S.gForce = S.onGround ? 1 : 0;

  /* Overdrive: Space basılı tutuldukça güç kademeli artar (x1 → x6) */
  if (S.ab) S.od = Math.min(1, S.od + dt/(S.upg.odc ? 3.8 : 6));
  else S.od = Math.max(0, S.od - dt/2.2);
  let thrust = 0;
  if (S.fuel > 0 && S.pwr === 3) {
    const thrLvl = S.throttle > 0.008 ? (0.05 + 0.95 * S.throttle) : 0;   // rölanti tabanı: %1 gaz bile iter
    thrust = thrLvl * AC.maxThrust * (S.ab ? AC.abThrust/AC.maxThrust : 1);
    thrust *= (1 + S.od * 5);                          // overdrive çarpanı
    thrust *= (0.55 + 0.45*Math.min(1, rho/1.225));   // uzayda roket modu
    S.fuel -= (S.throttle * 0.8 + (S.ab ? 3.4 : 0) + S.od * 5.5) * dt;
    if (S.fuel <= 0) { S.fuel = 0; flash('YAKIT BİTTİ!', true); }
  }
  /* VTOL: itki gövde-yukarı; ileri hız arttıkça uçuşa harmanlanır */
  let thrustDir = _f;
  if (S.vtol) {
    const blend = Math.min(1, Math.max(0, vF / 130));
    thrustDir = _u.clone().multiplyScalar(1 - blend).addScaledVector(_f, blend).normalize();
    thrust *= 1.55;
    if (blend > 0.92) { S.vtol = false; flash('GEÇİŞ TAMAM — UÇUŞ MODU'); }
  }
  forces.addScaledVector(thrustDir, thrust);
  /* UÇUŞ YARDIMI (boşluk): burnun baktığı yöne süzül — işaret et & git */
  if (S.atmDens < 0.06 && !S.onGround && S.warp === 'off' && !S.dockAP) {
    const spd3 = S.vel.length();
    if (spd3 > 1 && S.throttle > 0.05) {
      S.vel.lerp(_f.clone().multiplyScalar(spd3), Math.min(1, dt * 1.1));
    }
    // Gaz kapalıyken hafif otomatik sönümleme: sonsuz savrulma yok
    if (S.throttle < 0.02 && !S.brake && spd3 > 2) S.vel.multiplyScalar(Math.max(0, 1 - dt * 0.10));
  }
  /* Yanaşma otopilotu: hedef istasyona güvenli hız profiliyle yaklaş, dur */
  if (S.dockAP && S._apSt) {
    const dp = S._apSt.padWorld;
    const to = dp.clone().sub(S.pos);
    const d = to.length();
    to.divideScalar(Math.max(0.001, d));
    let vDes = Math.min(d * 0.22, 140);
    if (d < 200) vDes = Math.min(vDes, 4 + d * 0.05);
    const dv = to.multiplyScalar(vDes).sub(S.vel);
    const dvl = dv.length();
    if (dvl > 0.01) forces.addScaledVector(dv.divideScalar(dvl), Math.min(60, dvl * 1.8) * AC.mass);
    const wq = new THREE.Quaternion().setFromRotationMatrix(
      new THREE.Matrix4().lookAt(new THREE.Vector3(), S.pos.clone().sub(dp).normalize(), up));
    S.quat.slerp(wq, Math.min(1, dt * 1.5));
    S.angVel.multiplyScalar(Math.max(0, 1 - dt * 5));
    if (d < 130 && S.vel.length() < 8) { S.dockAP = false; flash('✔ YANAŞMA TAMAM — bağlantı kuruluyor ⛽'); }
  }
  // Uzayda retro fren (B): RCS itici demeti ile yavaşla
  if (S.brake && S.atmDens < 0.05 && !S.onGround && speed > 0.5) {
    forces.addScaledVector(airVel.clone().normalize(), -Math.min(200000, speed*9500));
  }

  /* Kontrol etkinliği: atmosferde aero, boşlukta RCS */
  const aeroEff = Math.min(1, q / 5200);   // düşük hızda daha güçlü kontrol
  const rcsEff = (1 - aeroEff) * 0.95;   // güçlü RCS: boşlukta çevik dönüş
  const ctrlEff = aeroEff + rcsEff;
  const stallCtrl = stalled ? 0.7 : 1;
  const tq = new THREE.Vector3(
    stick.pitch * 2.1 * ctrlEff * stallCtrl,
    stick.yaw  * (0.85*aeroEff + 1.8*rcsEff),
    -stick.roll * 3.7 * ctrlEff * stallCtrl
  );
  tq.x += S.aoa * 2.2 * aeroEff;
  tq.y += beta * 1.6 * aeroEff;
  tq.x -= S.angVel.x * (1.8 + 2.0*aeroEff);
  tq.y -= S.angVel.y * (1.3 + 1.4*aeroEff);
  tq.z -= S.angVel.z * (1.7 + 1.9*aeroEff);
  // Tutum tutucu: kolu bırakınca burun sabit kalır
  if (Math.abs(stick.pitch) < 0.08) tq.x -= S.angVel.x * 2.4 * Math.max(0.3, ctrlEff);
  if (S.atmDens > 0.12 && !S.onGround && S.warp === 'off') {   // hafif türbülans
    tq.x += (Math.random()-0.5)*0.04*S.atmDens;
    tq.z += (Math.random()-0.5)*0.05*S.atmDens;
  }
  if (stalled) { tq.x += 0.5; tq.z += (Math.random()-0.5)*0.7; }
  // Kanat düzeltme yardımcısı: roll bırakınca gemi kendini toparlar
  if (Math.abs(stick.roll) < 0.08 && !S.onGround && S.warp === 'off' && !S.vtol) {
    tq.z += -S.roll * 1.3 * Math.max(0.3, aeroEff);
  }
  S.angVel.addScaledVector(tq, dt);
  if (S.vtol && !S.onGround) {
    const fH = _f.clone().addScaledVector(up, -_f.dot(up)).normalize();
    const rH = _r.clone().addScaledVector(up, -_r.dot(up)).normalize();
    const tgtUp = up.clone()
      .addScaledVector(fH, stick.pitch * 0.38)
      .addScaledVector(rH, stick.roll * 0.38).normalize();
    const axW = new THREE.Vector3().crossVectors(_u, tgtUp);
    _qi.copy(S.quat).invert();
    const axB = axW.applyQuaternion(_qi);
    S.angVel.x += axB.x * 11 * dt;
    S.angVel.z += axB.z * 11 * dt;
    S.angVel.x -= S.angVel.x * Math.min(1, 5*dt);
    S.angVel.z -= S.angVel.z * Math.min(1, 5*dt);
  }

  /* İNİŞ YARDIMI: yere yaklaşırken yastıkla + kanatları düzelt */
  if (!S.onGround && S.warp === 'off' && S.gearAnim > 0.5 && S.agl < 32) {
    const vN0 = S.vel.dot(up);
    if (vN0 < -2.5) S.vel.addScaledVector(up, Math.min(-vN0 - 2.5, 10) * dt * 2.6);
    // Nazik otomatik düzelme (kanatlar + burun)
    const axW2 = new THREE.Vector3().crossVectors(_u, up);
    _qi.copy(S.quat).invert();
    const axB2 = axW2.applyQuaternion(_qi);
    S.angVel.x += axB2.x * 3.5 * dt;
    S.angVel.z += axB2.z * 5 * dt;
  }

  /* ---- Yer teması (küresel) ---- */
  const groundY = (3.1 - (S._gearComp || 0)) * Math.max(0.4, S.gearAnim);
  const vN = S.vel.dot(up);

  if (S.agl <= groundY + 0.05 && vN <= 0.5) {
    // Pad yerel koordinatları
    const lp = S.pos.clone().sub(p.padWorld);
    const onPad = Math.abs(lp.x) < (p.rwWid||RUNWAY.wid)/2+12 && Math.abs(lp.z) < (p.rwLen||RUNWAY.len)/2+20 && S.planet === p;
    const vsFtMin = vN * FT * 60;
    const bankCos = _u.dot(up);
    if (!S.onGround) {
      if (S.gearAnim < 0.85) return doCrash('Gövde üstü iniş — takımlar kapalıydı');
      if (vsFtMin < -2400) return doCrash('Çok sert iniş (' + Math.round(-vsFtMin) + ' ft/dk)');
      if (bankCos < 0.85) return doCrash('Kanat zemine çarptı — aşırı yatış');
      if (!onPad && speed > 75) return doCrash(p.name + ' arazisine yüksek hızla temas');
      S._gearKick = Math.min(0.22, Math.abs(vsFtMin) / 1500);
      spawnTouchFx(Math.min(1, Math.abs(vsFtMin)/900));
      if (audio.ctx) { screechSound(Math.min(1, speed/90)); thud(Math.min(1, Math.abs(vsFtMin)/900)); }
      flash(vsFtMin > -350 ? p.name + ' — YUMUŞAK İNİŞ! 👏' : p.name + ' — indin ama biraz sertti');
    }
    S.onGround = true;
    S.pos.copy(p.center).addScaledVector(up, p.radius + terrH + groundY);
    if (vN < 0) S.vel.addScaledVector(up, -vN);
    // Sürtünme (teğet)
    const vTan = S.vel.clone().addScaledVector(up, -S.vel.dot(up));
    const hs = vTan.length();
    const fric = onPad ? (S.brake ? 4.5 : 0.028) : 0.9;
    if (hs > 0.1) S.vel.addScaledVector(vTan.normalize(), -Math.min(fric*9.81*0.14*dt*10, hs));
    // Burun tekeri
    const steer = stick.yaw * Math.min(1, 14/Math.max(hs,1)) * 0.9;
    S.angVel.y += steer * dt * Math.min(hs,8) * 0.4;
    // Gövdeyi yüzey normaline hizala
    const axisW = new THREE.Vector3().crossVectors(_u, up);
    _qi.copy(S.quat).invert();
    const axisB = axisW.applyQuaternion(_qi);
    S.angVel.x += axisB.x * 28 * dt;
    S.angVel.z += axisB.z * 28 * dt;
    S.angVel.x -= S.angVel.x * Math.min(1, 8*dt);
    S.angVel.z -= S.angVel.z * Math.min(1, 8*dt);
    // Rotasyon
    if (q * AC.wingArea * (AC.clAlpha*0.25+clFlap) > AC.mass*g*0.8 && stick.pitch < -0.25) {
      S.angVel.x += stick.pitch * 0.5 * dt * 10;
      S.angVel.x = Math.max(S.angVel.x, -0.85);   // burun kalkış hızı sınırlı
    }
  } else {
    S.onGround = false;
  }

  if (Math.abs(S.gForce) > (S.upg.armor ? 13 : 11)) return doCrash('Yapısal limit aşıldı (' + S.gForce.toFixed(1) + ' G)');

  const dq = new THREE.Quaternion(S.angVel.x*dt/2, S.angVel.y*dt/2, S.angVel.z*dt/2, 1).normalize();
  S.quat.multiply(dq).normalize();
  S.vel.addScaledVector(forces, dt / AC.mass);
  S.pos.addScaledVector(S.vel, dt);

  S.ias = speed * Math.sqrt(Math.min(1, rho/1.225)) * KT;
  S.mach = speed / 320;
  S.heat = Math.max(0, Math.min(1, (speed-620)/850)) * Math.max(0, Math.min(1, S.atmDens*3.2)) * (S.atmDens < 0.8 ? 1 : 0.35);
  if (S._pM !== undefined && S._pM < 1 && S.mach >= 1 && S.atmDens > 0.12 && !S.onGround && audio.ctx) { sonicBoom(); flash('SES DUVARI AŞILDI — Mach 1 💥'); }
  S._pM = S.mach;
  /* Yapısal hız limiti: atmosferde ~1250 m/s, boşlukta ~6000 m/s */
  const safeV = 1250 + (1 - Math.min(1, S.atmDens * 2)) * 4750;
  S._safeV = safeV;
  if (speed > safeV && !S.onGround) {
    S.odT += dt;
    S.heat = Math.max(S.heat, Math.min(1, 0.45 + (S.odT/5) * 0.55));
    if (S.odT >= odLimitT()) return doCrash('Gövde aşırı hız yükünde parçalandı (' + Math.round(speed*3.6) + ' km/h)');
  } else {
    S.odT = Math.max(0, S.odT - dt * 1.7);
  }
  S._stalled = stalled && !S.onGround && speed > 25;

  /* Tutum (küre-göreli) */
  S.pitch = Math.asin(Math.max(-1, Math.min(1, _f.dot(up))));
  S.roll = Math.atan2(_r.dot(up), Math.max(0.0001,_u.dot(up)));
  tangentFrame(up);
  S.hdg = ((Math.atan2(_f.dot(_east), _f.dot(_north)) * 180/Math.PI) % 360 + 360) % 360;

  /* Görsel animasyonlar */
  _elevonL.rotation.x = stick.pitch*0.4 - stick.roll*0.3;
  _elevonR.rotation.x = stick.pitch*0.4 + stick.roll*0.3;
  _rudder.rotation.y = stick.yaw * 0.5;
  const engPow = S.throttle;
  for (const gl of abGlows) {
    gl.material.opacity = S.ab ? 0.8 + Math.random()*0.2 : engPow > 0.5 ? (engPow-0.5)*0.7 : 0;
    gl.scale.setScalar((S.ab ? 1 + Math.random()*0.3 : 0.55 + engPow*0.3) * (gl.userData.mul || 1));
    gl.material.color.setHex(S.ab ? 0xb07aff : 0x6a9aff);
  }
  for (const gl of engGlows) gl.material.opacity = engPow * 0.55;
  for (const lg of (window.liftGlows||[])) {
    lg.material.opacity = S.vtol ? Math.min(0.85, S.throttle * (0.5 + S.od*0.6) + 0.08) : 0;
    lg.scale.y = 0.7 + S.throttle * 0.8 + Math.random()*0.15;
  }
  throttleLever.rotation.x = 0.55 - S.throttle * 1.1;
  ctrlStick.rotation.x = stick.pitch * 0.28;
  ctrlStick.rotation.z = -stick.roll * 0.28;
  if (window._pedalL) { _pedalL.position.z = _pedalL.userData.z0 + stick.yaw*0.07; _pedalR.position.z = _pedalR.userData.z0 - stick.yaw*0.07; }
  if (window._gearHandle) _gearHandle.rotation.x = -0.2 - (1 - S.gearAnim) * 0.95;
  _cabinWarn.material.color.setHex((S._stalled || Math.abs(S.gForce) > 8) ? 0xff2233 : 0x331111);
  if (window._landLight) _landLight.intensity = (S.lightOn && S.pwr > 0) ? 2.6 : 0;
  const vib = 0.0035*S.throttle + Math.min(0.004, q/2.4e6) + S.heat*0.01;
  cockpit.position.set((Math.random()-0.5)*vib, (Math.random()-0.5)*vib, 0);

  plane.position.copy(S.pos);
  plane.quaternion.copy(S.quat);
}

function updateWarpVisuals(dt) {
  plane.position.copy(S.pos);
  plane.quaternion.copy(S.quat);
  // Çizgiler kamera etrafında, warp yönüne hizalı
  if (warpStreaks.visible) {
    warpStreaks.position.copy(S.pos);
    warpStreaks.quaternion.setFromRotationMatrix(
      new THREE.Matrix4().lookAt(new THREE.Vector3(), S.warpDir.clone().negate(), _u));
    const posAttr = warpStreaks.geometry.attributes.position;
    const meta = warpStreaks.userData;
    const spdScale = 0.4 + S.warpSpeed/26000;
    for (let i=0;i<meta.length;i++){
      const m = meta[i];
      m.z += m.spd * spdScale * dt;
      if (m.z > 320) m.z = -320 - Math.random()*160;
      const stretch = m.len * (1 + S.warpSpeed/6000);
      posAttr.setXYZ(i*2, m.x, m.y, m.z);
      posAttr.setXYZ(i*2+1, m.x, m.y, m.z + stretch);
    }
    posAttr.needsUpdate = true;
    warpTunnel.position.copy(S.pos).addScaledVector(S.warpDir, 480);
    warpTunnel.material.opacity = Math.min(0.75, S.warpSpeed/12000);
  } else warpTunnel.material.opacity = 0;
}

/* ---------------- KAZA & RESET ---------------- */
let crashParticles = null;
function doCrash(reason) {
  if (S.crashed) return;
  S.crashed = true;
  S.warp = 'off'; warpStreaks.visible = false;
  S.dockAP = false; S.launchHold = false; S._cd = undefined;
  S.bhSeq = 0; plane.scale.set(1,1,1); renderer.domElement.style.filter = '';
  document.getElementById('warpInfo').style.display = 'none';
  document.getElementById('crashScreen').style.display = 'flex';
  document.getElementById('crashReason').textContent = reason;
  document.getElementById('crashStats').textContent =
    'Hız: ' + Math.round(S.ias) + ' kt · İrtifa: ' + Math.round(S.alt*FT) + ' ft · Gezegen: ' + S.planet.name + ' · Süre: ' + Math.round(S.time) + ' sn';
  extGroup.visible = false; cockpit.visible = false;
  const g = new THREE.BufferGeometry();
  const n = 200, pos = new Float32Array(n*3), vel = [];
  for (let i=0;i<n;i++){
    pos[i*3]=S.pos.x; pos[i*3+1]=S.pos.y; pos[i*3+2]=S.pos.z;
    vel.push(new THREE.Vector3((Math.random()-0.5)*44, Math.random()*48, (Math.random()-0.5)*44));
  }
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  crashParticles = new THREE.Points(g, new THREE.PointsMaterial({ color:0xb07aff, size:3.4, transparent:true, blending:THREE.AdditiveBlending }));
  crashParticles.userData = { vel, life:2.6, up: S.upS.clone() };
  scene.add(crashParticles);
  if (audio.ctx) { audio.eng.gain.setTargetAtTime(0, audio.ctx.currentTime, 0.1); boom(); }
}
function setupVerticalLaunch() {
  const p = PLANETS[0];
  // Burun dik yukarı (gövde +Z → dünya +Y)
  S.quat.setFromEuler(new THREE.Euler(Math.PI/2, Math.PI, 0));
  S.pos.copy(p.padWorld).add(new THREE.Vector3(150, 8.2, -60));   // H apronu = fırlatma rampası
  S._launchPos = S.pos.clone();
  S.launchHold = true;
  S._cd = undefined; S._cdShown = 99;
  S.gearDown = false; S.gearAnim = 0;   // roketlerde teker olmaz 😄
  S.onGround = false;
  S.vel.set(0,0,0); S.angVel.set(0,0,0);
  plane.position.copy(S.pos); plane.quaternion.copy(S.quat);
}
function resetPlane() {
  const p = nearestPlanet(S.pos);
  spawnAt(p);
  S.throttle=0; S.flapIdx=0; S.gearDown=true; S.gearAnim=1;
  S.fuel=fuelMax(); S.crashed=false; S.time=0; S.gForce=1;
  S.warp='off'; warpStreaks.visible = false;
  S.dockAP = false; S.launchHold = false; S._cd = undefined;
  S.bhSeq = 0; plane.scale.set(1,1,1); renderer.domElement.style.filter = '';
  document.getElementById('warpInfo').style.display = 'none';
  extGroup.visible = true;
  document.getElementById('crashScreen').style.display='none';
  if (crashParticles) { scene.remove(crashParticles); crashParticles=null; }
  flash(p.name + ' üssüne dönüldü — iyi uçuşlar komutan!');
}

/* ---------------- SES (sinematik motor) ---------------- */
const audio = { ctx:null };
function initAudio() {
  const ctx = new (window.AudioContext||window.webkitAudioContext)();
  audio.ctx = ctx;
  // Master → kompresör (punch için)
  const comp = ctx.createDynamicsCompressor();
  comp.threshold.value = -16; comp.knee.value = 24; comp.ratio.value = 9;
  comp.attack.value = 0.004; comp.release.value = 0.26;
  comp.connect(ctx.destination);
  const master = ctx.createGain(); master.gain.value = 0.55; master.connect(comp);
  audio.master = master;

  // Uzay yankı hattı (feedback delay) — warp/patlama buraya da gönderilir
  const fx = ctx.createGain(); fx.gain.value = 0.7;
  const dly = ctx.createDelay(1.5); dly.delayTime.value = 0.31;
  const fb = ctx.createGain(); fb.gain.value = 0.42;
  const fLp = ctx.createBiquadFilter(); fLp.type = 'lowpass'; fLp.frequency.value = 1600;
  fx.connect(dly); dly.connect(fLp); fLp.connect(fb); fb.connect(dly); fLp.connect(master);
  audio.fx = fx;

  // --- MOTOR: 4 katman (çift detune saw + triangle + derin sub) ---
  const eng = ctx.createGain(); eng.gain.value = 0;
  const engLp = ctx.createBiquadFilter(); engLp.type = 'lowpass'; engLp.frequency.value = 300; engLp.Q.value = 0.9;
  const o1 = ctx.createOscillator(); o1.type = 'sawtooth'; o1.frequency.value = 33;
  const o2 = ctx.createOscillator(); o2.type = 'sawtooth'; o2.frequency.value = 33.5;
  const o3 = ctx.createOscillator(); o3.type = 'triangle'; o3.frequency.value = 51;
  const sub = ctx.createOscillator(); sub.type = 'sine'; sub.frequency.value = 26;
  const subG = ctx.createGain(); subG.gain.value = 1.5;
  o1.connect(engLp); o2.connect(engLp); o3.connect(engLp);
  sub.connect(subG); subG.connect(engLp);
  engLp.connect(eng); eng.connect(master);
  // Rölanti gürlemesi (LFO ile hacim titreşimi)
  const lfo = ctx.createOscillator(); lfo.frequency.value = 10.5;
  const lfoG = ctx.createGain(); lfoG.gain.value = 0.03;
  lfo.connect(lfoG); lfoG.connect(eng.gain);
  [o1,o2,o3,sub,lfo].forEach(o => o.start());
  audio.eng = eng; audio.o1 = o1; audio.o2 = o2; audio.o3 = o3; audio.sub = sub; audio.engLp = engLp;

  // Paylaşılan gürültü buffer'ı
  const nBuf = ctx.createBuffer(1, ctx.sampleRate*2, ctx.sampleRate);
  const nd = nBuf.getChannelData(0);
  for (let i=0;i<nd.length;i++) nd[i] = Math.random()*2-1;
  audio.noiseBuf = nBuf;

  // Rüzgar
  const wind = ctx.createBufferSource(); wind.buffer = nBuf; wind.loop = true;
  const wBp = ctx.createBiquadFilter(); wBp.type = 'bandpass'; wBp.frequency.value = 800; wBp.Q.value = 0.5;
  const wG = ctx.createGain(); wG.gain.value = 0;
  wind.connect(wBp); wBp.connect(wG); wG.connect(master); wind.start();
  audio.noise = wG; audio.nFilt = wBp;

  // Derin gövde gürlemesi (atmosfere giriş / yüksek hız)
  const rum = ctx.createBufferSource(); rum.buffer = nBuf; rum.loop = true; rum.playbackRate.value = 0.35;
  const rLp = ctx.createBiquadFilter(); rLp.type = 'lowpass'; rLp.frequency.value = 90; rLp.Q.value = 0.8;
  const rG = ctx.createGain(); rG.gain.value = 0;
  rum.connect(rLp); rLp.connect(rG); rG.connect(master); rum.start();
  audio.rumble = rG;

  // Afterburner plazma çıtırtısı
  const crk = ctx.createBufferSource(); crk.buffer = nBuf; crk.loop = true; crk.playbackRate.value = 0.62;
  const cBp = ctx.createBiquadFilter(); cBp.type = 'bandpass'; cBp.frequency.value = 150; cBp.Q.value = 1.1;
  const cG = ctx.createGain(); cG.gain.value = 0;
  crk.connect(cBp); cBp.connect(cG); cG.connect(master); crk.start();
  audio.crackle = cG;

  // Warp drone'u (rezonanslı, detune, tremololu — dorse gibi uğulduyor)
  const wd1 = ctx.createOscillator(); wd1.type = 'sawtooth'; wd1.frequency.value = 62;
  const wd2 = ctx.createOscillator(); wd2.type = 'sawtooth'; wd2.frequency.value = 62.6;
  const wd3 = ctx.createOscillator(); wd3.type = 'sine'; wd3.frequency.value = 31;
  const wdLp = ctx.createBiquadFilter(); wdLp.type = 'lowpass'; wdLp.frequency.value = 380; wdLp.Q.value = 5.5;
  const wdG = ctx.createGain(); wdG.gain.value = 0;
  const trem = ctx.createOscillator(); trem.frequency.value = 4.8;
  const tremG = ctx.createGain(); tremG.gain.value = 0.05;
  trem.connect(tremG); tremG.connect(wdG.gain);
  wd1.connect(wdLp); wd2.connect(wdLp); wd3.connect(wdLp); wdLp.connect(wdG);
  wdG.connect(master);
  const wdSend = ctx.createGain(); wdSend.gain.value = 0.4;
  wdG.connect(wdSend); wdSend.connect(fx);
  [wd1,wd2,wd3,trem].forEach(o => o.start());
  audio.warpDrone = wdG; audio.wdLp = wdLp; audio.wd1 = wd1; audio.wd2 = wd2;

  // Türbin ıslığı (jet whine — gaz ve hızla tizleşir)
  const wh1 = ctx.createOscillator(); wh1.type = 'sawtooth'; wh1.frequency.value = 740;
  const wh2 = ctx.createOscillator(); wh2.type = 'sine'; wh2.frequency.value = 1490;
  const whBp = ctx.createBiquadFilter(); whBp.type = 'bandpass'; whBp.frequency.value = 1900; whBp.Q.value = 1.6;
  const whG = ctx.createGain(); whG.gain.value = 0;
  wh1.connect(whBp); wh2.connect(whBp); whBp.connect(whG); whG.connect(master);
  wh1.start(); wh2.start();
  audio.wh1 = wh1; audio.wh2 = wh2; audio.whBp = whBp; audio.whine = whG;

  // Spool gürültüsü (gaz verildiği anda kabaran hava emişi)
  const spl = ctx.createBufferSource(); spl.buffer = nBuf; spl.loop = true; spl.playbackRate.value = 0.9;
  const splBp = ctx.createBiquadFilter(); splBp.type = 'bandpass'; splBp.frequency.value = 1100; splBp.Q.value = 0.8;
  const splG = ctx.createGain(); splG.gain.value = 0;
  spl.connect(splBp); splBp.connect(splG); splG.connect(master); spl.start();
  audio.spool = splG; audio.splBp = splBp;
  audio.pThr = 0; audio.pAb = false; audio.odMk1 = false; audio.odMk2 = false;

  // Kara delik gürültüsü (derin çekim uğultusu)
  const bo1 = ctx.createOscillator(); bo1.type = 'sine'; bo1.frequency.value = 27;
  const bo2 = ctx.createOscillator(); bo2.type = 'sawtooth'; bo2.frequency.value = 21;
  const boLp = ctx.createBiquadFilter(); boLp.type = 'lowpass'; boLp.frequency.value = 110;
  const boG = ctx.createGain(); boG.gain.value = 0;
  bo1.connect(boLp); bo2.connect(boLp); boLp.connect(boG); boG.connect(master); boG.connect(fx);
  bo1.start(); bo2.start();
  audio.bhDrone = boG; audio.bhOsc = bo1;

  // Yakıt ikmal uğultusu
  const fh = ctx.createOscillator(); fh.type = 'triangle'; fh.frequency.value = 108;
  const fh2 = ctx.createOscillator(); fh2.type = 'sine'; fh2.frequency.value = 216;
  const fhG = ctx.createGain(); fhG.gain.value = 0;
  fh.connect(fhG); fh2.connect(fhG); fhG.connect(master);
  fh.start(); fh2.start();
  audio.fuelHum = fhG;

  audio.lastBeep = 0; audio.lastPuff = 0;
}

/* --- Tek atımlık efektler --- */
function boom() {   // kaza patlaması: sub düşüşü + geniş gürültü, yankılı
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sine';
  o.frequency.setValueAtTime(140, t);
  o.frequency.exponentialRampToValueAtTime(24, t+1.5);
  const g = ctx.createGain();
  g.gain.setValueAtTime(1.0, t);
  g.gain.exponentialRampToValueAtTime(0.001, t+1.7);
  o.connect(g); g.connect(audio.master); g.connect(audio.fx);
  o.start(t); o.stop(t+1.8);
  const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
  const f = ctx.createBiquadFilter(); f.type = 'lowpass';
  f.frequency.setValueAtTime(1600, t);
  f.frequency.exponentialRampToValueAtTime(80, t+1.3);
  const ng = ctx.createGain();
  ng.gain.setValueAtTime(0.95, t);
  ng.gain.exponentialRampToValueAtTime(0.001, t+1.4);
  src.connect(f); f.connect(ng); ng.connect(audio.master); ng.connect(audio.fx);
  src.start(t); src.stop(t+1.5);
}
function sonicBoom() {   // Mach 1 geçişi: çift gümleme
  const ctx = audio.ctx, t0 = ctx.currentTime;
  for (const dt of [0, 0.13]) {
    const t = t0 + dt;
    const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
    const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 240;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.85, t);
    g.gain.exponentialRampToValueAtTime(0.001, t+0.34);
    src.connect(f); f.connect(g); g.connect(audio.master); g.connect(audio.fx);
    src.start(t); src.stop(t+0.4);
  }
  const o = ctx.createOscillator(); o.type = 'sine';
  o.frequency.setValueAtTime(70, t0); o.frequency.exponentialRampToValueAtTime(30, t0+0.5);
  const og = ctx.createGain();
  og.gain.setValueAtTime(0.7, t0); og.gain.exponentialRampToValueAtTime(0.001, t0+0.55);
  o.connect(og); og.connect(audio.master);
  o.start(t0); o.stop(t0+0.6);
}
function thud(strength) {   // iniş gümlemesi
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sine';
  o.frequency.setValueAtTime(76, t); o.frequency.exponentialRampToValueAtTime(34, t+0.28);
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.55*strength + 0.15, t);
  g.gain.exponentialRampToValueAtTime(0.001, t+0.32);
  o.connect(g); g.connect(audio.master);
  o.start(t); o.stop(t+0.36);
}
function beepStall(freq) {   // stall kornası / alarm
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'square'; o.frequency.value = freq || 640;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.09, t);
  g.gain.setValueAtTime(0.09, t+0.14);
  g.gain.exponentialRampToValueAtTime(0.001, t+0.17);
  o.connect(g); g.connect(audio.master);
  o.start(t); o.stop(t+0.18);
}
function rcsPuff() {   // vakumda itici pufu
  const ctx = audio.ctx, t = ctx.currentTime;
  const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
  src.playbackRate.value = 1.6;
  const f = ctx.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = 2600;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.11, t);
  g.gain.exponentialRampToValueAtTime(0.001, t+0.09);
  src.connect(f); f.connect(g); g.connect(audio.master);
  src.start(t); src.stop(t+0.1);
}
function screechSound(strength) {
  const ctx = audio.ctx, t = ctx.currentTime;
  const b = ctx.createBuffer(1, ctx.sampleRate*0.5, ctx.sampleRate);
  const d = b.getChannelData(0);
  for (let i=0;i<d.length;i++) d[i] = (Math.random()*2-1) * Math.exp(-i/(ctx.sampleRate*0.12));
  const src = ctx.createBufferSource(); src.buffer = b;
  const f = ctx.createBiquadFilter(); f.type='bandpass'; f.frequency.value = 1900; f.Q.value = 2.2;
  const g = ctx.createGain(); g.gain.value = 0.35*strength;
  src.connect(f); f.connect(g); g.connect(audio.master); src.start();
}

/* --- Warp ses seti --- */
function engStartSound() {   // motor spool-up: yükselen türbin + hava emişi
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sawtooth';
  o.frequency.setValueAtTime(38, t);
  o.frequency.exponentialRampToValueAtTime(340, t + 2.5);
  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass';
  lp.frequency.setValueAtTime(180, t);
  lp.frequency.exponentialRampToValueAtTime(1600, t + 2.5);
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.001, t);
  g.gain.exponentialRampToValueAtTime(0.22, t + 2.2);
  g.gain.exponentialRampToValueAtTime(0.06, t + 2.9);
  o.connect(lp); lp.connect(g); g.connect(audio.master);
  o.start(t); o.stop(t + 3);
  const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
  const f = ctx.createBiquadFilter(); f.type = 'bandpass';
  f.frequency.setValueAtTime(300, t);
  f.frequency.exponentialRampToValueAtTime(1400, t + 2.4);
  const ng = ctx.createGain();
  ng.gain.setValueAtTime(0.001, t);
  ng.gain.exponentialRampToValueAtTime(0.16, t + 2.3);
  ng.gain.exponentialRampToValueAtTime(0.001, t + 3);
  src.connect(f); f.connect(ng); ng.connect(audio.master);
  src.start(t); src.stop(t + 3.1);
}
function laserShot() {
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sawtooth';
  o.frequency.setValueAtTime(1600, t);
  o.frequency.exponentialRampToValueAtTime(280, t + 0.12);
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.14, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + 0.14);
  o.connect(g); g.connect(audio.master);
  o.start(t); o.stop(t + 0.15);
}
function hitClank() {
  const ctx = audio.ctx, t = ctx.currentTime;
  const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
  const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 900; f.Q.value = 2;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.18, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
  src.connect(f); f.connect(g); g.connect(audio.master);
  src.start(t); src.stop(t + 0.13);
}
function miniBoom() {
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sine';
  o.frequency.setValueAtTime(160, t);
  o.frequency.exponentialRampToValueAtTime(40, t + 0.4);
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.5, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + 0.45);
  o.connect(g); g.connect(audio.master); g.connect(audio.fx);
  o.start(t); o.stop(t + 0.5);
}
function abIgnite() {   // afterburner ateşleme: gümleme + çıtırtı patlaması
  const ctx = audio.ctx, t = ctx.currentTime;
  const o = ctx.createOscillator(); o.type = 'sine';
  o.frequency.setValueAtTime(120, t);
  o.frequency.exponentialRampToValueAtTime(38, t + 0.4);
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.7, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + 0.45);
  o.connect(g); g.connect(audio.master); g.connect(audio.fx);
  o.start(t); o.stop(t + 0.5);
  const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
  const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 300; f.Q.value = 0.9;
  const ng = ctx.createGain();
  ng.gain.setValueAtTime(0.55, t);
  ng.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
  src.connect(f); f.connect(ng); ng.connect(audio.master);
  src.start(t); src.stop(t + 0.65);
}
function odChime(freq) {   // overdrive kademe çanı
  const ctx = audio.ctx, t = ctx.currentTime;
  for (const det of [1, 1.5]) {
    const o = ctx.createOscillator(); o.type = 'sine'; o.frequency.value = freq * det;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.001, t);
    g.gain.exponentialRampToValueAtTime(0.16 / det, t + 0.03);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.9);
    o.connect(g); g.connect(audio.fx);
    o.start(t); o.stop(t + 1);
  }
}
function warpChargeSound() {
  const ctx = audio.ctx, t = ctx.currentTime;
  // Yükselen çift detune testere + tiz parlama
  for (const det of [1, 1.008]) {
    const o = ctx.createOscillator(); o.type = 'sawtooth';
    o.frequency.setValueAtTime(64*det, t);
    o.frequency.exponentialRampToValueAtTime(940*det, t+2.4);
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.001, t);
    g.gain.exponentialRampToValueAtTime(0.11, t+2.2);
    g.gain.exponentialRampToValueAtTime(0.001, t+2.6);
    const lp = ctx.createBiquadFilter(); lp.type='lowpass';
    lp.frequency.setValueAtTime(500, t);
    lp.frequency.exponentialRampToValueAtTime(4200, t+2.4);
    o.connect(lp); lp.connect(g); g.connect(audio.master); g.connect(audio.fx);
    o.start(t); o.stop(t+2.7);
  }
  // Hızlanan reaktör tıkırtıları
  let tk = 0;
  for (let i=0;i<16;i++){
    const tt = t + tk;
    const o = ctx.createOscillator(); o.type='square'; o.frequency.value = 1500 + i*90;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.05, tt);
    g.gain.exponentialRampToValueAtTime(0.001, tt+0.045);
    o.connect(g); g.connect(audio.fx);
    o.start(tt); o.stop(tt+0.05);
    tk += 0.30 - i*0.0155;
  }
  // Derin şarj dalgası
  const swell = ctx.createOscillator(); swell.type='sine';
  swell.frequency.setValueAtTime(30, t);
  swell.frequency.exponentialRampToValueAtTime(58, t+2.4);
  const sg = ctx.createGain();
  sg.gain.setValueAtTime(0.001, t);
  sg.gain.exponentialRampToValueAtTime(0.35, t+2.3);
  sg.gain.exponentialRampToValueAtTime(0.001, t+2.6);
  swell.connect(sg); sg.connect(audio.master);
  swell.start(t); swell.stop(t+2.7);
}
function warpJumpSound(entering) {
  const ctx = audio.ctx, t = ctx.currentTime;
  if (entering) {
    // Dev sub düşüşü — "BWOOOM"
    const o = ctx.createOscillator(); o.type='sine';
    o.frequency.setValueAtTime(210, t);
    o.frequency.exponentialRampToValueAtTime(22, t+2.2);
    const g = ctx.createGain();
    g.gain.setValueAtTime(1.05, t);
    g.gain.exponentialRampToValueAtTime(0.001, t+2.4);
    o.connect(g); g.connect(audio.master); g.connect(audio.fx);
    o.start(t); o.stop(t+2.5);
    // Aşağı süpüren whoosh
    const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
    const f = ctx.createBiquadFilter(); f.type='lowpass';
    f.frequency.setValueAtTime(5200, t);
    f.frequency.exponentialRampToValueAtTime(160, t+1.9);
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.7, t);
    ng.gain.exponentialRampToValueAtTime(0.001, t+2.0);
    src.connect(f); f.connect(ng); ng.connect(audio.master); ng.connect(audio.fx);
    src.start(t); src.stop(t+2.1);
    // Yukarı süzülen parıltı
    const sh = ctx.createBufferSource(); sh.buffer = audio.noiseBuf;
    const hf = ctx.createBiquadFilter(); hf.type='highpass';
    hf.frequency.setValueAtTime(900, t);
    hf.frequency.exponentialRampToValueAtTime(7800, t+1.7);
    const sg2 = ctx.createGain();
    sg2.gain.setValueAtTime(0.14, t);
    sg2.gain.exponentialRampToValueAtTime(0.001, t+1.8);
    sh.connect(hf); hf.connect(sg2); sg2.connect(audio.fx);
    sh.start(t); sh.stop(t+1.9);
  } else {
    // Çıkış: ters whoosh + gümleme
    const src = ctx.createBufferSource(); src.buffer = audio.noiseBuf;
    const f = ctx.createBiquadFilter(); f.type='lowpass';
    f.frequency.setValueAtTime(140, t);
    f.frequency.exponentialRampToValueAtTime(4600, t+0.75);
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.55, t);
    ng.gain.exponentialRampToValueAtTime(0.001, t+0.85);
    src.connect(f); f.connect(ng); ng.connect(audio.master); ng.connect(audio.fx);
    src.start(t); src.stop(t+0.9);
    thud(1);
  }
}

/* --- Sürekli katman güncellemesi --- */
function updateAudio() {
  if (!audio.ctx) return;
  const t = audio.ctx.currentTime;
  if (S.crashed) {
    audio.eng.gain.setTargetAtTime(0, t, 0.1);
    audio.warpDrone.gain.setTargetAtTime(0, t, 0.15);
    audio.rumble.gain.setTargetAtTime(0, t, 0.2);
    audio.crackle.gain.setTargetAtTime(0, t, 0.1);
    audio.noise.gain.setTargetAtTime(0, t, 0.3);
    return;
  }
  const pw = S.pwr === 3 ? 1 : S.pwr === 2 ? Math.min(1, S.pwrT / 2.6) * 0.55 : 0;
  const sp = S.throttle * pw;
  const base = 31 + sp*98 + (S.ab ? 16 : 0) + S.od*55 + Math.min(42, S.vel.length()*0.05);
  audio.o1.frequency.setTargetAtTime(base, t, 0.35);
  audio.o2.frequency.setTargetAtTime(base*1.013, t, 0.35);
  audio.o3.frequency.setTargetAtTime(base*1.56, t, 0.35);
  audio.sub.frequency.setTargetAtTime(14 + base*0.5, t, 0.4);
  audio.engLp.frequency.setTargetAtTime(230 + sp*1500 + (S.ab?700:0), t, 0.35);
  // Uzayda motor sesi gövdeden iletilir: biraz kısılır
  const medium = 0.4 + 0.6*Math.min(1, S.atmDens*2);
  audio.eng.gain.setTargetAtTime((0.055*pw + sp*0.23 + (S.ab?0.11:0) + S.od*0.14) * medium, t, 0.25);
  audio.crackle.gain.setTargetAtTime(S.ab ? 0.20 + Math.random()*0.06 : 0, t, 0.12);
  // Türbin ıslığı: gaz + hız + overdrive ile tizleşir
  audio.wh1.frequency.setTargetAtTime(680 + sp*2100 + S.od*900, t, 0.35);
  audio.wh2.frequency.setTargetAtTime(1360 + sp*4100 + S.od*1700, t, 0.35);
  audio.whBp.frequency.setTargetAtTime(1400 + sp*2600, t, 0.35);
  audio.whine.gain.setTargetAtTime((sp*0.055 + (S.ab ? 0.035 : 0) + S.od*0.04 + (S.pwr>=2?0.008:0)) * medium * Math.max(0.2,pw), t, 0.3);
  // Spool: gaz artış hızına göre hava emişi kabarır
  const thrRate = Math.max(0, sp - audio.pThr) * 60;
  audio.pThr += (sp - audio.pThr) * 0.12;
  audio.spool.gain.setTargetAtTime(Math.min(0.22, thrRate * 0.5) * medium, t, 0.08);
  audio.splBp.frequency.setTargetAtTime(800 + sp*1600, t, 0.2);
  // AB ateşleme anı: BANG
  if (S.ab && !audio.pAb) abIgnite();
  audio.pAb = S.ab;
  // Overdrive kademeleri: %50 ve %100'de çan
  if (S.od > 0.5 && !audio.odMk1) { audio.odMk1 = true; odChime(620); }
  if (S.od >= 0.98 && !audio.odMk2) { audio.odMk2 = true; odChime(930); }
  if (S.od < 0.3) { audio.odMk1 = false; audio.odMk2 = false; }
  const windAmt = Math.min(1, S.ias/450) * Math.min(1, S.atmDens*1.4);
  audio.noise.gain.setTargetAtTime(0.02 + windAmt*0.16 + sp*0.04, t, 0.3);
  audio.nFilt.frequency.setTargetAtTime(550 + windAmt*2200, t, 0.3);
  // Gövde gürlemesi: ısınma + yoğun havada aşırı hız
  audio.rumble.gain.setTargetAtTime(S.heat*0.55 + Math.min(0.12, windAmt*0.12), t, 0.25);
  // Kara delik uğultusu: yaklaştıkça kabarır, sekans sırasında perde düşer
  const bhProx = Math.max(0, 1 - (S._bhD || 1e9) / 24000);
  audio.bhDrone.gain.setTargetAtTime(bhProx * 0.35 + (S.bhSeq ? 0.4 : 0), t, 0.4);
  if (S.bhSeq) audio.bhOsc.frequency.setTargetAtTime(27 - (1 - S.bhSeq/7.5) * 14, t, 0.6);
  // Warp drone'u
  if (S.warp === 'charge') {
    audio.warpDrone.gain.setTargetAtTime(0.05 + S.warpT*0.07, t, 0.15);
    audio.wdLp.frequency.setTargetAtTime(280 + S.warpT*260, t, 0.2);
  } else if (S.warp === 'jump') {
    audio.warpDrone.gain.setTargetAtTime(0.34, t, 0.4);
    audio.wdLp.frequency.setTargetAtTime(320 + (S.warpSpeed/26000)*1100, t, 0.5);
    audio.wd1.frequency.setTargetAtTime(58 + (S.warpSpeed/26000)*30, t, 0.6);
    audio.wd2.frequency.setTargetAtTime((58 + (S.warpSpeed/26000)*30)*1.009, t, 0.6);
  } else {
    audio.warpDrone.gain.setTargetAtTime(0, t, 0.3);
  }
  // Stall kornası
  if (S._stalled && t - audio.lastBeep > 0.42) { audio.lastBeep = t; beepStall(); }
  // Aşırı hız alarmı: sayaç ilerledikçe sıklaşır
  if (S.odT > 0.05 && t - audio.lastBeep > Math.max(0.12, 0.5 - S.odT * 0.075)) {
    audio.lastBeep = t;
    beepStall(980);
  }
  // RCS pufları (vakumda dönüş girdisi)
  if (S.atmDens < 0.05 && !S.onGround && S.warp === 'off' &&
      (Math.abs(stick.pitch)+Math.abs(stick.roll)+Math.abs(stick.yaw)) > 0.5 &&
      t - audio.lastPuff > 0.14) {
    audio.lastPuff = t;
    rcsPuff();
  }
}

/* ---------------- MFD EKRANLARI ---------------- */
function drawMfdAdi() {
  if (S.pwr === 0) {
    const cD = mfdAdi.ctx;
    cD.fillStyle = '#04060a'; cD.fillRect(0,0,256,256);
    cD.fillStyle = '#1a2a38'; cD.font = '13px Consolas, monospace'; cD.textAlign='center';
    cD.fillText('— GÜÇ YOK —', 128, 128);
    cD.textAlign='left';
    mfdAdi.tex.needsUpdate = true;
    return;
  }
  const c = mfdAdi.ctx;
  c.fillStyle = '#04070f'; c.fillRect(0,0,256,256);
  c.save();
  c.beginPath(); c.arc(128,120,88,0,Math.PI*2); c.clip();
  c.translate(128,120); c.rotate(S.roll);
  const py = S.pitch * 180/Math.PI * 2.2;
  c.fillStyle = '#1a3a6e'; c.fillRect(-140, -220+py, 280, 220);
  c.fillStyle = '#5a2438'; c.fillRect(-140, py, 280, 220);
  c.strokeStyle = '#dff'; c.lineWidth = 2;
  c.beginPath(); c.moveTo(-140,py); c.lineTo(140,py); c.stroke();
  c.font = '10px monospace'; c.fillStyle='#cde'; c.strokeStyle='#cde'; c.lineWidth=1;
  for (let d=-30; d<=30; d+=10) {
    if (d===0) continue;
    const y = py - d*2.2;
    c.beginPath(); c.moveTo(-26,y); c.lineTo(26,y); c.stroke();
    c.fillText(Math.abs(d), 32, y+3);
  }
  c.restore();
  c.strokeStyle = '#ffe066'; c.lineWidth = 3;
  c.beginPath(); c.moveTo(88,120); c.lineTo(114,120); c.lineTo(122,128);
  c.moveTo(168,120); c.lineTo(142,120); c.lineTo(134,128);
  c.stroke();
  c.beginPath(); c.arc(128,120,3,0,Math.PI*2); c.stroke();
  c.strokeStyle = '#2a4a6a'; c.lineWidth=2; c.beginPath(); c.arc(128,120,90,0,Math.PI*2); c.stroke();
  c.fillStyle = '#6ee7ff'; c.font = 'bold 12px monospace';
  c.fillText('ADI', 8, 16);
  c.font = '13px monospace';
  c.fillText(Math.round(S.ias) + ' kt', 8, 244);
  const altTxt = Math.round(S.alt*FT) + ' ft';
  c.fillText(altTxt, 248 - c.measureText(altTxt).width, 244);
  mfdAdi.tex.needsUpdate = true;
}
function drawMfdEng() {
  if (S.pwr === 0) {
    const cD = mfdEng.ctx;
    cD.fillStyle = '#04060a'; cD.fillRect(0,0,256,256);
    cD.fillStyle = '#1a2a38'; cD.font = '13px Consolas, monospace'; cD.textAlign='center';
    cD.fillText('— GÜÇ YOK —', 128, 128);
    cD.textAlign='left';
    mfdEng.tex.needsUpdate = true;
    return;
  }
  const c = mfdEng.ctx;
  c.fillStyle = '#04070f'; c.fillRect(0,0,256,256);
  c.fillStyle = '#6ee7ff'; c.font = 'bold 12px monospace';
  c.fillText('MOTOR / SİSTEM', 8, 16);
  const pow = S.throttle * (S.ab ? 1.18 : 1);
  for (let i=0;i<3;i++){
    const x = 34 + i*74;
    c.strokeStyle = '#2a4a6a'; c.strokeRect(x, 36, 30, 120);
    const h = Math.min(1,pow) * 118;
    const grad = c.createLinearGradient(0, 156-h, 0, 156);
    grad.addColorStop(0, S.ab ? '#c792ff' : '#6ee7ff');
    grad.addColorStop(1, '#1a4a6a');
    c.fillStyle = grad;
    c.fillRect(x+1, 155-h, 28, h);
    c.fillStyle = '#9ab'; c.font='10px monospace';
    c.fillText('M'+(i+1), x+8, 168);
  }
  c.fillStyle = S.ab ? '#c792ff' : '#7ea';
  c.font = 'bold 14px monospace';
  c.fillText(Math.round(S.throttle*100) + '%' + (S.ab ? ' +PLZ' : '') + (S.atmDens < 0.05 ? ' RCS' : ''), 84, 30);
  c.fillStyle = '#6ee7ff'; c.font='11px monospace';
  c.fillText('YAKIT', 8, 196);
  c.strokeStyle = '#2a4a6a'; c.strokeRect(60, 186, 180, 14);
  const fp = Math.max(0, S.fuel/fuelMax());
  c.fillStyle = fp < 0.15 ? '#ff5252' : '#6ee7ff';
  c.fillRect(61, 187, 178*fp, 12);
  c.font = '11px monospace';
  c.fillStyle = S.gearAnim > 0.95 ? '#66ffa8' : S.gearAnim < 0.05 ? '#ffcf5c' : '#ff5252';
  c.fillText('TAKIM ' + (S.gearAnim>0.95?'AÇIK':S.gearAnim<0.05?'KAPALI':'···'), 8, 222);
  c.fillStyle = '#6ee7ff';
  c.fillText('FLAP ' + AC.flapSteps[S.flapIdx] + '°', 130, 222);
  c.fillStyle = S.brake ? '#ff5252' : '#456';
  c.fillText('FREN', 200, 222);
  c.fillStyle = '#9ab';
  c.fillText('G ' + S.gForce.toFixed(1) + '  AoA ' + (S.aoa*180/Math.PI).toFixed(1) + '°  ATM ' + Math.round(S.atmDens*100) + '%', 8, 246);
  mfdEng.tex.needsUpdate = true;
}
function drawMfdNav() {
  if (S.pwr === 0) {
    const cD = mfdNav.ctx;
    cD.fillStyle = '#04060a'; cD.fillRect(0,0,256,256);
    cD.fillStyle = '#1a2a38'; cD.font = '13px Consolas, monospace'; cD.textAlign='center';
    cD.fillText('— GÜÇ YOK —', 128, 128);
    cD.textAlign='left';
    mfdNav.tex.needsUpdate = true;
    return;
  }
  const c = mfdNav.ctx;
  const tp = TARGETS[S.target];
  c.fillStyle = '#04070f'; c.fillRect(0,0,256,256);
  c.fillStyle = '#6ee7ff'; c.font = 'bold 12px monospace';
  c.fillText('NAV · ' + S.planet.name, 8, 16);
  c.save(); c.translate(128,128);
  c.strokeStyle='#2a4a6a'; c.lineWidth=2;
  c.beginPath(); c.arc(0,0,82,0,Math.PI*2); c.stroke();
  c.save(); c.rotate(-S.hdg*Math.PI/180);
  c.font='11px monospace'; c.fillStyle='#cde'; c.strokeStyle='#5a7a9a';
  for (let d=0; d<360; d+=30) {
    c.save(); c.rotate(d*Math.PI/180);
    c.beginPath(); c.moveTo(0,-82); c.lineTo(0,-74); c.stroke();
    const lbl = d===0?'K':d===90?'D':d===180?'G':d===270?'B':String(d/10);
    c.fillText(lbl, -c.measureText(lbl).width/2, -60);
    c.restore();
  }
  // Hedef gezegen yönü (yeşil ok)
  const dTo = tp.padWorld.clone().sub(S.pos);
  tangentFrame(S.upS);
  const brg = Math.atan2(dTo.dot(_east), dTo.dot(_north));
  c.save(); c.rotate(brg + Math.PI);
  c.fillStyle='#66ffa8';
  c.beginPath(); c.moveTo(0,70); c.lineTo(-6,56); c.lineTo(6,56); c.closePath(); c.fill();
  c.restore();
  c.restore();
  c.strokeStyle='#ffe066'; c.lineWidth=2.5;
  c.beginPath(); c.moveTo(0,-14); c.lineTo(-9,10); c.lineTo(0,4); c.lineTo(9,10); c.closePath(); c.stroke();
  c.restore();
  const dist = S.pos.distanceTo(tp.padWorld)/1000;
  c.fillStyle='#66ffa8'; c.font='12px monospace';
  c.fillText('▸ ' + tp.name, 8, 226);
  c.fillText(dist.toFixed(1) + ' km', 8, 242);
  c.fillStyle='#6ee7ff';
  c.fillText('HDG ' + String(Math.round(S.hdg)||360).padStart(3,'0') + '°', 168, 242);
  mfdNav.tex.needsUpdate = true;
}

/* ---------------- YER TOZ EFEKTİ & LASTİK SESİ ---------------- */
const activeFx = [];
function spawnTouchFx(strength) {
  const n = 60 + Math.floor(strength*80);
  const pos = new Float32Array(n*3);
  const vel = [];
  const up = S.upS.clone();
  const side = new THREE.Vector3(1,0,0).applyQuaternion(S.quat);
  for (let i=0;i<n;i++){
    pos[i*3]=S.pos.x; pos[i*3+1]=S.pos.y-1.8; pos[i*3+2]=S.pos.z;
    const v = side.clone().multiplyScalar((Math.random()-0.5)*16)
      .addScaledVector(up, Math.random()*7*(0.5+strength))
      .addScaledVector(S.vel, 0.25*Math.random());
    vel.push(v);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  const col = new THREE.Color(S.planet.cols[1]).lerp(new THREE.Color(0xffffff), 0.25);
  const pts = new THREE.Points(g, new THREE.PointsMaterial({ color:col, size:1.6, transparent:true, opacity:0.75, depthWrite:false }));
  pts.userData = { vel, life: 1.4, up };
  scene.add(pts);
  activeFx.push(pts);
}
function updateFx(dt) {
  for (let i=activeFx.length-1; i>=0; i--) {
    const fx = activeFx[i], u = fx.userData;
    u.life -= dt;
    const pAttr = fx.geometry.attributes.position;
    for (let j=0;j<u.vel.length;j++){
      u.vel[j].addScaledVector(u.up, -9*dt);
      u.vel[j].multiplyScalar(1 - 1.4*dt);
      pAttr.setXYZ(j, pAttr.getX(j)+u.vel[j].x*dt, pAttr.getY(j)+u.vel[j].y*dt, pAttr.getZ(j)+u.vel[j].z*dt);
    }
    pAttr.needsUpdate = true;
    fx.material.opacity = Math.max(0, u.life/1.4) * 0.75;
    if (u.life <= 0) { scene.remove(fx); activeFx.splice(i,1); }
  }
}


/* ---------------- KOKPİT YARDIMCI EKRANLARI ---------------- */
function drawAnnunciator() {
  const c = _annCv.getContext('2d');
  c.fillStyle = '#0a0c12'; c.fillRect(0,0,256,96);
  const cells = [
    ['TAKIM', S.gearAnim>0.95 ? '#2a8a4a' : S.gearAnim<0.05 ? '#333' : '#c8a020'],
    ['FLAP', S.flapIdx>0 ? '#2a8a4a' : '#333'],
    ['STALL', S._stalled ? '#d02030' : '#333'],
    ['YAKIT', S.fuel/fuelMax()<0.15 ? '#d02030' : '#333'],
    ['RCS', S.atmDens<0.05 ? '#2a6ac0' : '#333'],
    ['WARP', S.warp!=='off' ? '#8a4ad0' : '#333'],
    ['ISI', S.heat>0.25 ? (S.heat>0.6?'#d02030':'#c8a020') : '#333'],
    ['G-LIM', Math.abs(S.gForce)>8 ? '#d02030' : '#333']
  ];
  c.font = 'bold 13px Consolas, monospace'; c.textAlign='center'; c.textBaseline='middle';
  for (let i=0;i<8;i++){
    const x = 6 + (i%4)*62, y = 8 + Math.floor(i/4)*44;
    c.fillStyle = cells[i][1];
    c.fillRect(x, y, 56, 36);
    c.strokeStyle = '#1c2230'; c.strokeRect(x, y, 56, 36);
    c.fillStyle = cells[i][1] === '#333' ? '#555' : '#fff';
    c.fillText(cells[i][0], x+28, y+19);
  }
  _annTex.needsUpdate = true;
}
function drawDial(cv, tex, def, value) {
  const c = cv.getContext('2d');
  // Zemin: hafif vinyetli koyu kadran
  const bg = c.createRadialGradient(64,60,10,64,64,64);
  bg.addColorStop(0,'#12151d'); bg.addColorStop(1,'#07080d');
  c.fillStyle = bg; c.beginPath(); c.arc(64,64,63,0,Math.PI*2); c.fill();
  c.strokeStyle = '#2a3648'; c.lineWidth = 2;
  c.beginPath(); c.arc(64,64,60,0,Math.PI*2); c.stroke();
  const a0 = Math.PI*0.75, a1 = Math.PI*2.25, range = def.max - def.min;
  // Kırmızı bölge yayları
  c.lineWidth = 5;
  if (def.redHi > 0) {
    c.strokeStyle = 'rgba(210,40,60,0.85)';
    c.beginPath(); c.arc(64,64,54, a0+(a1-a0)*def.redHi, a1); c.stroke();
  }
  if (def.redLo > 0) {
    c.strokeStyle = 'rgba(210,40,60,0.85)';
    c.beginPath(); c.arc(64,64,54, a0, a0+(a1-a0)*def.redLo); c.stroke();
  }
  // Kadran çizgileri + rakamlar
  for (let i=0;i<=10;i++){
    const a = a0 + (a1-a0)*i/10;
    const big = i%2===0;
    const inRed = (def.redHi>0 && i/10>=def.redHi) || (def.redLo>0 && i/10<=def.redLo);
    c.strokeStyle = inRed ? '#e05060' : '#9fb8d0';
    c.lineWidth = big?2.6:1.2;
    c.beginPath();
    c.moveTo(64+Math.cos(a)*52, 64+Math.sin(a)*52);
    c.lineTo(64+Math.cos(a)*(big?43:47), 64+Math.sin(a)*(big?43:47));
    c.stroke();
    if (big) {
      let tv = def.min + range*i/10;
      let lbl = Math.abs(def.max) >= 10000 ? String(Math.round(tv/1000)) : String(Math.round(tv));
      c.fillStyle = inRed ? '#e05060' : '#9fb8d0';
      c.font = '9px Consolas, monospace'; c.textAlign='center';
      c.fillText(lbl, 64+Math.cos(a)*33, 64+Math.sin(a)*33+3);
    }
  }
  // İbre (parlak, gölgeli — araba deviri hissi)
  const frac = Math.max(0, Math.min(1, (value-def.min)/range));
  const na = a0 + (a1-a0)*frac;
  c.save();
  c.shadowColor = '#ffe066'; c.shadowBlur = 7;
  c.strokeStyle = '#ffe066'; c.lineWidth = 3.2; c.lineCap='round';
  c.beginPath(); c.moveTo(64-Math.cos(na)*8, 64-Math.sin(na)*8);
  c.lineTo(64+Math.cos(na)*49, 64+Math.sin(na)*49); c.stroke();
  c.restore();
  c.fillStyle = '#1a1e28'; c.beginPath(); c.arc(64,64,6.5,0,Math.PI*2); c.fill();
  c.strokeStyle = '#ffe066'; c.lineWidth=1.4; c.beginPath(); c.arc(64,64,6.5,0,Math.PI*2); c.stroke();
  // Dijital değer + etiket
  let vs;
  if (Math.abs(def.max) >= 10000) vs = (value/1000).toFixed(1) + 'k';
  else if (def.label === 'G') vs = value.toFixed(1);
  else vs = String(Math.round(value));
  c.fillStyle = '#6ee7ff'; c.font = 'bold 12px Consolas, monospace'; c.textAlign='center';
  c.fillText(vs, 64, 92);
  c.fillStyle = '#7a94ac'; c.font = '9px Consolas, monospace';
  c.fillText(def.label + ' · ' + def.unit, 64, 106);
  tex.needsUpdate = true;
}
function drawCombinerHud() {
  const c = _chudCv.getContext('2d');
  const W = 512, H = 384, cx = 256, cy = 196;
  c.clearRect(0, 0, W, H);
  c.strokeStyle = 'rgba(125,235,255,0.95)'; c.fillStyle = 'rgba(125,235,255,0.95)';
  c.lineWidth = 1.8; c.font = '15px Consolas, monospace';
  c.shadowColor = 'rgba(90,220,255,0.8)'; c.shadowBlur = 4;

  if (S.warp === 'jump') {
    c.font = 'bold 26px Consolas, monospace'; c.textAlign = 'center';
    c.fillText('⚡ WARP AKTİF', cx, cy - 10);
    c.font = '17px Consolas, monospace';
    c.fillText((S.warpSpeed/299.8).toFixed(1) + ' ‰c', cx, cy + 22);
    c.textAlign = 'left';
    _chudTex.needsUpdate = true;
    return;
  }

  if (S.pwr < 3) {
    c.textAlign = 'center';
    c.fillStyle = 'rgba(255,190,90,0.95)';
    c.font = 'bold 24px Consolas, monospace';
    c.fillText(S.pwr === 0 ? 'SOĞUK KOKPİT' : S.pwr === 1 ? 'GÜÇ AÇIK' : 'ATEŞLEME %' + Math.round(Math.min(1, S.pwrT/2.6)*100), cx, 116);
    c.font = '15px Consolas, monospace';
    c.fillStyle = 'rgba(125,235,255,0.92)';
    c.fillText(S.pwr === 0 ? '▶ [ I ] ANA GÜCÜ AÇ' : S.pwr === 1 ? '▶ [ I ] MOTORLARI ATEŞLE' : 'türbinler dönüyor...', cx, 146);
    c.textAlign = 'left';
  }
  const pitchDeg = S.pitch * 180 / Math.PI;
  const pxd = 5.0;

  /* Pitch merdiveni */
  c.save();
  c.translate(cx, cy);
  c.rotate(S.roll);
  c.beginPath(); c.rect(-150, -125, 300, 250); c.clip();
  c.translate(0, pitchDeg * pxd);
  for (let d = -90; d <= 90; d += 5) {
    const y = -d * pxd;
    if (d === 0) {
      c.lineWidth = 2.2;
      c.beginPath(); c.moveTo(-140, 0); c.lineTo(-30, 0); c.moveTo(30, 0); c.lineTo(140, 0); c.stroke();
      c.lineWidth = 1.8;
    } else if (d % 10 === 0) {
      c.setLineDash(d < 0 ? [6, 4] : []);
      c.beginPath(); c.moveTo(-52, y); c.lineTo(-18, y); c.moveTo(18, y); c.lineTo(52, y); c.stroke();
      c.setLineDash([]);
      c.font = '11px Consolas, monospace';
      c.fillText(Math.abs(d), -70, y + 4); c.fillText(Math.abs(d), 58, y + 4);
      c.font = '15px Consolas, monospace';
    }
  }
  c.restore();

  /* Su hattı sembolü */
  c.lineWidth = 2.4;
  c.beginPath();
  c.moveTo(cx - 26, cy); c.lineTo(cx - 9, cy); c.lineTo(cx - 4, cy + 6);
  c.moveTo(cx + 26, cy); c.lineTo(cx + 9, cy); c.lineTo(cx + 4, cy + 6);
  c.moveTo(cx, cy - 3); c.lineTo(cx, cy + 3);
  c.stroke(); c.lineWidth = 1.8;

  /* Uçuş yolu işareti */
  const vl = S.vel.clone().applyQuaternion(S.quat.clone().invert());
  if (vl.z > 2) {
    const fx = Math.atan2(vl.x, vl.z) * 180/Math.PI * pxd;
    const fy = -Math.atan2(vl.y, Math.hypot(vl.x, vl.z)) * 180/Math.PI * pxd;
    c.save(); c.translate(cx, cy); c.rotate(S.roll);
    c.translate(Math.max(-130, Math.min(130, fx)), Math.max(-115, Math.min(115, fy + pitchDeg * pxd)));
    c.beginPath(); c.arc(0, 0, 6, 0, Math.PI*2);
    c.moveTo(-12, 0); c.lineTo(-6, 0); c.moveTo(6, 0); c.lineTo(12, 0);
    c.moveTo(0, -10); c.lineTo(0, -6);
    c.stroke(); c.restore();
  }

  /* İstikamet bandı (üst) */
  c.save(); c.translate(cx, 26);
  c.beginPath(); c.rect(-130, -14, 260, 28); c.clip();
  c.font = '12px Consolas, monospace';
  for (let d = -50; d <= 50; d += 5) {
    let h = Math.round((S.hdg + d) / 5) * 5;
    const x = (h - S.hdg) * 2.5;
    h = ((h % 360) + 360) % 360;
    c.beginPath(); c.moveTo(x, 10); c.lineTo(x, h % 10 === 0 ? 2 : 6); c.stroke();
    if (h % 30 === 0) {
      const lbl = h === 0 ? 'K' : h === 90 ? 'D' : h === 180 ? 'G' : h === 270 ? 'B' : String(h/10);
      c.textAlign = 'center'; c.fillText(lbl, x, -2); c.textAlign = 'left';
    }
  }
  c.restore();
  c.beginPath(); c.moveTo(cx, 40); c.lineTo(cx - 5, 47); c.lineTo(cx + 5, 47); c.closePath(); c.fill();

  /* Hız kutusu (sol) */
  c.strokeRect(14, cy - 16, 86, 32);
  c.font = 'bold 21px Consolas, monospace'; c.textAlign = 'right';
  c.fillText(Math.round(S.ias), 92, cy + 8);
  c.font = '12px Consolas, monospace'; c.textAlign = 'left';
  c.fillText('M ' + Math.max(0, S.mach).toFixed(2), 16, cy + 34);
  c.fillText('G ' + S.gForce.toFixed(1), 16, cy + 52);
  /* İrtifa kutusu (sağ) */
  c.strokeRect(W - 112, cy - 16, 98, 32);
  c.font = 'bold 21px Consolas, monospace'; c.textAlign = 'right';
  c.fillText(Math.round(S.alt * FT).toLocaleString('tr-TR'), W - 20, cy + 8);
  c.font = '12px Consolas, monospace';
  c.fillText('RAD ' + Math.max(0, Math.round(S.agl * FT)), W - 16, cy + 34);
  const vN = S.vel.dot(S.upS);
  c.fillText('V/S ' + (vN >= 0 ? '+' : '') + Math.round(vN * FT * 60), W - 16, cy + 52);
  c.textAlign = 'left';

  /* Üst köşe: kredi + görev */
  c.font = '12px Consolas, monospace';
  c.fillStyle = 'rgba(255,207,92,0.95)';
  c.fillText('₵ ' + S.credits, 16, 22);
  if (S.mission) {
    c.fillStyle = 'rgba(158,203,255,0.9)';
    c.fillText('📦 ' + S.mission.to.name + ' · ' + S.mission.reward, 16, 40);
  }
  c.fillStyle = 'rgba(125,235,255,0.95)';
  /* Alt satır: güç + hedef + mod etiketleri */
  c.font = '13px Consolas, monospace';
  c.fillText('GÜÇ %' + Math.round(S.throttle * 100) + (S.ab ? '  PLZ×' + (1 + S.od * 5).toFixed(1) : ''), 16, H - 14);
  const tp2 = TARGETS[S.target];
  c.textAlign = 'right';
  c.fillText('▸' + tp2.name + ' ' + (S.pos.distanceTo(tp2.padWorld) / 1000).toFixed(0) + 'km', W - 16, H - 14);
  c.textAlign = 'center';
  let tags = [];
  if (S.vtol) tags.push('▲VTOL');
  if (S.dockAP) tags.push('AP-YANAŞ');
  if (S.launchHold) tags.push('RAMPA');
  if (tags.length) { c.fillStyle = 'rgba(200,150,255,0.95)'; c.fillText(tags.join(' · '), cx, H - 14); c.fillStyle = 'rgba(125,235,255,0.95)'; }

  /* STALL uyarısı */
  if (S._stalled && (performance.now() % 440 < 240)) {
    c.fillStyle = 'rgba(255,70,60,0.95)';
    c.font = 'bold 24px Consolas, monospace';
    c.fillText('■ STALL ■', cx, 84);
    c.fillStyle = 'rgba(125,235,255,0.95)';
  }

  /* ILS mini (yaklaşmada) */
  if (!S.onGround && S.warp === 'off') {
    const lp = S.pos.clone().sub(tp2.padWorld);
    const dXZ = Math.hypot(lp.x, lp.z);
    if (dXZ < 20000 && dXZ > 300 && lp.y < 3800 && lp.y > -500) {
      const loc = Math.max(-1, Math.min(1, lp.x / 700));
      const gs = Math.max(-1, Math.min(1, (lp.y - dXZ * 0.061) / 400));
      c.strokeStyle = 'rgba(110,255,170,0.9)'; c.fillStyle = 'rgba(110,255,170,0.9)';
      c.beginPath(); c.moveTo(W - 34, cy - 55); c.lineTo(W - 34, cy + 55); c.stroke();
      for (const t of [-55, -27, 0, 27, 55]) { c.beginPath(); c.moveTo(W-38, cy+t); c.lineTo(W-30, cy+t); c.stroke(); }
      c.save(); c.translate(W - 34, cy + gs * 52);
      c.beginPath(); c.moveTo(0,-5); c.lineTo(5,0); c.lineTo(0,5); c.lineTo(-5,0); c.closePath(); c.fill(); c.restore();
      c.beginPath(); c.moveTo(cx - 55, H - 44); c.lineTo(cx + 55, H - 44); c.stroke();
      for (const t of [-55, -27, 0, 27, 55]) { c.beginPath(); c.moveTo(cx+t, H-48); c.lineTo(cx+t, H-40); c.stroke(); }
      c.save(); c.translate(cx + loc * 52, H - 44);
      c.beginPath(); c.moveTo(0,-5); c.lineTo(5,0); c.lineTo(0,5); c.lineTo(-5,0); c.closePath(); c.fill(); c.restore();
      c.font = '11px Consolas, monospace';
      c.fillText('ILS', cx - 78, H - 40);
      c.strokeStyle = 'rgba(125,235,255,0.95)'; c.fillStyle = 'rgba(125,235,255,0.95)';
    }
  }
  c.textAlign = 'left';
  _chudTex.needsUpdate = true;
}
function drawTechScreens() {
  for (const ts of _techScr) {
    const c = ts.cv.getContext('2d');
    c.fillStyle = '#050a12'; c.fillRect(0, 0, 128, 160);
    c.strokeStyle = '#123048'; c.strokeRect(1, 1, 126, 158);
    // Akan sistem verisi satırları
    if (Math.random() < 0.5 || ts.lines.length === 0) {
      const tags = ts.side < 0
        ? ['PWR', 'THR', 'FUE', 'HYD', 'RCS', 'ECS']
        : ['NAV', 'COM', 'SNS', 'SHD', 'TGT', 'LNK'];
      ts.lines.unshift(tags[(Math.random()*tags.length)|0] + ' ' +
        ((Math.random()*255)|0).toString(16).padStart(2,'0').toUpperCase() + ':' +
        ((Math.random()*65535)|0).toString(16).padStart(4,'0').toUpperCase() +
        (Math.random() < 0.15 ? ' ✓' : ''));
      if (ts.lines.length > 11) ts.lines.pop();
    }
    c.font = '10px Consolas, monospace';
    for (let i = 0; i < ts.lines.length; i++) {
      c.fillStyle = i === 0 ? '#7de5ff' : 'rgba(60,140,180,' + (1 - i * 0.08).toFixed(2) + ')';
      c.fillText(ts.lines[i], 8, 20 + i * 13);
    }
    // Alt: mini çubuk grafiği
    c.fillStyle = '#1a4a5e';
    for (let b = 0; b < 8; b++) {
      const bh = 4 + Math.random() * 14;
      c.fillRect(10 + b * 14, 152 - bh, 9, bh);
    }
    ts.tex.needsUpdate = true;
  }
}
function drawAux() {
  drawAnnunciator();
  drawTechScreens();
  const vN = S.vel.dot(S.upS);
  let vals = [
    S.ias,
    S.alt * FT,
    vN * FT * 60,
    S.throttle * 100 * (S.ab ? 1.1 : 1),
    Math.max(0, S.fuel/fuelMax()*100),
    S.gForce,
    S.heat * 100
  ];
  if (S.pwr === 0) vals = _dials.map(d => d.def.min);
  for (let i=0;i<_dials.length;i++) drawDial(_dials[i].cv, _dials[i].tex, _dials[i].def, vals[i]);
  drawPedScreen();
}
function drawPedScreen() {
  const c = _pedCv.getContext('2d');
  c.fillStyle = '#060a12'; c.fillRect(0,0,192,128);
  c.strokeStyle = '#1e3048'; c.strokeRect(2,2,188,124);
  if (S.pwr < 3) {
    c.font = 'bold 12px Consolas, monospace'; c.fillStyle = '#ffcf5c';
    c.fillText('BAŞLATMA LİSTESİ', 10, 20);
    c.font = '12px Consolas, monospace';
    c.fillStyle = S.pwr >= 1 ? '#66ffa8' : '#8899aa';
    c.fillText((S.pwr >= 1 ? '[✓]' : '[ ]') + ' ANA GÜÇ ........ I', 10, 46);
    c.fillStyle = S.pwr >= 2 ? '#66ffa8' : '#8899aa';
    c.fillText((S.pwr >= 3 ? '[✓]' : S.pwr === 2 ? '[%' + Math.round(Math.min(1,S.pwrT/2.6)*100) + ']' : '[ ]') + ' ATEŞLEME ...... I', 10, 68);
    c.fillStyle = '#8899aa';
    c.fillText('[ ] GAZ + FLAP + KALK', 10, 90);
    c.fillStyle = '#40566e'; c.font = '9px Consolas, monospace';
    c.fillText('L: iniş farı · G: takım', 10, 116);
    _pedTex.needsUpdate = true;
    return;
  }
  const tp = TARGETS[S.target];
  c.font = 'bold 12px Consolas, monospace'; c.textAlign='left';
  c.fillStyle = '#c792ff';
  c.fillText('WARP SÜRÜCÜSÜ', 10, 20);
  c.fillStyle = '#6ee7ff'; c.font='11px Consolas, monospace';
  c.fillText('HEDEF: ' + tp.name, 10, 42);
  c.fillText('MESAFE: ' + (S.pos.distanceTo(tp.padWorld)/1000).toFixed(1) + ' km', 10, 58);
  if (S.warp === 'charge') {
    c.fillStyle = '#c8a020';
    c.fillText('ŞARJ...', 10, 82);
    c.strokeStyle = '#8a4ad0'; c.strokeRect(10, 90, 172, 16);
    c.fillStyle = '#8a4ad0';
    c.fillRect(11, 91, 170*Math.min(1, S.warpT/warpChargeT()), 14);
  } else if (S.warp === 'jump') {
    c.fillStyle = '#c792ff';
    c.fillText('⚡ AKTİF — ' + (S.warpSpeed/299.8).toFixed(1) + '‰c', 10, 82);
  } else {
    const ready = !S.onGround && S.agl > 900;
    c.fillStyle = ready ? '#2a8a4a' : '#555';
    c.fillText(ready ? 'HAZIR — [J]' : 'BEKLEMEDE (min 3000ft)', 10, 82);
  }
  c.fillStyle = '#40566e'; c.font='9px Consolas, monospace';
  c.fillText('N: hedef değiştir · M: harita', 10, 118);
  _pedTex.needsUpdate = true;
}


/* ---------------- SİSTEM HARİTASI ---------------- */
const mapCv = document.getElementById('mapCanvas');
const mctx = mapCv.getContext('2d');
function sizeMap() {
  const s = Math.min(innerWidth, innerHeight) * 0.95;
  mapCv.width = Math.min(innerWidth * 0.96, s * 1.45); mapCv.height = s;
}
let _mapXform = null;
mapCv.style.cursor = 'crosshair';
mapCv.addEventListener('click', ev => {
  if (!_mapXform || S.crashed) return;
  const r = mapCv.getBoundingClientRect();
  const mx = (ev.clientX - r.left) * (mapCv.width / r.width);
  const my = (ev.clientY - r.top) * (mapCv.height / r.height);
  let best = -1, bd = 1e9;
  TARGETS.forEach((p, i) => {
    const px = _mapXform.cx + p.center.x * _mapXform.scale;
    const py = _mapXform.cy + p.center.z * _mapXform.scale;
    const rr = p.isStation ? 26 : Math.max(20, Math.sqrt(p.radius) * _mapXform.scale * 46 + 10);
    const d = Math.hypot(mx - px, my - py);
    if (d < rr && d < bd) { bd = d; best = i; }
  });
  if (best < 0) return;
  if (S.target === best) {
    // Seçili hedefe ikinci tıklama: warp'ı ateşle
    tryWarp();
    if (S.warp === 'charge') {
      mapOpen = false;
      document.getElementById('mapOverlay').style.display = 'none';
    }
  } else {
    S.target = best;
    flash('HEDEF: ' + PLANETS[best].name + ' — tekrar tıkla = WARP');
    drawMap();
  }
});
function drawMap() {
  const W = mapCv.width, H = mapCv.height;
  mctx.clearRect(0,0,W,H);
  // Sistem sınırları
  let maxR = 10000;
  for (const p of PLANETS) maxR = Math.max(maxR, Math.abs(p.center.x)+p.radius, Math.abs(p.center.z)+p.radius);
  maxR = Math.max(maxR, Math.abs(S.pos.x), Math.abs(S.pos.z)) * 1.15;
  const scale = Math.min(W, H) / 2 / maxR;
  const cx = W/2, cy = H/2;
  _mapXform = { scale, cx, cy };
  const px = v => cx + v.x*scale, py = v => cy + v.z*scale;
  // Izgara halkaları
  mctx.strokeStyle = 'rgba(110,231,255,0.08)'; mctx.lineWidth = 1;
  for (let r=20000; r<maxR; r+=20000) {
    mctx.beginPath(); mctx.arc(cx, cy, r*scale, 0, Math.PI*2); mctx.stroke();
  }
  mctx.strokeStyle = 'rgba(110,231,255,0.12)';
  mctx.beginPath(); mctx.moveTo(cx,0); mctx.lineTo(cx,H); mctx.moveTo(0,cy); mctx.lineTo(W,cy); mctx.stroke();
  // Hedef çizgisi
  const tp = TARGETS[S.target];
  mctx.strokeStyle = 'rgba(102,255,168,0.5)'; mctx.setLineDash([6,6]);
  mctx.beginPath(); mctx.moveTo(px(S.pos), py(S.pos)); mctx.lineTo(px(tp.center), py(tp.center)); mctx.stroke();
  mctx.setLineDash([]);
  // Gezegenler
  mctx.font = '12px Consolas, monospace'; mctx.textAlign = 'center';
  for (const p of PLANETS) {
    const r = Math.max(7, Math.sqrt(p.radius)*scale*46);
    const col = '#' + new THREE.Color(p.cols[2]).getHexString();
    const grd = mctx.createRadialGradient(px(p.center)-r*0.3, py(p.center)-r*0.3, r*0.15, px(p.center), py(p.center), r);
    grd.addColorStop(0, col);
    grd.addColorStop(1, '#' + new THREE.Color(p.cols[0]).getHexString());
    mctx.fillStyle = grd;
    mctx.beginPath(); mctx.arc(px(p.center), py(p.center), r, 0, Math.PI*2); mctx.fill();
    if (p === tp) {
      mctx.strokeStyle = '#66ffa8'; mctx.lineWidth = 2;
      mctx.beginPath(); mctx.arc(px(p.center), py(p.center), r+6, 0, Math.PI*2); mctx.stroke();
    }
    if (p === S.planet) {
      mctx.strokeStyle = 'rgba(110,231,255,0.6)'; mctx.lineWidth = 1;
      mctx.beginPath(); mctx.arc(px(p.center), py(p.center), r+11, 0, Math.PI*2); mctx.stroke();
    }
    mctx.fillStyle = '#bfefff'; mctx.shadowColor = '#66e7ff'; mctx.shadowBlur = 8;
    mctx.fillText(p.name, px(p.center), py(p.center) - r - 10);
    mctx.shadowBlur = 0;
    mctx.fillStyle = 'rgba(140,180,210,0.75)'; mctx.font = '10px Consolas, monospace';
    mctx.fillText((S.pos.distanceTo(p.center)/1000).toFixed(0) + ' km', px(p.center), py(p.center) + r + 14);
    mctx.font = '12px Consolas, monospace';
  }
  // İstasyonlar (elmas ikon)
  for (const st of STATIONS) {
    const sx2 = px(st.center), sy2 = py(st.center);
    mctx.save(); mctx.translate(sx2, sy2); mctx.rotate(Math.PI/4);
    mctx.fillStyle = 'rgba(80,220,160,0.9)'; mctx.shadowColor = '#50dca0'; mctx.shadowBlur = 8;
    mctx.fillRect(-6, -6, 12, 12);
    mctx.restore(); mctx.shadowBlur = 0;
    if (TARGETS[S.target] === st) {
      mctx.strokeStyle = '#66ffa8'; mctx.lineWidth = 2;
      mctx.beginPath(); mctx.arc(sx2, sy2, 13, 0, Math.PI*2); mctx.stroke();
    }
    mctx.fillStyle = '#aef5d5'; mctx.font = '11px Consolas, monospace'; mctx.textAlign='center';
    mctx.fillText('⛽ ' + st.name, sx2, sy2 - 14);
    mctx.fillStyle = 'rgba(140,200,180,0.7)'; mctx.font = '9px Consolas, monospace';
    mctx.fillText((S.pos.distanceTo(st.center)/1000).toFixed(0) + ' km', sx2, sy2 + 20);
    mctx.font = '12px Consolas, monospace';
  }
  // Kara delik (uyarılı)
  {
    const bx2 = px(BH.center), by2 = py(BH.center);
    const bg2 = mctx.createRadialGradient(bx2, by2, 1, bx2, by2, 14);
    bg2.addColorStop(0, '#000'); bg2.addColorStop(0.6, '#3a1030'); bg2.addColorStop(1, 'rgba(255,150,80,0.5)');
    mctx.fillStyle = bg2;
    mctx.beginPath(); mctx.arc(bx2, by2, 14, 0, Math.PI*2); mctx.fill();
    if (TARGETS[S.target] === BH) { mctx.strokeStyle = '#ff8040'; mctx.lineWidth = 2; mctx.beginPath(); mctx.arc(bx2, by2, 19, 0, Math.PI*2); mctx.stroke(); }
    mctx.fillStyle = '#ffb090'; mctx.font = '11px Consolas, monospace'; mctx.textAlign = 'center';
    mctx.fillText('⚠ KARANLIK', bx2, by2 - 20);
    mctx.fillText((S.pos.distanceTo(BH.center)/1000).toFixed(0) + ' km', bx2, by2 + 26);
  }
  // Oyuncu (yön oklu)
  const fXZ = Math.atan2(_f.x, _f.z);
  mctx.save();
  mctx.translate(px(S.pos), py(S.pos));
  mctx.rotate(fXZ);
  mctx.fillStyle = '#ffe066'; mctx.shadowColor = '#ffe066'; mctx.shadowBlur = 10;
  mctx.beginPath(); mctx.moveTo(0,9); mctx.lineTo(-6,-7); mctx.lineTo(0,-3); mctx.lineTo(6,-7); mctx.closePath(); mctx.fill();
  mctx.restore(); mctx.shadowBlur = 0;
  // Bilgi
  mctx.textAlign = 'left';
  mctx.fillStyle = '#6ee7ff'; mctx.font = '12px Consolas, monospace';
  mctx.fillText('KONUM: ' + S.planet.name + (S.onGround ? ' (yerde)' : '  ALT ' + (S.alt/1000).toFixed(1) + ' km'), 14, H-38);
  mctx.fillStyle = '#66ffa8';
  mctx.fillText('HEDEF: ' + tp.name + ' — ' + (S.pos.distanceTo(tp.padWorld)/1000).toFixed(1) + ' km' + (S.warp==='jump' ? '  ⚡WARP' : ''), 14, H-22);
}

/* ---------------- HUD ---------------- */
const hudCv = document.getElementById('hudCanvas');
const hctx = hudCv.getContext('2d');
function sizeHud(){ hudCv.width=innerWidth; hudCv.height=innerHeight; }
sizeHud();

const $ = id => document.getElementById(id);
const el = {
  spd:$('spdVal'), mach:$('machVal'), alt:$('altVal'), radAlt:$('radAltVal'), hdg:$('hdgVal'),
  planetName:$('planetName'),
  thrPct:$('thrPct'), thrBar:$('thrBar'), abTag:$('abTag'), flap:$('flapVal'), gear:$('gearVal'),
  brk:$('brkVal'), fuelPct:$('fuelPct'), fuelBar:$('fuelBar'), vs:$('vsVal'), g:$('gVal'),
  aoa:$('aoaVal'), atm:$('atmVal'), tgt:$('tgtVal'),
  stall:$('stallWarn'), gearW:$('gearWarn'), overG:$('overGWarn'), msg:$('msg')
};
let msgTimer = null;
function updateHudVis() {
  const cp = camMode === 0;
  for (const id of ['spdBox','altBox','topInfo','leftPanel','rightPanel','ctrlPanel','helpHint','msnBox']) {
    const elx = document.getElementById(id);
    if (elx) elx.style.display = cp ? 'none' : '';
  }
}
function flash(text, warn) {
  el.msg.textContent = text;
  el.msg.style.color = warn ? '#ff8080' : '#dff';
  el.msg.style.opacity = 1;
  clearTimeout(msgTimer);
  msgTimer = setTimeout(()=> el.msg.style.opacity=0, 2600);
}

function drawHud() {
  hctx.clearRect(0,0,hudCv.width,hudCv.height);
  if (camMode === 2 || S.crashed || S.warp === 'jump') return;
  const cx = hudCv.width/2, cy = hudCv.height/2;
  const pitchDeg = S.pitch * 180/Math.PI;
  const rollRad = S.roll;
  const cyan = 'rgba(110,231,255,0.95)';
  hctx.strokeStyle = cyan; hctx.fillStyle = cyan;
  hctx.lineWidth = 1.6; hctx.font = '12px Consolas, monospace';
  hctx.shadowColor = 'rgba(80,220,255,0.7)'; hctx.shadowBlur = 5;

  if (camMode !== 0) {
  const pxPerDeg = 9;
  hctx.save();
  hctx.translate(cx, cy);
  hctx.rotate(rollRad);
  hctx.beginPath(); hctx.rect(-260, -220, 520, 440); hctx.clip();
  hctx.translate(0, pitchDeg * pxPerDeg);
  for (let d=-90; d<=90; d+=5) {
    if (d === 0) {
      hctx.beginPath();
      hctx.moveTo(-230,0); hctx.lineTo(-42,0); hctx.moveTo(42,0); hctx.lineTo(230,0);
      hctx.lineWidth = 2.2; hctx.stroke(); hctx.lineWidth = 1.6;
    } else {
      const y = -d * pxPerDeg;
      const w = d % 10 === 0 ? 80 : 40;
      hctx.setLineDash(d < 0 ? [7,5] : []);
      hctx.beginPath();
      hctx.moveTo(-w, y); hctx.lineTo(-24, y);
      hctx.moveTo(24, y); hctx.lineTo(w, y);
      hctx.stroke(); hctx.setLineDash([]);
      if (d % 10 === 0) { hctx.fillText(Math.abs(d), -w-24, y+4); hctx.fillText(Math.abs(d), w+8, y+4); }
    }
  }
  hctx.restore();

  hctx.save(); hctx.translate(cx, cy);
  hctx.lineWidth = 2.4;
  hctx.beginPath();
  hctx.moveTo(-34,0); hctx.lineTo(-12,0); hctx.lineTo(-6,7);
  hctx.moveTo(34,0); hctx.lineTo(12,0); hctx.lineTo(6,7);
  hctx.moveTo(0,-3); hctx.lineTo(0,3);
  hctx.stroke();
  hctx.restore();

  if (S.ias > 40 || (S.atmDens < 0.05 && S.vel.length() > 30)) {
    const vLocal = S.vel.clone().applyQuaternion(S.quat.clone().invert());
    if (vLocal.z > 1) {
      const fpX = Math.atan2(vLocal.x, vLocal.z) * pxPerDeg * 180/Math.PI;
      const fpYr = -Math.atan2(vLocal.y, Math.hypot(vLocal.x, vLocal.z)) * pxPerDeg * 180/Math.PI;
      hctx.save(); hctx.translate(cx, cy); hctx.rotate(rollRad);
      hctx.translate(Math.max(-200,Math.min(200,fpX)), Math.max(-200,Math.min(200,fpYr + pitchDeg*pxPerDeg)));
      hctx.beginPath(); hctx.arc(0,0,7,0,Math.PI*2);
      hctx.moveTo(-15,0); hctx.lineTo(-7,0); hctx.moveTo(7,0); hctx.lineTo(15,0);
      hctx.moveTo(0,-13); hctx.lineTo(0,-7);
      hctx.stroke(); hctx.restore();
    }
  }

  hctx.save(); hctx.translate(cx, cy);
  hctx.beginPath(); hctx.arc(0,0,180, -Math.PI/2-0.8, -Math.PI/2+0.8); hctx.stroke();
  for (const a of [-45,-30,-20,-10,0,10,20,30,45]) {
    const r = a*Math.PI/180;
    hctx.save(); hctx.rotate(r);
    hctx.beginPath(); hctx.moveTo(0,-180); hctx.lineTo(0,-180-(a%30===0?12:7)); hctx.stroke();
    hctx.restore();
  }
  hctx.save(); hctx.rotate(-rollRad);
  hctx.beginPath(); hctx.moveTo(0,-176); hctx.lineTo(-6,-166); hctx.lineTo(6,-166); hctx.closePath(); hctx.fill();
  hctx.restore(); hctx.restore();

  hctx.save(); hctx.translate(cx, 78);
  hctx.beginPath(); hctx.rect(-170,-16,340,32); hctx.clip();
  for (let d=-60; d<=60; d+=5) {
    let h = Math.round((S.hdg+d)/5)*5; const x = (h-S.hdg)*2.8;
    h = ((h%360)+360)%360;
    hctx.beginPath(); hctx.moveTo(x, 8); hctx.lineTo(x, h%10===0?0:5); hctx.stroke();
    if (h % 30 === 0) {
      const lbl = h===0?'K':h===90?'D':h===180?'G':h===270?'B':(h/10);
      hctx.fillText(lbl, x - String(lbl).length*3.5, -4);
    }
  }
  hctx.restore();
  }

  /* Hedef işaretçisi (ekranda gezegen yönü) */
  const tp = TARGETS[S.target];
  const toT = tp.center.clone().sub(camera.position).normalize();
  const camF = new THREE.Vector3(0,0,-1).applyQuaternion(camera.quaternion);
  if (toT.dot(camF) > 0.3) {
    const v = tp.center.clone().project(camera);
    const sx = (v.x*0.5+0.5)*hudCv.width, sy = (-v.y*0.5+0.5)*hudCv.height;
    hctx.strokeStyle = 'rgba(102,255,168,0.9)'; hctx.fillStyle = 'rgba(102,255,168,0.9)';
    hctx.lineWidth = 1.6;
    hctx.strokeRect(sx-14, sy-14, 28, 28);
    hctx.font = '11px Consolas, monospace';
    hctx.fillText(tp.name + ' ' + (S.pos.distanceTo(tp.center)/1000).toFixed(0) + 'km', sx+20, sy+4);
  }

  /* ILS yaklaşma kılavuzu (hedef üsse 20 km kala) */
  if (camMode !== 0 && !S.onGround && S.warp === 'off') {
    const lp = S.pos.clone().sub(tp.padWorld);
    const distXZ = Math.hypot(lp.x, lp.z);
    if (distXZ < 20000 && distXZ > 300 && lp.y < 3800 && lp.y > -500) {
      const locDev = Math.max(-1, Math.min(1, lp.x / 700));
      const desired = distXZ * 0.061;   // ~3.5° süzülüş
      const gsDev = Math.max(-1, Math.min(1, (lp.y - desired) / 400));
      const bx = cx + 250, by = cy;
      hctx.strokeStyle = 'rgba(102,255,168,0.85)'; hctx.fillStyle = 'rgba(102,255,168,0.9)';
      hctx.lineWidth = 1.4; hctx.font = '10px Consolas, monospace';
      // Süzülüş (dikey) skalası
      hctx.beginPath(); hctx.moveTo(bx, by-70); hctx.lineTo(bx, by+70); hctx.stroke();
      for (const t of [-70,-35,0,35,70]) { hctx.beginPath(); hctx.moveTo(bx-4,by+t); hctx.lineTo(bx+4,by+t); hctx.stroke(); }
      hctx.save(); hctx.translate(bx, by + gsDev*66);
      hctx.beginPath(); hctx.moveTo(0,-6); hctx.lineTo(6,0); hctx.lineTo(0,6); hctx.lineTo(-6,0); hctx.closePath(); hctx.fill();
      hctx.restore();
      // Localizer (yatay) skalası
      const ly = cy + 220;
      hctx.beginPath(); hctx.moveTo(cx-70, ly); hctx.lineTo(cx+70, ly); hctx.stroke();
      for (const t of [-70,-35,0,35,70]) { hctx.beginPath(); hctx.moveTo(cx+t,ly-4); hctx.lineTo(cx+t,ly+4); hctx.stroke(); }
      hctx.save(); hctx.translate(cx + locDev*66, ly);
      hctx.beginPath(); hctx.moveTo(0,-6); hctx.lineTo(6,0); hctx.lineTo(0,6); hctx.lineTo(-6,0); hctx.closePath(); hctx.fill();
      hctx.restore();
      hctx.fillText('ILS ' + tp.name, cx-70, ly+18);
      hctx.fillText(Math.round(distXZ/1000*10)/10 + ' km', cx+34, ly+18);
    }
  }

  /* Kara delik mercekleme halkaları */
  if (((S._bhD || 1e9) < 28000 || S.bhSeq) && !S.crashed) {
    const kI = S.bhSeq ? 0.45 + (1 - S.bhSeq/7.5) : Math.max(0, 1 - S._bhD/28000) * 0.8;
    const vB = BH.center.clone().project(camera);
    if (vB.z < 1) {
      const bx3 = (vB.x*0.5+0.5)*hudCv.width, by3 = (-vB.y*0.5+0.5)*hudCv.height;
      const tNow = performance.now() * 0.001;
      for (let ri = 0; ri < 6; ri++) {
        const rr2 = 60 + ri*ri*46 + Math.sin(tNow*2.2 + ri)*14*kI;
        hctx.strokeStyle = 'rgba(255,' + (190 - ri*18) + ',' + (120 - ri*12) + ',' + (kI * (0.3 - ri*0.04)).toFixed(3) + ')';
        hctx.lineWidth = 2.4 - ri*0.25;
        hctx.beginPath();
        hctx.ellipse(bx3, by3, rr2, rr2 * (0.72 + Math.sin(tNow + ri)*0.08), tNow*0.14*(ri%2?-1:1), 0, Math.PI*2);
        hctx.stroke();
      }
      // Işığın içe akışı
      hctx.strokeStyle = 'rgba(255,210,150,' + (kI*0.22).toFixed(3) + ')';
      hctx.lineWidth = 1.4;
      for (let li = 0; li < Math.floor(24*kI); li++) {
        const ang2 = (li/24)*Math.PI*2 + tNow*0.5;
        const r0 = 340 - ((tNow*160 + li*47) % 260);
        hctx.beginPath();
        hctx.moveTo(bx3 + Math.cos(ang2)*r0, by3 + Math.sin(ang2)*r0*0.78);
        hctx.lineTo(bx3 + Math.cos(ang2)*(r0-44), by3 + Math.sin(ang2)*(r0-44)*0.78);
        hctx.stroke();
      }
      // Karanlık vinyet
      const vg2 = hctx.createRadialGradient(bx3, by3, 30, bx3, by3, Math.max(hudCv.width, hudCv.height)*0.8);
      vg2.addColorStop(0, 'rgba(0,0,0,' + (kI*0.45).toFixed(2) + ')');
      vg2.addColorStop(0.25, 'rgba(10,0,15,0)');
      vg2.addColorStop(1, 'rgba(0,0,0,' + (kI*0.5).toFixed(2) + ')');
      hctx.fillStyle = vg2;
      hctx.fillRect(0, 0, hudCv.width, hudCv.height);
    }
  }

  /* Atmosfere giriş plazması */
  if (S.heat > 0.04) {
    const h = S.heat * (0.85 + Math.random()*0.3);
    const W = hudCv.width, H = hudCv.height;
    const vg = hctx.createRadialGradient(cx, cy, Math.min(W,H)*0.32, cx, cy, Math.max(W,H)*0.72);
    vg.addColorStop(0, 'rgba(255,120,40,0)');
    vg.addColorStop(1, 'rgba(255,110,30,' + (0.42*h).toFixed(3) + ')');
    hctx.fillStyle = vg; hctx.fillRect(0,0,W,H);
    hctx.strokeStyle = 'rgba(255,170,80,' + (0.5*h).toFixed(3) + ')';
    hctx.lineWidth = 2;
    for (let i=0;i<Math.floor(26*h);i++){
      const side = Math.random();
      let x0, y0;
      if (side < 0.5) { x0 = Math.random()<0.5 ? Math.random()*W*0.16 : W - Math.random()*W*0.16; y0 = Math.random()*H; }
      else { y0 = Math.random()<0.5 ? Math.random()*H*0.16 : H - Math.random()*H*0.16; x0 = Math.random()*W; }
      const dx = (cx - x0)*0.06, dy = (cy - y0)*0.06;
      hctx.beginPath(); hctx.moveTo(x0, y0);
      hctx.lineTo(x0 - dx*(2+Math.random()*3), y0 - dy*(2+Math.random()*3));
      hctx.stroke();
    }
  }
  hctx.shadowBlur = 0;
}

/* ---------------- KAMERA ---------------- */
const camSmooth = new THREE.Vector3();
let camInit = false;
function updateCamera(dt) {
  const fwd = new THREE.Vector3(0,0,1).applyQuaternion(S.quat);
  if (camMode === 0) {
    const eye = S.pos.clone().add(new THREE.Vector3(0, 1.17, 2.92).applyQuaternion(S.quat));
    camera.position.copy(eye);
    const lookQ = S.quat.clone().multiply(FLIP_Y);   // kamera -Z bakar; mekik ileri +Z
    if (mouseDown) {
      const yq = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,1,0), camYaw);
      const pq = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), camPitch-0.18);
      lookQ.multiply(yq).multiply(pq);
    } else { camYaw *= 0.9; }
    camera.quaternion.copy(lookQ);
    camera.fov = (S.warp==='jump' ? 96 : 72 + (S.ab ? 4 : 0) + Math.min(6, S.ias/120) + Math.min(16, S.vel.length()/140) * (S.onGround ? 0 : 1)) + (S.bhSeq ? (1 - S.bhSeq/7.5) * 36 : 0);
    camera.updateProjectionMatrix();
    extGroup.visible = false;
    cockpit.visible = true;
  } else {
    extGroup.visible = !S.crashed;
    cockpit.visible = false;
    if (camMode === 1) {
      const behind = new THREE.Vector3(0, 7, -30).applyQuaternion(S.quat);
      if (mouseDown || Math.abs(camYaw) > 0.01) behind.applyAxisAngle(S.upS, camYaw);
      const tgt = S.pos.clone().add(behind);
      if (!camInit) { camSmooth.copy(tgt); camInit = true; }
      camSmooth.lerp(tgt, Math.min(1, dt*4.5));
      camera.position.copy(camSmooth);
      camera.up.copy(S.upS);
      camera.lookAt(S.pos.clone().addScaledVector(fwd, 12));
      if (!mouseDown) camYaw *= 0.94;
      camera.fov = (S.warp==='jump' ? 92 : 62) + (S.bhSeq ? (1 - S.bhSeq/7.5) * 30 : 0);
    } else {
      const off = new THREE.Vector3(
        Math.sin(camYaw)*Math.cos(camPitch), Math.sin(camPitch), Math.cos(camYaw)*Math.cos(camPitch)
      ).multiplyScalar(freeDist);
      camera.position.copy(S.pos).add(off);
      camera.up.copy(S.upS);
      camera.lookAt(S.pos);
      camera.fov = 62;
    }
    camera.updateProjectionMatrix();
  }
  let shake = 0;
  if ((S._stalled || S.ias > 520) && camMode === 0 && S.warp === 'off') shake = 0.05;
  if (S.bhSeq) shake += (1 - S.bhSeq/7.5) * 0.55;
  else shake += Math.max(0, 1 - (S._bhD || 1e9) / 20000) * 0.12;
  if (S.warp === 'charge') shake = Math.max(shake, 0.03 + S.warpT*0.05);
  shake += S.heat * 0.16;
  if (shake > 0) {
    camera.position.x += (Math.random()-0.5)*shake;
    camera.position.y += (Math.random()-0.5)*shake;
  }
}

/* ---------------- ATMOSFER / GÖKYÜZÜ GEÇİŞİ ---------------- */
const _spaceCol = new THREE.Color(0x020208);
const _bgCol = new THREE.Color(), _fogCol = new THREE.Color();
function updateSky() {
  const atmoT = Math.max(0, Math.min(1, 1 - S.alt/22000)) * Math.min(1, S.planet.atm);
  _bgCol.copy(_spaceCol).lerp(new THREE.Color(S.planet.sky), atmoT*0.92);
  scene.background.copy(_bgCol);
  _fogCol.copy(_spaceCol).lerp(new THREE.Color(S.planet.haze), atmoT);
  scene.fog.color.copy(_fogCol);
  scene.fog.density = atmoT * 0.000042;
  const starVis = 1 - atmoT*0.88;
  starsMat1.opacity = 0.95 * starVis;
  starsMat2.opacity = 0.85 * starVis;
  for (const m of nebulaMats) m.opacity = Math.min(m.userData?.base ?? 0.6, 0.8) * (0.35 + 0.65*starVis);
}

/* ---------------- DOM HUD ---------------- */
function updateHudDom() {
  el.spd.textContent = Math.round(S.warp==='jump' ? S.warpSpeed*KT : S.ias);
  el.mach.textContent = S.warp==='jump' ? 'WARP' : 'M ' + Math.max(0,S.mach).toFixed(2);
  el.alt.textContent = Math.round(S.alt * FT).toLocaleString('tr-TR');
  el.radAlt.textContent = 'RAD ' + Math.max(0, Math.round(S.agl * FT)).toLocaleString('tr-TR');
  el.planetName.textContent = '◈ ' + S.planet.name;
  el.hdg.textContent = String(Math.round(S.hdg)||360).padStart(3,'0') + '°';
  el.thrPct.textContent = S.pwr === 3 ? Math.round(S.throttle*100) + '%' : S.pwr === 2 ? 'ATEŞLEME' : S.pwr === 1 ? 'GÜÇ AÇIK' : 'KAPALI (I)';
  el.thrBar.style.width = (S.throttle*100) + '%';
  el.abTag.style.display = S.ab ? 'inline' : 'none';
  if (S.ab) el.abTag.textContent = 'PLAZMA ×' + (1 + S.od*5).toFixed(1);
  document.getElementById('vtolTag').style.display = S.vtol ? 'inline' : 'none';
  const odw = document.getElementById('odWarn');
  if (S.odT > 0.05 && !S.crashed) {
    odw.style.display = 'block';
    document.getElementById('odCnt').textContent = Math.max(0, odLimitT() - S.odT).toFixed(1);
  } else odw.style.display = 'none';
  el.flap.textContent = AC.flapSteps[S.flapIdx] + '°';
  el.gear.textContent = S.gearAnim > 0.95 ? 'AÇIK' : S.gearAnim < 0.05 ? 'KAPALI' : 'HAREKETTE';
  el.gear.className = S.gearAnim > 0.95 ? '' : S.gearAnim < 0.05 ? 'amber' : 'warn';
  el.brk.textContent = S.brake ? 'AKTİF' : '—';
  const fp = Math.max(0, S.fuel/fuelMax()*100);
  el.fuelPct.textContent = Math.round(fp) + '%' + (window.S_DOCK ? ' ⛽+' : '');
  el.fuelBar.style.width = fp + '%';
  el.fuelPct.className = window.S_DOCK ? 'green' : (fp < 15 ? 'warn' : '');
  const vN = S.vel.dot(S.upS);
  el.vs.textContent = (vN>=0?'+':'') + Math.round(vN * FT * 60).toLocaleString('tr-TR');
  el.g.textContent = S.gForce.toFixed(1);
  el.g.className = Math.abs(S.gForce) > 8 ? 'warn' : Math.abs(S.gForce) > 6 ? 'amber' : '';
  el.aoa.textContent = (S.aoa*180/Math.PI).toFixed(1) + '°';
  el.atm.textContent = Math.round(S.atmDens*100) + '%';
  const tp = TARGETS[S.target];
  el.tgt.textContent = tp.name + ' · ' + (S.pos.distanceTo(tp.padWorld)/1000).toFixed(0) + ' km';
  document.getElementById('crVal').textContent = S.credits;
  const ml = document.getElementById('msnLine');
  if (S.mission) ml.innerHTML = '📦 ' + S.mission.cargo + ' → <b>' + S.mission.to.name + '</b> · ' + S.mission.reward + ' Kr';
  else if (atBase()) { const it = nextShopItem(); ml.textContent = 'O: görev al' + (it ? ' · U: ' + it.name.split('(')[0] + it.cost + 'Kr' : ''); }
  else ml.textContent = 'Görev yok — üste O\'ya bas';
  el.stall.style.display = S._stalled ? 'block' : 'none';
  el.gearW.style.display = (!S.onGround && S.gearAnim < 0.9 && S.agl*FT < 1200 && vN < -2 && S.ias < 220 && S.warp==='off') ? 'block' : 'none';
  el.overG.style.display = Math.abs(S.gForce) > 8 ? 'block' : 'none';
}

/* ---------------- ANA DÖNGÜ ---------------- */
let last = performance.now(), started = false, frame = 0;
function loop(now) {
  requestAnimationFrame(loop);
  const dt = Math.min(0.033, (now-last)/1000); last = now;
  frame++;
  if (started && !S.crashed) {
    updateStick(dt);
    if (S.warp !== 'off') {
      updateWarp(dt);
      physics(dt);       // warp'ta erken döner, sadece görselleri günceller
    } else {
      const sub = 3;
      for (let i=0;i<sub;i++) physics(dt/sub);
    }
    updateHudDom();
    updateSky();
    if (camMode === 0 && frame % 2 === 0) { drawMfdAdi(); drawMfdEng(); drawMfdNav(); }
    if (camMode === 0 && frame % 4 === 1) drawAux();
    if (camMode === 0) drawCombinerHud();
    if (camMode === 0 && window._holo) {
      _holo.visible = S.pwr > 0;
      _holo.rotation.y += dt * 0.9;
      _holo.children[1].rotation.z += dt * 0.5;
      const st = S.pwr === 0 ? 0x0c1016 : S.odT > 0.05 ? 0xff2a3a : S.od > 0.15 ? 0x9a5aff : S.dockAP ? 0x33ff9a : 0x2a6a7a;
      for (const bl of (window._backlights || [])) bl.material.color.setHex(st);
      _holo.children[0].material.color.setHex(st === 0x2a6a7a ? 0x33d5ff : st);
    }
    if (mapOpen && frame % 3 === 0) drawMap();
  }
  // Çakarlar + tabelalar
  const blink = Math.sin(now*0.008) > 0.6;
  for (const st of STATIONS) for (const b of st.beacons) b.material.color.setHex(blink ? 0xff3355 : 0x441118);
  for (const p of PLANETS) {
    if (p.beacon) p.beacon.material.color.setHex(blink ? 0xff3355 : 0x441118);
    if (p.sign && p.center.distanceTo(camera.position) < p.radius + 30000) p.sign.lookAt(camera.position);
  }
  if (strobe) strobe.material.color.setHex((now % 1400 < 80) ? 0xffffff : 0x222226);
  // Yıldızlar kameraya sabit
  if (window._stars) for (const st of _stars) st.position.copy(camera.position);
  // PAPI ışıkları: süzülüş açısına göre renk
  if (started && S.planet && S.planet.papi && !S.crashed) {
    const lpP = S.pos.clone().sub(S.planet.padWorld);
    const dXZ = Math.hypot(lpP.x, lpP.z);
    if (dXZ < 14000 && dXZ > 100 && lpP.y > -100) {
      const ang = Math.atan2(Math.max(0, lpP.y), dXZ) * 180 / Math.PI;
      for (let i = 0; i < 4; i++)
        S.planet.papi[i].material.color.setHex(ang > (2.1 + i * 0.6) ? 0xffffff : 0xff2233);
    }
  }
  // Bulut katmanları döner
  if (window._clouds) for (const cl of _clouds) cl.mesh.rotation.y += cl.spd * dt;
  updateFx(dt);
  // Overdrive yıldız çizgileri (warp dışında, yüksek hızda)
  if (started && !S.crashed && S.warp === 'off') {
    const spd = S.vel.length();
    const tI = Math.min(1, Math.max(0, (spd - 620) / 1200) + (S.bhSeq ? (1 - S.bhSeq/7.5) * 0.9 : 0));
    if (tI > 0.02 && !S.onGround) {
      warpStreaks.visible = true;
      warpStreaks.material.opacity = 0.85 * tI;
      warpStreaks.position.copy(S.pos);
      const vdir = S.vel.clone().normalize();
      warpStreaks.quaternion.setFromRotationMatrix(
        new THREE.Matrix4().lookAt(new THREE.Vector3(), vdir.negate(), _u));
      const pA = warpStreaks.geometry.attributes.position;
      const meta = warpStreaks.userData;
      for (let i=0;i<meta.length;i++){
        const m = meta[i];
        m.z += m.spd * (0.12 + tI) * dt * Math.min(3, spd/800);
        if (m.z > 320) m.z = -320 - Math.random()*160;
        const st = m.len * (1 + spd/1000 * tI);
        pA.setXYZ(i*2, m.x, m.y, m.z);
        pA.setXYZ(i*2+1, m.x, m.y, m.z + st);
      }
      pA.needsUpdate = true;
    } else if (warpStreaks.visible) {
      warpStreaks.visible = false;
      warpStreaks.material.opacity = 0.85;
    }
  }
  updateNpcs(dt, now);
  if (BH.disk) {
    BH.disk.rotation.z += dt * 0.12;
    if (BH.disk2) BH.disk2.rotation.z -= dt * 0.09;
    BH.photon.material.opacity = 0.8 + Math.sin(now*0.004)*0.15;
    // İçe düşen madde spirali
    if (BH.infall && BH.center.distanceTo(camera.position) < 90000) {
      const inf = BH.infall;
      for (let i=0;i<inf.data.length;i++){
        const pd = inf.data[i];
        pd.a += pd.w * dt * Math.pow(BH.radius*2.2/pd.r, 1.4);
        pd.r -= dt * BH.radius * 0.05;
        if (pd.r < BH.radius*1.15) { pd.r = BH.radius*(3.5+Math.random()*2.5); pd.a = Math.random()*Math.PI*2; }
        inf.attr.setXYZ(i, Math.cos(pd.a)*pd.r, Math.sin(pd.a)*pd.r*pd.tilt, Math.sin(pd.a)*pd.r);
      }
      inf.attr.needsUpdate = true;
    }
  }
  /* Yerçekimi bozulması: renk kayması + bulanıklık (CSS filtre) */
  {
    const prox = Math.max(0, 1 - (S._bhD || 1e9) / 24000);
    let flt = '';
    if (S.bhSeq > 0) {
      const t3 = 1 - S.bhSeq / 7.5;
      flt = 'hue-rotate(' + Math.round(t3*230) + 'deg) saturate(' + (1 + t3*2.6).toFixed(2) + ') contrast(' + (1 + t3*0.8).toFixed(2) + ') blur(' + (t3*2.4).toFixed(1) + 'px)';
    } else if (prox > 0.03 && !S.crashed) {
      flt = 'hue-rotate(' + Math.round(prox*45) + 'deg) saturate(' + (1 + prox*0.6).toFixed(2) + ')';
    }
    if (renderer.domElement.style.filter !== flt) renderer.domElement.style.filter = flt;
  }
  updateWeapons(dt, now);
  if (started && !S.crashed && frame % 20 === 0) missionTick();
  updateTraffic(dt, now);
  if (started && !S.crashed) updateDocking(dt);
  for (const asr of asteroids) { asr.mesh.rotation.x += asr.rx*dt; asr.mesh.rotation.y += asr.ry*dt; }
  comet.t += dt*0.0035;
  comet.g.position.set(Math.cos(comet.t)*98000, 27000 + Math.sin(comet.t*1.7)*9000, Math.sin(comet.t)*98000);
  for (const st of STATIONS) {
    st.ring.rotation.z += dt*0.055;
    if (st.sign && st.center.distanceTo(camera.position) < 45000) st.sign.lookAt(camera.position);
  }
  // Güneş ışığı mekiği takip etsin (gölge kamerası)
  sun.position.copy(S.pos).add(new THREE.Vector3(-600, 900, 400));
  sun.target.position.copy(S.pos);
  if (crashParticles) {
    const pAttr = crashParticles.geometry.attributes.position;
    const u = crashParticles.userData;
    u.life -= dt;
    for (let i=0;i<u.vel.length;i++){
      u.vel[i].addScaledVector(u.up, -25*dt);
      pAttr.setX(i, pAttr.getX(i)+u.vel[i].x*dt);
      pAttr.setY(i, pAttr.getY(i)+u.vel[i].y*dt);
      pAttr.setZ(i, pAttr.getZ(i)+u.vel[i].z*dt);
    }
    pAttr.needsUpdate = true;
    crashParticles.material.opacity = Math.max(0, u.life/2.6);
    if (u.life <= 0) { scene.remove(crashParticles); crashParticles = null; }
  }
  updateCamera(dt);
  updateAudio();
  drawHud();
  renderer.render(scene, camera);
}
requestAnimationFrame(loop);

function startGame(vertical) {
  document.getElementById('startScreen').style.display = 'none';
  initAudio();
  if (vertical) {
    setupVerticalLaunch();
    flash('🚀 DİKEY RAMPA — önce [I][I] ile motorları çalıştır, sonra gazı %50 üstüne bas!');
  } else {
    flash('SOĞUK KOKPİT — [I] güç aç → [I] ateşle → flap (F) → gaz → ~150 kt\'ta rotasyon');
  }
  started = true;
  updateHudVis();
}
document.getElementById('startBtnRw').addEventListener('click', () => startGame(false));
document.getElementById('startBtnVt').addEventListener('click', () => startGame(true));

addEventListener('resize', () => {
  renderer.setSize(innerWidth, innerHeight);
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  sizeHud();
  if (mapOpen) sizeMap();
});
</script>
</body>
</html>
