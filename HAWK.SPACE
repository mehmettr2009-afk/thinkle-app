  }
}

/* ---------------- 3B GÜRÜLTÜ ---------------- */
function hash3(x,y,z){ const s=Math.sin(x*127.1+y*311.7+z*74.7)*43758.5453; return s-Math.floor(s); }
function vnoise3(x,y,z){
  const xi=Math.floor(x), yi=Math.floor(y), zi=Math.floor(z);
  const xf=x-xi, yf=y-yi, zf=z-zi;
  const u=xf*xf*(3-2*xf), v=yf*yf*(3-2*yf), w=zf*zf*(3-2*zf);
  const l=(a,b,t)=>a+(b-a)*t;
  return l(
    l(l(hash3(xi,yi,zi),hash3(xi+1,yi,zi),u), l(hash3(xi,yi+1,zi),hash3(xi+1,yi+1,zi),u), v),
    l(l(hash3(xi,yi,zi+1),hash3(xi+1,yi,zi+1),u), l(hash3(xi,yi+1,zi+1),hash3(xi+1,yi+1,zi+1),u), v), w);
}
function fbm3(x,y,z,oct){
  let h=0, amp=1, f=1, tot=0;
  for (let o=0;o<oct;o++){ h += (vnoise3(x*f,y*f,z*f)-0.5)*2*amp; tot+=amp; amp*=0.5; f*=2.1; }
  return h/tot;
}

/* ---------------- GEZEGENLER ---------------- */
const PAD_ANGLE = 0.13;         // pist bölgesi (radyan)
const PAD_BLEND = 0.10;
const RUNWAY = { len: 1600, wid: 50 };

/* Paylaşılan pist / apron dokuları */
let _runwayTex = null, _apronTex = null;
function getRunwayTex() {
  if (_runwayTex) return _runwayTex;
  const W = 256, H = 2048;
  const cv = document.createElement('canvas'); cv.width=W; cv.height=H;
  const c = cv.getContext('2d');
  c.fillStyle = '#26262e'; c.fillRect(0,0,W,H);
  fbmFill(c, W, H, 4, 0.22);
  // Beton derzleri
  c.strokeStyle = 'rgba(10,10,14,0.5)'; c.lineWidth = 2;
  for (let y=0; y<H; y+=128) { c.beginPath(); c.moveTo(0,y); c.lineTo(W,y); c.stroke(); }
  c.beginPath(); c.moveTo(W/2-52,0); c.lineTo(W/2-52,H); c.moveTo(W/2+52,0); c.lineTo(W/2+52,H); c.stroke();
  // Kenar çizgileri
  c.fillStyle = 'rgba(230,235,240,0.85)';
  c.fillRect(10, 0, 5, H); c.fillRect(W-15, 0, 5, H);
  // Orta hat kesikli
  for (let y=170; y<H-170; y+=96) c.fillRect(W/2-3, y, 6, 52);
  // Eşik barları
  for (const yEnd of [16, H-58]) {
    for (let x=28; x<W-28; x+=26) c.fillRect(x, yEnd, 13, 42);
  }
  // Pist numaraları
  c.save(); c.fillStyle='rgba(230,235,240,0.9)'; c.font='bold 84px Consolas, monospace'; c.textAlign='center';
  c.translate(W/2, 168); c.rotate(Math.PI); c.fillText('19', 0, 0); c.restore();
  c.save(); c.fillStyle='rgba(230,235,240,0.9)'; c.font='bold 84px Consolas, monospace'; c.textAlign='center';
  c.translate(W/2, H-140); c.fillText('01', 0, 0); c.restore();
  // Teker izleri (touchdown bölgesi)
  c.strokeStyle = 'rgba(8,8,10,0.4)';
  for (let i=0;i<26;i++){
    const y0 = (Math.random()<0.5 ? 220+Math.random()*300 : H-220-Math.random()*300);
    const x0 = W/2 + (Math.random()-0.5)*70;
    c.lineWidth = 3+Math.random()*4;
    c.beginPath(); c.moveTo(x0, y0); c.lineTo(x0+(Math.random()-0.5)*12, y0+90+Math.random()*140); c.stroke();
  }
  _runwayTex = new THREE.CanvasTexture(cv);
  _runwayTex.anisotropy = 8;
  return _runwayTex;
}
function getApronTex() {
  if (_apronTex) return _apronTex;
  const S = 256;
  const cv = document.createElement('canvas'); cv.width=cv.height=S;
  const c = cv.getContext('2d');
  c.fillStyle = '#2b2b33'; c.beginPath(); c.arc(S/2,S/2,S/2-2,0,Math.PI*2); c.fill();
  fbmFill(c, S, S, 3, 0.2);
  c.globalCompositeOperation = 'destination-in';
  c.beginPath(); c.arc(S/2,S/2,S/2-2,0,Math.PI*2); c.fill();
  c.globalCompositeOperation = 'source-over';
  c.strokeStyle = '#e8b83a'; c.lineWidth = 7;
  c.beginPath(); c.arc(S/2,S/2,S/2-12,0,Math.PI*2); c.stroke();
  c.fillStyle = '#e8b83a'; c.font='bold 118px Consolas, monospace'; c.textAlign='center'; c.textBaseline='middle';
  c.fillText('H', S/2, S/2+6);
  _apronTex = new THREE.CanvasTexture(cv);
  return _apronTex;
}

