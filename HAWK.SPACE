  combiner.position.set(0, 1.30, 3.72); combiner.rotation.x = -0.24;
  cockpit.add(combiner);
  const combGlow = new THREE.Mesh(new THREE.BoxGeometry(0.58, 0.012, 0.012),
    new THREE.MeshBasicMaterial({ color: 0x2a8a9a }));
  combGlow.position.set(0, 1.495, 3.77); combGlow.rotation.x = -0.24;
  cockpit.add(combGlow);
  /* Cama yansıyan gerçek HUD (canvas doku) */
  window._chudCv = document.createElement('canvas'); _chudCv.width = 512; _chudCv.height = 384;
  window._chudTex = new THREE.CanvasTexture(_chudCv);
  const chud = new THREE.Mesh(new THREE.PlaneGeometry(0.545, 0.375),
    new THREE.MeshBasicMaterial({ map: _chudTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide }));
  chud.position.set(0, 1.30, 3.708); chud.rotation.x = -0.24; chud.rotation.y = Math.PI;
  cockpit.add(chud);

