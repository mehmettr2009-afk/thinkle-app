<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ŞAHİN-X | Yıldızlararası Mekik Simülatörü</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { width:100%; height:100%; overflow:hidden; background:#000; font-family:'Consolas','Courier New',monospace; }
  canvas#scene { display:block; }
  #hudCanvas { position:fixed; inset:0; pointer-events:none; z-index:5; }

  .hud { position:fixed; z-index:6; color:#6ee7ff; text-shadow:0 0 7px rgba(80,220,255,.6); pointer-events:none; user-select:none; }
  .hud-box { background:rgba(4,10,22,.5); border:1px solid rgba(110,231,255,.3); border-radius:6px; padding:6px 10px; backdrop-filter:blur(3px); }

  #spdBox { left:5%; top:44%; text-align:right; }
  #altBox { right:5%; top:44%; }
  .big { font-size:30px; font-weight:bold; letter-spacing:1px; }
  .small { font-size:11px; opacity:.8; }

  #topInfo { top:12px; left:50%; transform:translateX(-50%); text-align:center; }
  #hdgVal { font-size:22px; font-weight:bold; }

  #leftPanel { left:14px; bottom:14px; font-size:13px; line-height:1.55; }
  #rightPanel { right:14px; bottom:14px; font-size:13px; line-height:1.55; text-align:right; }
  .bar { display:inline-block; width:110px; height:9px; background:rgba(110,231,255,.12); border:1px solid rgba(110,231,255,.35); vertical-align:middle; margin-left:6px; }
  .bar > i { display:block; height:100%; background:#6ee7ff; box-shadow:0 0 8px rgba(80,220,255,.7); }
  .warn { color:#ff5252 !important; text-shadow:0 0 8px rgba(255,60,60,.8) !important; }
  .amber { color:#ffcf5c; text-shadow:0 0 8px rgba(255,200,80,.6); }
  .violet { color:#c792ff; text-shadow:0 0 8px rgba(190,140,255,.7); }
  .green { color:#66ffa8; text-shadow:0 0 8px rgba(80,255,160,.6); }

  #ctrlPanel { left:14px; top:70px; font-size:10.5px; line-height:1.7; max-width:238px; transition:opacity .25s, transform .25s; }
  #ctrlPanel h3 { font-size:11px; letter-spacing:2px; color:#c792ff; border-bottom:1px solid rgba(110,231,255,.25); padding-bottom:3px; margin-bottom:4px; }
  #ctrlPanel b { color:#fff; display:inline-block; min-width:82px; font-weight:bold; }
  #ctrlPanel.hidden { opacity:0; transform:translateX(-12px); }

  #stallWarn, #gearWarn, #overGWarn {
    left:50%; transform:translateX(-50%); text-align:center; font-weight:bold; letter-spacing:4px;
    color:#ff4040; text-shadow:0 0 12px rgba(255,40,40,.9); display:none; animation:blink .5s steps(2) infinite;
  }
  #stallWarn { top:26%; font-size:26px; }
  #gearWarn  { top:32%; font-size:16px; }
  #overGWarn { top:36%; font-size:16px; color:#ffcf5c; }
  #odWarn {
    left:50%; top:42%; transform:translateX(-50%); text-align:center; display:none;
    font-size:30px; font-weight:bold; letter-spacing:5px;
    color:#ff3020; text-shadow:0 0 20px rgba(255,50,20,.95);
    animation:blink .32s steps(2) infinite;
  }
  #odWarn .sub { font-size:13px; letter-spacing:2px; color:#ffb090; }
  @keyframes blink { 50% { opacity:.15; } }

  #msg { top:20%; left:50%; transform:translateX(-50%); font-size:15px; color:#dff; text-align:center; opacity:0; transition:opacity .4s; }

  /* Warp */
  #warpInfo {
    top:15%; left:50%; transform:translateX(-50%); text-align:center; display:none;
    font-size:20px; letter-spacing:5px; color:#c792ff; text-shadow:0 0 18px rgba(190,140,255,.9);
  }
  #warpInfo .sub { font-size:12px; letter-spacing:2px; color:#9ecbff; margin-top:5px; }
  #warpFlash { position:fixed; inset:0; z-index:12; background:#fff; opacity:0; pointer-events:none; transition:opacity .25s; }

  /* Harita */
  #mapOverlay {
    position:fixed; inset:0; z-index:10; display:none; align-items:center; justify-content:center;
    background:rgba(2,4,12,.78); backdrop-filter:blur(4px);
  }
  #mapWrap { position:relative; border:1px solid rgba(110,231,255,.35); border-radius:10px; overflow:hidden;
    box-shadow:0 0 60px rgba(80,120,255,.25), inset 0 0 80px rgba(30,50,120,.15); }
  #mapCanvas { display:block; background:radial-gradient(ellipse at 50% 50%, #0a1024 0%, #04060f 80%); }
  #mapTitle { position:absolute; top:10px; left:14px; color:#6ee7ff; font-size:13px; letter-spacing:4px; text-shadow:0 0 10px rgba(80,220,255,.6); }
  #mapHint { position:absolute; bottom:10px; left:14px; color:#8ab; font-size:11px; letter-spacing:1px; }

  /* Başlangıç */
  #startScreen {
    position:fixed; inset:0; z-index:20; color:#dfe;
    background:
      radial-gradient(ellipse 60% 45% at 22% 25%, rgba(120,40,180,.35) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 78% 65%, rgba(30,120,200,.3) 0%, transparent 65%),
      radial-gradient(ellipse 40% 30% at 60% 15%, rgba(200,60,140,.18) 0%, transparent 60%),
      radial-gradient(ellipse at 50% 40%, #0a0a1e 0%, #020208 75%);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  #startScreen::before {
    content:''; position:absolute; inset:0; pointer-events:none;
    background-image:
      radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 34% 68%, #cdf 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 56% 12%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 71% 41%, #fdc 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 76%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 44% 87%, #cef 50%, transparent 51%),
      radial-gradient(1px 1px at 6% 55%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 93% 18%, #dcf 50%, transparent 51%),
      radial-gradient(1px 1px at 25% 92%, #fff 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 63% 58%, #fff 50%, transparent 51%);
    animation:twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes twinkle { from { opacity:.5; } to { opacity:1; } }
  #startScreen h1 { font-size:48px; letter-spacing:12px; color:#6ee7ff; text-shadow:0 0 30px rgba(80,220,255,.7), 0 0 60px rgba(150,80,255,.4); margin-bottom:4px; z-index:1; }
  #startScreen h2 { font-size:13px; letter-spacing:7px; color:#c792ff; font-weight:normal; margin-bottom:24px; z-index:1; }
  #ctrlGrid { display:grid; grid-template-columns:repeat(2,minmax(270px,340px)); gap:5px 40px; font-size:12.5px; line-height:1.65; margin-bottom:22px; z-index:1; }
  #ctrlGrid b { color:#6ee7ff; display:inline-block; min-width:128px; }
  .startB {
    pointer-events:auto; cursor:pointer; font-family:inherit; font-size:17px; letter-spacing:4px; z-index:1;
    padding:13px 46px; color:#6ee7ff; background:rgba(110,231,255,.05); border:1px solid #6ee7ff; border-radius:6px;
    text-shadow:0 0 10px rgba(80,220,255,.6); transition:.2s;
  }
  .startB:hover { background:rgba(110,231,255,.14); box-shadow:0 0 30px rgba(80,220,255,.4), inset 0 0 20px rgba(80,220,255,.1); }

  #crashScreen {
    position:fixed; inset:0; z-index:15; background:rgba(40,0,10,.55); display:none;
    flex-direction:column; align-items:center; justify-content:center; color:#ffd;
  }
  #crashScreen h1 { font-size:50px; letter-spacing:10px; color:#ff5252; text-shadow:0 0 30px rgba(255,60,60,.8); }
  #crashScreen p { margin-top:14px; font-size:15px; letter-spacing:2px; }
  #crashStats { margin-top:10px; font-size:13px; color:#faa; }

  #camLabel { top:12px; right:16px; font-size:12px; letter-spacing:2px; opacity:.8; }
  #helpHint { bottom:14px; left:50%; transform:translateX(-50%); font-size:11px; opacity:.5; letter-spacing:1px; }
</style>
</head>
<body>

<div id="startScreen">
  <h1>ŞAHİN-X</h1>
  <h2>YILDIZLARARASI MEKİK SİMÜLATÖRÜ · 7 GÖK CİSMİ + 2 İSTASYON</h2>
  <div id="ctrlGrid">
    <div><b>I (2 kez)</b> Güç aç → motorları ateşle</div>
    <div><b>W / S</b> Burun aşağı / yukarı</div>
    <div><b>Shift / Ctrl</b> Ana motor gücü + / −</div>
    <div><b>A / D</b> Sola / sağa yatış</div>
    <div><b>Space (bas-tut)</b> OVERDRIVE: güç sürekli artar (limite dikkat!)</div>
    <div><b>Q / E</b> Rudder / RCS sol-sağ</div>
    <div><b>F · G · B</b> Flap · takım · fren (uzayda: RCS retro)</div>
    <div><b>N / V</b> Hedef seç / DİKEY kalkış modu</div>
    <div><b>J</b> ⚡ WARP sürücüsü (ışık hızı)</div>
    <div><b>M / K</b> Harita / Yanaşma otopilotu</div>
    <div><b>Sol tık / O / U</b> Ateş / görev al / mağaza</div>
    <div><b>C</b> Kamera: kokpit / takip / serbest</div>
    <div><b>Sağ tık + fare</b> Etrafa bak</div>
    <div><b>H</b> Kontrol paneli · <b>R</b> reset</div>
  </div>
  <div style="font-size:12px; color:#9ab; margin-bottom:22px; max-width:700px; text-align:center; line-height:1.6; z-index:1">
    Haritadan (M) hedef seç, warp'la git, in — üslerde astronotlar ve roverlar seni karşılar.<br>
    Yakıtın azalınca ⛽ istasyonlara yanaş (150 m'den yakın + 18 m/s'den yavaş) → otomatik ikmal başlar.<br>
    Asteroit kuşağına, trafik gemilerine ve kuyruklu yıldıza göz kulak ol — PYKE'de atmosfer yok, dikey iniş şart! 😈
  </div>
  <div style="display:flex; gap:18px; z-index:1">
    <button id="startBtnRw" class="startB">🛫 PİST KALKIŞI</button>
    <button id="startBtnVt" class="startB" style="border-color:#c792ff; color:#c792ff">🚀 DİKEY KALKIŞ</button>
  </div>
</div>

<div id="crashScreen">
  <h1>GÖREV BAŞARISIZ</h1>
  <p id="crashReason"></p>
  <div id="crashStats"></div>
  <p style="margin-top:26px; color:#6ee7ff">En yakın üsse dönmek için <b>R</b> tuşuna bas</p>
</div>

<div id="warpFlash"></div>
<div class="hud" id="warpInfo"><div id="warpMain">WARP</div><div class="sub" id="warpSub"></div></div>

<div id="mapOverlay"><div id="mapWrap">
  <canvas id="mapCanvas"></canvas>
  <div id="mapTitle">◈ KIZILÖTE SİSTEMİ — NAVİGASYON</div>
  <div id="mapHint">🖱️ Gezegene tıkla = HEDEF SEÇ · seçiliye tekrar tıkla = ⚡WARP · M: kapat</div>
</div></div>

<canvas id="hudCanvas"></canvas>

<div class="hud hud-box" id="spdBox"><div class="small">HIZ (KIAS)</div><div class="big" id="spdVal">0</div><div class="small" id="machVal">M 0.00</div></div>
<div class="hud hud-box" id="altBox"><div class="small">İRTİFA (FT)</div><div class="big" id="altVal">0</div><div class="small" id="radAltVal">RAD 0</div></div>
<div class="hud hud-box" id="topInfo"><div class="small" id="planetName">KZ-7</div><div id="hdgVal">360°</div></div>

<div class="hud hud-box" id="ctrlPanel">
  <h3>⌁ KONTROLLER</h3>
  <div><b>I · L</b> motor başlat · iniş farı</div>
  <div><b>W/S · A/D</b> pitch · roll</div>
  <div><b>Q/E</b> rudder / RCS</div>
  <div><b>Shift/Ctrl</b> gaz + / −</div>
  <div><b>Space</b> afterburner</div>
  <div><b>F · G · B</b> flap · takım · fren/retro</div>
  <div><b>N · J · V</b> hedef · ⚡warp · ▲vtol</div>
  <div><b>K</b> istasyona yanaşma AP</div>
  <div><b>Sol tık</b> plazma topu 🔫</div>
  <div><b>O · U</b> görev · mağaza</div>
  <div><b>M</b> harita &nbsp; <b>C</b> kamera</div>
  <div><b>Sağ tık</b> bak &nbsp; <b>H</b> panel &nbsp; <b>R</b> reset</div>
</div>

<div class="hud hud-box" id="leftPanel">
  <div>GÜÇ <span id="thrPct">0%</span><span class="bar"><i id="thrBar" style="width:0%"></i></span> <span id="abTag" style="display:none" class="violet">PLAZMA</span></div>
  <div>FLAP <span id="flapVal">0°</span> &nbsp;|&nbsp; TAKIM <span id="gearVal">AÇIK</span> &nbsp;|&nbsp; FREN <span id="brkVal">—</span> <span id="vtolTag" class="violet" style="display:none">▲VTOL</span></div>
  <div>YAKIT <span id="fuelPct">100%</span><span class="bar"><i id="fuelBar" style="width:100%"></i></span></div>
</div>

<div class="hud hud-box" id="rightPanel">
  <div>HEDEF <span id="tgtVal" class="green">—</span></div>
  <div>V/S <span id="vsVal">0</span> ft/dk &nbsp;|&nbsp; G <span id="gVal">1.0</span></div>
  <div>AoA <span id="aoaVal">0.0°</span> &nbsp;|&nbsp; ATM <span id="atmVal">100%</span></div>
</div>

<div class="hud" id="stallWarn">■ STALL ■</div>
<div class="hud" id="gearWarn">İNİŞ TAKIMI KAPALI!</div>
<div class="hud" id="overGWarn">AŞIRI G YÜKÜ</div>
<div class="hud" id="odWarn"><span id="odCnt">5.0</span><div class="sub">YAPISAL LİMİT AŞILDI — YAVAŞLA!</div></div>
<div class="hud" id="msg"></div>
<div class="hud" id="camLabel">KOKPİT</div>
<div class="hud hud-box" id="msnBox" style="top:44px; right:16px; font-size:11.5px; line-height:1.6; text-align:right; max-width:280px;">
  <div>KREDİ <span id="crVal" class="amber">0</span> Kr</div>
  <div id="msnLine" style="color:#9ecbff">Görev yok — üste O'ya bas</div>
</div>
<div class="hud" id="helpHint">N: hedef · J: warp · M: harita · C: kamera</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* GLTFLoader r128 — satıriçi gömülü (CDN engellerine takılmasın) */
( function () {

	class GLTFLoader extends THREE.Loader {

		constructor( manager ) {

			super( manager );
			this.dracoLoader = null;
			this.ktx2Loader = null;
			this.meshoptDecoder = null;
			this.pluginCallbacks = [];
			this.register( function ( parser ) {

				return new GLTFMaterialsClearcoatExtension( parser );

			} );
			this.register( function ( parser ) {

				return new GLTFTextureBasisUExtension( parser );

			} );
			this.register( function ( parser ) {

				return new GLTFTextureWebPExtension( parser );

			} );
			this.register( function ( parser ) {

				return new GLTFMaterialsTransmissionExtension( parser );

			} );
			this.register( function ( parser ) {

				return new GLTFLightsExtension( parser );

			} );
			this.register( function ( parser ) {

				return new GLTFMeshoptCompression( parser );

			} );

		}

		load( url, onLoad, onProgress, onError ) {

			const scope = this;
			let resourcePath;

			if ( this.resourcePath !== '' ) {

				resourcePath = this.resourcePath;

			} else if ( this.path !== '' ) {

				resourcePath = this.path;

			} else {

				resourcePath = THREE.LoaderUtils.extractUrlBase( url );

			} // Tells the LoadingManager to track an extra item, which resolves after
			// the model is fully loaded. This means the count of items loaded will
			// be incorrect, but ensures manager.onLoad() does not fire early.


			this.manager.itemStart( url );

			const _onError = function ( e ) {

				if ( onError ) {

					onError( e );

				} else {

					console.error( e );

				}

				scope.manager.itemError( url );
				scope.manager.itemEnd( url );

			};

			const loader = new THREE.FileLoader( this.manager );
			loader.setPath( this.path );
			loader.setResponseType( 'arraybuffer' );
			loader.setRequestHeader( this.requestHeader );
			loader.setWithCredentials( this.withCredentials );
			loader.load( url, function ( data ) {

				try {

					scope.parse( data, resourcePath, function ( gltf ) {

						onLoad( gltf );
						scope.manager.itemEnd( url );

					}, _onError );

				} catch ( e ) {

					_onError( e );

				}

			}, onProgress, _onError );

		}

		setDRACOLoader( dracoLoader ) {

			this.dracoLoader = dracoLoader;
			return this;

		}

		setDDSLoader() {

			throw new Error( 'THREE.GLTFLoader: "MSFT_texture_dds" no longer supported. Please update to "KHR_texture_basisu".' );

		}

		setKTX2Loader( ktx2Loader ) {

			this.ktx2Loader = ktx2Loader;
			return this;

		}

		setMeshoptDecoder( meshoptDecoder ) {

			this.meshoptDecoder = meshoptDecoder;
			return this;

		}

		register( callback ) {

			if ( this.pluginCallbacks.indexOf( callback ) === - 1 ) {

				this.pluginCallbacks.push( callback );

			}

			return this;

		}

		unregister( callback ) {

			if ( this.pluginCallbacks.indexOf( callback ) !== - 1 ) {

				this.pluginCallbacks.splice( this.pluginCallbacks.indexOf( callback ), 1 );

			}

			return this;

		}

		parse( data, path, onLoad, onError ) {

			let content;
			const extensions = {};
			const plugins = {};

			if ( typeof data === 'string' ) {

				content = data;

			} else {

				const magic = THREE.LoaderUtils.decodeText( new Uint8Array( data, 0, 4 ) );

				if ( magic === BINARY_EXTENSION_HEADER_MAGIC ) {

					try {

						extensions[ EXTENSIONS.KHR_BINARY_GLTF ] = new GLTFBinaryExtension( data );

					} catch ( error ) {

						if ( onError ) onError( error );
						return;

					}

					content = extensions[ EXTENSIONS.KHR_BINARY_GLTF ].content;

				} else {

					content = THREE.LoaderUtils.decodeText( new Uint8Array( data ) );

				}

			}

			const json = JSON.parse( content );

			if ( json.asset === undefined || json.asset.version[ 0 ] < 2 ) {

				if ( onError ) onError( new Error( 'THREE.GLTFLoader: Unsupported asset. glTF versions >=2.0 are supported.' ) );
				return;

			}

			const parser = new GLTFParser( json, {
				path: path || this.resourcePath || '',
				crossOrigin: this.crossOrigin,
				requestHeader: this.requestHeader,
				manager: this.manager,
				ktx2Loader: this.ktx2Loader,
				meshoptDecoder: this.meshoptDecoder
			} );
			parser.fileLoader.setRequestHeader( this.requestHeader );

			for ( let i = 0; i < this.pluginCallbacks.length; i ++ ) {

				const plugin = this.pluginCallbacks[ i ]( parser );
				plugins[ plugin.name ] = plugin; // Workaround to avoid determining as unknown extension
				// in addUnknownExtensionsToUserData().
				// Remove this workaround if we move all the existing
				// extension handlers to plugin system

				extensions[ plugin.name ] = true;

			}

			if ( json.extensionsUsed ) {

				for ( let i = 0; i < json.extensionsUsed.length; ++ i ) {

					const extensionName = json.extensionsUsed[ i ];
					const extensionsRequired = json.extensionsRequired || [];

					switch ( extensionName ) {

						case EXTENSIONS.KHR_MATERIALS_UNLIT:
							extensions[ extensionName ] = new GLTFMaterialsUnlitExtension();
							break;

						case EXTENSIONS.KHR_MATERIALS_PBR_SPECULAR_GLOSSINESS:
							extensions[ extensionName ] = new GLTFMaterialsPbrSpecularGlossinessExtension();
							break;

						case EXTENSIONS.KHR_DRACO_MESH_COMPRESSION:
							extensions[ extensionName ] = new GLTFDracoMeshCompressionExtension( json, this.dracoLoader );
							break;

						case EXTENSIONS.KHR_TEXTURE_TRANSFORM:
							extensions[ extensionName ] = new GLTFTextureTransformExtension();
							break;

						case EXTENSIONS.KHR_MESH_QUANTIZATION:
							extensions[ extensionName ] = new GLTFMeshQuantizationExtension();
							break;

						default:
							if ( extensionsRequired.indexOf( extensionName ) >= 0 && plugins[ extensionName ] === undefined ) {

								console.warn( 'THREE.GLTFLoader: Unknown extension "' + extensionName + '".' );

							}

					}

				}

			}

			parser.setExtensions( extensions );
			parser.setPlugins( plugins );
			parser.parse( onLoad, onError );

		}

	}
	/* GLTFREGISTRY */


	function GLTFRegistry() {

		let objects = {};
		return {
			get: function ( key ) {

				return objects[ key ];

			},
			add: function ( key, object ) {

				objects[ key ] = object;

			},
			remove: function ( key ) {

				delete objects[ key ];

			},
			removeAll: function () {

				objects = {};

			}
		};

	}
	/*********************************/

	/********** EXTENSIONS ***********/

	/*********************************/


	const EXTENSIONS = {
		KHR_BINARY_GLTF: 'KHR_binary_glTF',
		KHR_DRACO_MESH_COMPRESSION: 'KHR_draco_mesh_compression',
		KHR_LIGHTS_PUNCTUAL: 'KHR_lights_punctual',
		KHR_MATERIALS_CLEARCOAT: 'KHR_materials_clearcoat',
		KHR_MATERIALS_PBR_SPECULAR_GLOSSINESS: 'KHR_materials_pbrSpecularGlossiness',
		KHR_MATERIALS_TRANSMISSION: 'KHR_materials_transmission',
		KHR_MATERIALS_UNLIT: 'KHR_materials_unlit',
		KHR_TEXTURE_BASISU: 'KHR_texture_basisu',
		KHR_TEXTURE_TRANSFORM: 'KHR_texture_transform',
		KHR_MESH_QUANTIZATION: 'KHR_mesh_quantization',
		EXT_TEXTURE_WEBP: 'EXT_texture_webp',
		EXT_MESHOPT_COMPRESSION: 'EXT_meshopt_compression'
	};
	/**
	 * Punctual Lights Extension
	 *
	 * Specification: https://github.com/KhronosGroup/glTF/tree/master/extensions/2.0/Khronos/KHR_lights_punctual
	 */

	class GLTFLightsExtension {

		constructor( parser ) {

			this.parser = parser;
			this.name = EXTENSIONS.KHR_LIGHTS_PUNCTUAL; // THREE.Object3D instance caches

			this.cache = {
