<script>
/* =========================================================
   ŞAHİN-X v2 — Yıldızlararası Mekik Simülatörü
   6 gezegen · küresel yerçekimi · warp sürücüsü · sistem haritası
   ========================================================= */

/* ---------------- RENDERER (gerçekçi görsel ayarları) ---------------- */
const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.domElement.id = 'scene';
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x020208);
scene.fog = new THREE.FogExp2(0x120a1c, 0.0);

const camera = new THREE.PerspectiveCamera(72, innerWidth/innerHeight, 0.08, 400000);
const FLIP_Y = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,1,0), Math.PI);

const sun = new THREE.DirectionalLight(0xfff0e0, 2.1);
sun.position.set(-60000, 90000, 40000);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
sun.shadow.camera.left = -300; sun.shadow.camera.right = 300;
sun.shadow.camera.top = 300; sun.shadow.camera.bottom = -300;
sun.shadow.camera.near = 100; sun.shadow.camera.far = 200000;
scene.add(sun);
scene.add(sun.target);
scene.add(new THREE.HemisphereLight(0x8a7ac8, 0x1a0e18, 0.5));
scene.add(new THREE.AmbientLight(0x141228, 1.1));

/* Güneş parlaması */
function radialTex(inner, mid, outer) {
  const cv = document.createElement('canvas'); cv.width=cv.height=256;
  const c = cv.getContext('2d');
  const gr = c.createRadialGradient(128,128,4,128,128,124);
  gr.addColorStop(0, inner); if (mid) gr.addColorStop(0.35, mid); gr.addColorStop(1, outer);
  c.fillStyle=gr; c.fillRect(0,0,256,256);
  return new THREE.CanvasTexture(cv);
}
{
  const glowTex = radialTex('rgba(255,250,235,1)','rgba(255,210,150,0.5)','rgba(255,180,110,0)');
  const sunSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map:glowTex, transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  sunSprite.scale.set(60000, 60000, 1);
  sunSprite.position.set(-180000, 270000, 120000);
  scene.add(sunSprite);
  const coreTex = radialTex('rgba(255,255,252,1)','rgba(255,244,224,0.9)','rgba(255,230,190,0)');
  const core = new THREE.Sprite(new THREE.SpriteMaterial({ map:coreTex, transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  core.scale.set(17000, 17000, 1);
  core.position.copy(sunSprite.position);
  scene.add(core);
  const haloTex = radialTex('rgba(255,220,170,0.12)', null, 'rgba(255,200,140,0)');
  const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map:haloTex, transparent:true, fog:false, depthWrite:false, blending:THREE.AdditiveBlending }));
  halo.scale.set(190000, 190000, 1);
  halo.position.copy(sunSprite.position);
  scene.add(halo);
}


/* ---------------- PROSEDÜREL DOKU ARAÇLARI ---------------- */
const _noiseSrc = (() => {
  const cv = document.createElement('canvas'); cv.width = cv.height = 128;
  const c = cv.getContext('2d');
  const img = c.createImageData(128,128);
  for (let i=0;i<img.data.length;i+=4){
    const v = 90 + Math.random()*130;
    img.data[i]=img.data[i+1]=img.data[i+2]=v; img.data[i+3]=255;
  }
  c.putImageData(img,0,0);
  return cv;
})();
function fbmFill(ctx, w, h, octaves, baseAlpha) {
  const pat = ctx.createPattern(_noiseSrc, 'repeat');
  for (let o=0;o<octaves;o++){
    const sc = Math.pow(2, o) * 1.7;
    ctx.save();
    ctx.globalAlpha = baseAlpha * Math.pow(0.55, o);
    ctx.scale(sc, sc);
    ctx.fillStyle = pat;
    ctx.fillRect(0,0,w/sc,h/sc);
    ctx.restore();
  }
  ctx.globalAlpha = 1;
}
function makePlanetMaps(p) {
  const big = p.radius > 6000;
  const W = big ? 2048 : 1024, H = W/2;
  const cv = document.createElement('canvas'); cv.width=W; cv.height=H;
  const c = cv.getContext('2d');
  c.fillStyle = '#c2c2c2'; c.fillRect(0,0,W,H);
  fbmFill(c, W, H, 5, 0.55);
  // Büyük leke katmanı
  for (let i=0;i<26;i++){
    const x=Math.random()*W, y=Math.random()*H, r=W*(0.04+Math.random()*0.12);
    const g = c.createRadialGradient(x,y,r*0.1,x,y,r);
    const dark = Math.random()<0.5;
    g.addColorStop(0, dark?'rgba(40,40,48,0.22)':'rgba(255,255,255,0.16)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle=g; c.fillRect(x-r,y-r,r*2,r*2);
  }
  // Ekvatoral bantlar (çöl / gaz görünümü)
  if (p.bands) {
    for (let i=0;i<14;i++){
      const y = Math.random()*H, hh = H*(0.015+Math.random()*0.05);
      c.fillStyle = 'rgba(' + (Math.random()<0.5?'70,50,30':'255,240,210') + ',' + (0.06+Math.random()*0.10).toFixed(2) + ')';
      c.fillRect(0, y, W, hh);
    }
  }
  // Kraterler
  if (p.craters) {
    const n = big ? 130 : 90;
    for (let i=0;i<n;i++){
      const x=Math.random()*W, y=H*0.06+Math.random()*H*0.88, r=3+Math.random()*Math.random()*W*0.02;
      let g = c.createRadialGradient(x,y,r*0.1,x,y,r);
      g.addColorStop(0,'rgba(25,22,28,0.5)');
      g.addColorStop(0.75,'rgba(45,40,50,0.28)');
      g.addColorStop(1,'rgba(0,0,0,0)');
      c.fillStyle=g; c.beginPath(); c.arc(x,y,r,0,Math.PI*2); c.fill();
      c.strokeStyle='rgba(255,255,255,0.25)'; c.lineWidth=Math.max(1,r*0.12);
      c.beginPath(); c.arc(x,y,r*0.95, -2.6, -0.4); c.stroke();
    }
  }
  // Buz kapakları
  if (p.ice) {
    for (const top of [true,false]) {
      const capH = H*(0.13+Math.random()*0.04);
      const g = c.createLinearGradient(0, top?0:H, 0, top?capH:H-capH);
      g.addColorStop(0,'rgba(245,252,255,0.95)');
      g.addColorStop(0.7,'rgba(235,248,255,0.55)');
      g.addColorStop(1,'rgba(235,248,255,0)');
      c.fillStyle=g; c.fillRect(0, top?0:H-capH, W, capH);
      for (let i=0;i<40;i++){
        const x=Math.random()*W, y=top?capH*(0.7+Math.random()*0.5):H-capH*(0.7+Math.random()*0.5);
        const r=W*0.008*(1+Math.random()*2);
        const bg=c.createRadialGradient(x,y,0,x,y,r);
        bg.addColorStop(0,'rgba(240,250,255,0.7)'); bg.addColorStop(1,'rgba(240,250,255,0)');
        c.fillStyle=bg; c.fillRect(x-r,y-r,r*2,r*2);
      }
    }
  }
  // Emisif harita (lav / şehir ışıkları)
  let emis = null;
  if (p.lava || p.city) {
    emis = document.createElement('canvas'); emis.width=W; emis.height=H;
    const e = emis.getContext('2d');
    e.fillStyle='#000'; e.fillRect(0,0,W,H);
    if (p.lava) {
      for (let i=0;i<30;i++){
        let x=Math.random()*W, y=H*0.1+Math.random()*H*0.8;
        e.strokeStyle='rgba(255,120,30,0.9)'; e.lineWidth=1.5+Math.random()*2.5;
        e.shadowColor='#ff6a20'; e.shadowBlur=10;
        e.beginPath(); e.moveTo(x,y);
        const segs=5+(Math.random()*7|0);
        for (let sgi=0;sgi<segs;sgi++){ x+=(Math.random()-0.5)*W*0.06; y+=(Math.random()-0.5)*H*0.05; e.lineTo(x,y); }
        e.stroke();
        c.strokeStyle='rgba(120,40,20,0.55)'; c.lineWidth=e.lineWidth+2;
        c.shadowBlur=0;
      }
      e.shadowBlur=0;
      for (let i=0;i<12;i++){
        const x=Math.random()*W, y=Math.random()*H, r=W*0.006*(1+Math.random()*3);
        const g=e.createRadialGradient(x,y,0,x,y,r);
        g.addColorStop(0,'rgba(255,160,60,0.95)'); g.addColorStop(1,'rgba(255,80,20,0)');
        e.fillStyle=g; e.fillRect(x-r,y-r,r*2,r*2);
      }
    }
    if (p.city) {
      for (let cl=0; cl<38; cl++){
        const cxx=Math.random()*W, cyy=H*0.15+Math.random()*H*0.7, spread=W*0.012*(1+Math.random()*2);
        for (let i=0;i<36;i++){
          const x=cxx+(Math.random()-0.5)*spread*2, y=cyy+(Math.random()-0.5)*spread;
          e.fillStyle = Math.random()<0.75 ? 'rgba(255,214,140,0.9)' : 'rgba(150,220,255,0.9)';
          e.fillRect(x, y, 1.6, 1.6);
        }
      }
    }
  }
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = THREE.RepeatWrapping; tex.anisotropy = 8;
  let emisTex = null;
  if (emis) { emisTex = new THREE.CanvasTexture(emis); emisTex.wrapS = THREE.RepeatWrapping; }
  return { map: tex, bump: tex, emissive: emisTex };
}
function makeCloudTexture() {
  const W=1024, H=512;
  const cv = document.createElement('canvas'); cv.width=W; cv.height=H;
  const c = cv.getContext('2d');
  c.clearRect(0,0,W,H);
  for (let i=0;i<150;i++){
    const x=Math.random()*W, y=H*0.08+Math.random()*H*0.84;
    const rx=W*0.015*(1+Math.random()*4), ry=rx*(0.25+Math.random()*0.3);
    const g=c.createRadialGradient(x,y,0,x,y,rx);
    g.addColorStop(0,'rgba(255,255,255,'+(0.18+Math.random()*0.3).toFixed(2)+')');
    g.addColorStop(1,'rgba(255,255,255,0)');
    c.save(); c.translate(x,y); c.scale(1, ry/rx); c.translate(-x,-y);
    c.fillStyle=g; c.fillRect(x-rx,y-rx,rx*2,rx*2);
    c.restore();
  }
  // Kutupları temizle (üsler kutupta)
  c.globalCompositeOperation = 'destination-out';
  for (const top of [true, false]) {
    const g2 = c.createLinearGradient(0, top?0:H, 0, top?H*0.14:H*0.86);
    g2.addColorStop(0, 'rgba(0,0,0,1)');
    g2.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g2;
    c.fillRect(0, top?0:H*0.86, W, H*0.14);
  }
  c.globalCompositeOperation = 'source-over';
  const t = new THREE.CanvasTexture(cv);
  t.wrapS = THREE.RepeatWrapping;
  return t;
}
/* Fresnel atmosfer shader'ı */
const ATMO_VERT = 'varying vec3 vN; varying vec3 vP; void main(){ vN = normalize(normalMatrix*normal); vec4 mv = modelViewMatrix*vec4(position,1.0); vP = mv.xyz; gl_Position = projectionMatrix*mv; }';
const ATMO_FRAG = 'uniform vec3 uCol; uniform float uOp; varying vec3 vN; varying vec3 vP; void main(){ float f = pow(1.0 - abs(dot(normalize(vN), normalize(-vP))), 2.6); gl_FragColor = vec4(uCol, f*uOp); }';

/* ---------------- YILDIZLAR (2 katman) ---------------- */
let starsMat1, starsMat2;
function makeStars(n, r, size, opacity) {
  const pos = new Float32Array(n*3), col = new Float32Array(n*3);
  const tints = [[1,1,1],[0.78,0.87,1],[1,0.9,0.76],[0.86,0.8,1],[1,0.82,0.86]];
  for (let i=0;i<n;i++){
    const th = Math.random()*Math.PI*2, ph = Math.acos(2*Math.random()-1);
    pos[i*3]   = r*Math.sin(ph)*Math.cos(th);
    pos[i*3+1] = r*Math.cos(ph);
    pos[i*3+2] = r*Math.sin(ph)*Math.sin(th);
    const t = tints[(Math.random()*tints.length)|0], b = 0.45+Math.random()*0.55;
    col[i*3]=t[0]*b; col[i*3+1]=t[1]*b; col[i*3+2]=t[2]*b;
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  g.setAttribute('color', new THREE.BufferAttribute(col,3));
  const m = new THREE.PointsMaterial({ size, vertexColors:true, fog:false, sizeAttenuation:true, transparent:true, opacity });
  const p = new THREE.Points(g, m);
  p.frustumCulled = false;
  return { p, m };
}
{
  const s1 = makeStars(6000, 340000, 620, 0.95); scene.add(s1.p); starsMat1 = s1.m;
  const s2 = makeStars(2500, 330000, 1250, 0.85); scene.add(s2.p); starsMat2 = s2.m;
  window._stars = [s1.p, s2.p];
  // Samanyolu bandı: bir düzleme yoğunlaşmış 3. katman
  {
    const n = 5200, r = 335000;
    const pos = new Float32Array(n*3), col = new Float32Array(n*3);
    const bandN = new THREE.Vector3(0.32, 0.9, 0.28).normalize();
    const t1 = new THREE.Vector3(1,0,0).cross(bandN).normalize();
    const t2 = bandN.clone().cross(t1);
    for (let i=0;i<n;i++){
      const a = Math.random()*Math.PI*2;
      const spread = (Math.random()+Math.random()+Math.random()-1.5)/1.5 * 0.16;
      const d = t1.clone().multiplyScalar(Math.cos(a)).addScaledVector(t2, Math.sin(a)).addScaledVector(bandN, spread).normalize();
      pos[i*3]=d.x*r; pos[i*3+1]=d.y*r; pos[i*3+2]=d.z*r;
      const warm = Math.random()<0.4, b = 0.3+Math.random()*0.45;
      col[i*3]=(warm?1:0.82)*b; col[i*3+1]=(warm?0.88:0.86)*b; col[i*3+2]=(warm?0.72:1)*b;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos,3));
    g.setAttribute('color', new THREE.BufferAttribute(col,3));
    const pts = new THREE.Points(g, new THREE.PointsMaterial({ size:430, vertexColors:true, fog:false, transparent:true, opacity:0.55 }));
    pts.frustumCulled = false;
    scene.add(pts);
    window._stars.push(pts);
  }
}
